# ---- SQL 聚合 + WHERE 走索引（0.3.0）----
数据库.建索引(库S, "账", ["额"])
检查("SQL SUM", 数据库.执行查询(库S, "SELECT SUM(额) FROM 账")[0]["SUM(额)"], 2.5)
检查("SQL AVG", 数据库.执行查询(库S, "SELECT AVG(额) FROM 账")[0]["AVG(额)"], 1.25)
检查("SQL MIN", 数据库.执行查询(库S, "SELECT MIN(额) AS 低 FROM 账")[0]["低"], 1.0)
检查("SQL MAX", 数据库.执行查询(库S, "SELECT MAX(额) AS 高 FROM 账")[0]["高"], 1.5)
检查("SQL SUM WHERE 走索引", 数据库.执行查询(库S, "SELECT SUM(额) FROM 账 WHERE 额 > 1.2")[0]["SUM(额)"], 1.5)
检查("SQL 聚合空组", 数据库.执行查询(库S, "SELECT SUM(额) AS 总, COUNT(*) AS 共 FROM 账 WHERE 额 > 99"), [{"总": 空, "共": 0}])
检查("SQL WHERE 等值索引", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 额 = 1.0")], ["批甲"])
检查("SQL WHERE 范围索引", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 额 >= 1 AND 额 < 1.5")], ["批甲"])
检查("SQL WHERE 全形态一致", 数据库.执行查询(库S, "SELECT * FROM 账 WHERE 额 > 0"), 数据库.查询(库S, "账", {"额": {">": 0}}))
检查("SQL WHERE OR 同结果", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 额 = 1.0 OR 额 = 1.5")], ["批甲", "批乙"])
检查("SQL WHERE 列在右", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 1.2 < 额")], ["批乙"])
检查("SQL UPDATE WHERE 走索引", 数据库.执行(库S, "UPDATE 账 SET 备注 = '已' WHERE 额 = 1.5"), 1)
检查("SQL UPDATE WHERE 后查", 数据库.查询(库S, "账", {"名": "批乙"})[0]["备注"], "已")

# ---- LIKE/IN 走索引 + HAVING + 元组排序（0.4.0 增强项）----
数据库.建索引(库S, "账", ["名"])
检查("SQL LIKE 前缀走索引", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 名 LIKE '批甲%'")], ["批甲"])
检查("SQL LIKE 无索引列同结果", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 备注 LIKE '已'")], ["批乙"])
检查("SQL IN 走索引", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 名 IN ('批乙', '没这人')")], ["批乙"])
令 库H = 数据库.打开(":memory:")
数据库.建表(库H, "卖", ["区", "额"])
数据库.批量插入(库H, "卖", [{"区": "东", "额": 10}, {"区": "东", "额": 30}, {"区": "东", "额": 20}, {"区": "西", "额": 5}, {"区": "西", "额": 7}])
检查("HAVING 组数过滤", [r["区"] 遍历 r 在 数据库.执行查询(库H, "SELECT 区, COUNT(*) AS n FROM 卖 GROUP BY 区 HAVING COUNT(*) > 2")], ["东"])
检查("HAVING 聚合不在SELECT", [r["区"] 遍历 r 在 数据库.执行查询(库H, "SELECT 区 FROM 卖 GROUP BY 区 HAVING SUM(额) > 15")], ["东"])
检查("HAVING 分组列条件", [r["区"] 遍历 r 在 数据库.执行查询(库H, "SELECT 区 FROM 卖 GROUP BY 区 HAVING 区 = '西'")], ["西"])
检查("HAVING AND 组合", 长度(数据库.执行查询(库H, "SELECT 区 FROM 卖 GROUP BY 区 HAVING COUNT(*) > 2 AND SUM(额) < 15")), 0)
检查("HAVING 无分组", 数据库.执行查询(库H, "SELECT COUNT(*) AS n FROM 卖 HAVING COUNT(*) > 3"), [{"n": 5}])
检查("HAVING 无分组不满足", 数据库.执行查询(库H, "SELECT COUNT(*) AS n FROM 卖 HAVING COUNT(*) > 99"), [])
检查("HAVING ORDER BY", [r["区"] 遍历 r 在 数据库.执行查询(库H, "SELECT 区, SUM(额) AS 总 FROM 卖 GROUP BY 区 HAVING SUM(额) > 0 ORDER BY 总 DESC")], ["东", "西"])
检查("HAVING 空表", 数据库.执行查询(库H, "SELECT 区, COUNT(*) AS n FROM 卖 WHERE 额 > 99 GROUP BY 区 HAVING COUNT(*) > 0"), [])
检查抛错("HAVING 非分组列", 函数()：数据库.执行查询(库H, "SELECT 区 FROM 卖 GROUP BY 区 HAVING 额 > 1"),
          "运行期错误", "数据库操作失败：HAVING 里的「额」要先 GROUP BY（聚合函数或分组列才能出现在 HAVING 里）")
检查("内存库 条数可查", 数据库.条数(库H, "卖"), 5)
数据库.关闭(库H)
检查抛错("内存库 关闭后失效", 函数()：数据库.条数(库H, "卖"),
          "值错误", "这个库还没打开：「:memory:」（先用 令 库 = 数据库.打开(\"路径\") 打开，再把「库」传给后面的函数）")
令 库T = 数据库.打开(路径.连接(目录, "t元组.db"))
数据库.建表(库T, "测", ["a", "b"])
数据库.批量插入(库T, "测", [
    {"a": 2, "b": 1.5}, {"a": 1, "b": 2.0}, {"a": 2, "b": 0.5},
    {"a": 1, "b": 1.0}, {"a": 2, "b": 1.5}])
检查("元组排序 两键升序", [r["id"] 遍历 r 在 数据库.查询(库T, "测", 空, ["a", "b"])], [4, 2, 3, 1, 5])
检查("元组排序 SQL 同序", [r["id"] 遍历 r 在 数据库.执行查询(库T, "SELECT id FROM 测 ORDER BY a, b")], [4, 2, 3, 1, 5])
数据库.关闭(库T)

# ---- JOIN（0.5.0 增强项：内置 0.1.0 不支持，语义按 SQLite，输出键全限定「表.列」）----
令 库J = 数据库.打开(路径.连接(目录, "tjoin.db"))
数据库.建表(库J, "客", ["名", "城"])
数据库.批量插入(库J, "客", [{"名": "甲", "城": "北京"}, {"名": "乙", "城": "上海"}, {"名": "丙", "城": "广州"}])
数据库.建表(库J, "单", ["客id", "额"])
数据库.批量插入(库J, "单", [{"客id": 1, "额": 100}, {"客id": 1, "额": 250}, {"客id": 3, "额": 80}])
数据库.建索引(库J, "单", ["客id"])
数据库.建表(库J, "城表", ["城名", "人口"])
数据库.批量插入(库J, "城表", [{"城名": "北京", "人口": 2000}, {"城名": "上海", "人口": 2400}])
检查("JOIN INNER 哈希", 数据库.执行查询(库J, "SELECT 客.名, 单.额 FROM 客 JOIN 单 ON 客.id = 单.客id ORDER BY 单.额"),
      [{"客.名": "丙", "单.额": 80}, {"客.名": "甲", "单.额": 100}, {"客.名": "甲", "单.额": 250}])
检查("JOIN LEFT 补空", [r["单.额"] 遍历 r 在 数据库.执行查询(库J, "SELECT 客.名, 单.额 FROM 客 LEFT JOIN 单 ON 客.id = 单.客id ORDER BY 客.名, 单.额")],
      [80, 空, 100, 250])
检查("JOIN 星号键全限定", 数据库.执行查询(库J, "SELECT * FROM 客 JOIN 单 ON 客.id = 单.客id ORDER BY 单.额")[0].键(),
      ["客.id", "客.名", "客.城", "单.id", "单.客id", "单.额"])
检查("JOIN INNER 写法", 长度(数据库.执行查询(库J, "SELECT 客.名 FROM 客 INNER JOIN 单 ON 客.id = 单.客id")), 3)
检查("JOIN LEFT OUTER 写法", 长度(数据库.执行查询(库J, "SELECT 客.名 FROM 客 LEFT OUTER JOIN 单 ON 客.id = 单.客id")), 4)
检查("JOIN 聚合+HAVING", 数据库.执行查询(库J, "SELECT 客.名, SUM(单.额) AS 总 FROM 客 JOIN 单 ON 客.id = 单.客id GROUP BY 客.名 HAVING SUM(单.额) > 150 ORDER BY 总 DESC"),
      [{"客.名": "甲", "总": 350}])
检查("JOIN LEFT 聚合空组", 数据库.执行查询(库J, "SELECT 客.名, COUNT(单.id) AS 单数, SUM(单.额) AS 总 FROM 客 LEFT JOIN 单 ON 客.id = 单.客id GROUP BY 客.名 ORDER BY 客.名"),
      [{"客.名": "丙", "单数": 1, "总": 80}, {"客.名": "乙", "单数": 0, "总": 空}, {"客.名": "甲", "单数": 2, "总": 350}])
检查("JOIN WHERE 主表下推", [r["客.名"] 遍历 r 在 数据库.执行查询(库J, "SELECT 客.名 FROM 客 JOIN 单 ON 客.id = 单.客id WHERE 客.城 = '北京'")],
      ["甲", "甲"])
检查("JOIN WHERE 右表条件", [r["客.名"] 遍历 r 在 数据库.执行查询(库J, "SELECT 客.名 FROM 客 JOIN 单 ON 客.id = 单.客id WHERE 单.额 > 90 ORDER BY 单.额")],
      ["甲", "甲"])
检查("JOIN 裸列唯一归属", [r["名"] 遍历 r 在 数据库.执行查询(库J, "SELECT 名 FROM 客 JOIN 单 ON 客.id = 单.客id")],
      ["甲", "甲", "丙"])
检查("JOIN 裸列歧义", [r["客.名"] 遍历 r 在 数据库.执行查询(库J, "SELECT 客.名, 城表.人口 FROM 客 JOIN 单 ON 客.id = 单.客id JOIN 城表 ON 客.城 = 城表.城名 ORDER BY 城表.人口 DESC, 客.名")],
      ["甲", "甲"])
检查("JOIN ON 附加条件", 数据库.执行查询(库J, "SELECT 客.名, 单.额 FROM 客 JOIN 单 ON 客.id = 单.客id AND 单.额 > 90 ORDER BY 单.额"),
      [{"客.名": "甲", "单.额": 100}, {"客.名": "甲", "单.额": 250}])
检查抛错("JOIN 同表两次", 函数()：数据库.执行查询(库J, "SELECT 客.名 FROM 客 JOIN 客 ON 客.id = 单.客id"),
          "运行期错误", "数据库操作失败：表「客」在 JOIN 里出现了两次（本子集不支持别名）")
检查抛错("JOIN 坏列", 函数()：数据库.执行查询(库J, "SELECT 客.名 FROM 客 JOIN 单 ON 客.id = 单.不存在"),
          "运行期错误", "数据库操作失败：no such column: 单.不存在")
检查抛错("JOIN 裸 id 歧义", 函数()：数据库.执行查询(库J, "SELECT id FROM 客 JOIN 单 ON 客.id = 单.客id"),
          "运行期错误", "数据库操作失败：ambiguous column name: id")
数据库.关闭(库J)

# ---- 迁移（P4） ----
令 迁目 = 路径.连接(目录, "迁移样")
文件.创建目录(迁目)
文件.写文本(路径.连接(迁目, "001_建.sql"), "CREATE TABLE m1 (a, b);\n")
文件.写文本(路径.连接(迁目, "002_插.sql"), "INSERT INTO m1 (a, b) VALUES ('甲', 1);\n")
令 库M = 数据库.打开(路径.连接(目录, "t迁移.db"))
检查("迁移 首次", 数据库.迁移(库M, 迁目), ["001_建.sql", "002_插.sql"])
检查("迁移 二次", 数据库.迁移(库M, 迁目), [])
检查("迁移 数据", 数据库.条数(库M, "m1"), 1)
检查("迁移 版本表", 数据库.条数(库M, "schema_版本"), 2)
文件.写文本(路径.连接(迁目, "003_坏.sql"), "INSERT INTO 没表 (a) VALUES (1);\n")
检查抛错("迁移 坏文件", 函数()：数据库.迁移(库M, 迁目),
          "值错误", "迁移文件「003_坏.sql」跑失败了：数据库操作失败：no such table: 没表 —— 改好这个 .sql 再重跑（已经跑过的不会重复跑）")
检查("迁移 坏后版本表", 数据库.条数(库M, "schema_版本"), 2)
检查抛错("迁移 目录不存在", 函数()：数据库.迁移(库M, 路径.连接(目录, "不存在")),
          "文件错误", "迁移目录不存在：「" + 路径.连接(目录, "不存在") + "」—— 先建目录，把 001_建表.sql 这类文件放进去")
数据库.关闭(库M)

# ---- 查询到表格（P4） ----
令 表1 = 数据库.查询到表格(库S, "SELECT 名, 额 FROM 账 WHERE id = 1")
检查("表格 表头", 表格.表头(表1), ["名", "额"])
检查("表格 行数", 长度(表格.数据行(表1)), 1)
令 表2 = 数据库.查询到表格(库S, "SELECT 名 FROM 账 WHERE 1=0")
检查("表格 空表头", 表格.表头(表2), ["名"])
检查("表格 空行数", 长度(表格.数据行(表2)), 0)
检查抛错("表格 非SELECT", 函数()：数据库.查询到表格(库S, "INSERT INTO 账 (名) VALUES ('x')"),
          "值错误", "「查询到表格」只跑 SELECT；你写的是别的 —— 写操作用 数据库.执行(库, SQL)")

# ---- 孤儿日志（M212 语义：只删 .db 也行，打开清掉孤儿日志）----
令 库X = 数据库.打开(路径.连接(目录, "t孤儿.db"))
数据库.建表(库X, "记", ["名"])
数据库.插入(库X, "记", {"名": "甲"})
数据库.关闭(库X)
文件.删除文件(路径.连接(目录, "t孤儿.db"))
令 库X2 = 数据库.打开(路径.连接(目录, "t孤儿.db"))
检查("孤儿日志 清理重开", 数据库.有表(库X2, "记"), 假)
数据库.建表(库X2, "记", ["名"])
检查("孤儿日志 续号正常", 数据库.插入(库X2, "记", {"名": "乙"}), 1)
数据库.关闭(库X2)

# 手工造孤儿：快照删掉、日志非空（建表+插入）——旧行为会直接炸，新行为清掉当新库
令 孤儿目 = 路径.连接(目录, "t孤儿3")
文件.创建目录(孤儿目)
文件.写文本(路径.连接(孤儿目, "z.db.log"), "{\"操作\":\"建表\",\"表\":\"记\",\"字段们\":[\"名\"]}\n{\"操作\":\"插入\",\"表\":\"记\",\"id\":1,\"记录\":{\"名\":\"甲\"}}\n")
令 库Z = 数据库.打开(路径.连接(孤儿目, "z.db"))
检查("孤儿日志 非空清理", 数据库.有表(库Z, "记"), 假)
数据库.关闭(库Z)

令 出目录 = 路径.临时目录("jsdb冒烟结果")
json.写文件(路径.连接(出目录, "冒烟.json"), 结果们, 缩进 = 2)
令 通过数 = 0
遍历 r 在 结果们：
    如果 r["通过"]：
        通过数 += 1
打印(`引擎冒烟: {通过数}/{长度(结果们)} 通过`)
