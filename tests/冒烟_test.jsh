# 引擎冒烟测试：21 个 API + SQL 子集 + 事务 + 范围索引 + 迁移 + 持久化恢复
# 结果写 JSON 文件（控制台中文会乱码）
导入 json
导入 路径
导入 文件
导入 表格
导入 基石数据库 从 本地包 为 数据库

令 结果们 = []
函数 检查(名字, 实际, 期望)：
    结果们.追加({"名字": 名字, "通过": 实际 == 期望, "实际": 实际, "期望": 期望})

函数 检查抛错(名字, 回调, 期望类型, 期望消息)：
    尝试：
        回调()
        结果们.追加({"名字": 名字, "通过": 假, "实际": "没报错", "期望": 期望类型 + " | " + 期望消息})
    捕获 异常 为 e：
        结果们.追加({"名字": 名字,
                     "通过": (e.类型 == 期望类型) 与 (e.消息 == 期望消息),
                     "实际": e.类型 + " | " + e.消息,
                     "期望": 期望类型 + " | " + 期望消息})

令 目录 = 路径.临时目录("jsdb引擎冒烟")
令 库路径 = 路径.连接(目录, "t1.db")

# ---- 打开 / 关闭 ----
检查抛错("打开 目录不存在", 函数()：数据库.打开("Z:/肯定不存在/子/x.db"),
          "文件错误", "目录不存在，建不了库：「Z:/肯定不存在/子」")
令 库 = 数据库.打开(库路径)
检查("打开 返回句柄", 库, 库路径)
令 库2 = 数据库.打开(库路径)
检查("重开共享 同一状态", 真, 真)
检查("建表后 另一句柄可见", 真, 真)
数据库.建表(库, "账", ["名", "额", "旗"])
检查("句柄2 可见表", 数据库.有表(库2, "账"), 真)
检查("表们 初始", 数据库.表们(库), ["账"])
检查抛错("未打开句柄", 函数()：数据库.查询("不存在的路径.db", "账", 空),
          "值错误", "这个库还没打开：「不存在的路径.db」（先用 令 库 = 数据库.打开(\"路径\") 打开，再把「库」传给后面的函数）")
令 空库 = 数据库.打开("")
检查("空路径 私有库", 空库, "")

# ---- 建表 ----
检查抛错("建表 空字段列表", 函数()：数据库.建表(库, "空表", []),
          "值错误", "表「空表」的字段们要给一个非空的字段名列表")
检查抛错("建表 id 字段名", 函数()：数据库.建表(库, "id表", ["id", "甲"]),
          "值错误", "字段名里不用写 id —— 每张表都自带 id（把 id 从字段列表里去掉）")
检查抛错("建表 重复字段", 函数()：数据库.建表(库, "重表", ["甲", "甲"]),
          "运行期错误", "数据库操作失败：duplicate column name: 甲")
数据库.建表(库, "已有表", ["甲"])
数据库.建表(库, "已有表", ["乙"])   # 已存在：不报错、不动原表
检查("建表 幂等不动原表", 数据库.查询(库, "已有表", 空), [])
数据库.建表(库2, "句柄2建", ["甲"])
检查("句柄2 建表可见", 数据库.有表(库, "句柄2建"), 真)

# ---- 插入 ----
检查("插入 首条 id=1", 数据库.插入(库, "账", {"名": "批甲", "额": 0.5}), 1)
检查("插入 自增", 数据库.插入(库, "账", {"名": "批乙", "额": 1.5}), 2)
检查("插入 缺字段补空", 数据库.插入(库, "账", {"名": "批丙"}), 3)
检查抛错("插入 id 键", 函数()：数据库.插入(库, "账", {"id": 9}),
          "值错误", "id 是自动给的，不用写")
检查抛错("插入 多余字段", 函数()：数据库.插入(库, "账", {"名": "x", "备注": 1}),
          "值错误", "表「账」里没有这些字段：备注（表「账」里有：名、额、旗）")
检查抛错("插入 空记录", 函数()：数据库.插入(库, "账", {}),
          "值错误", "插入的记录不能是空的，至少要给一个字段的值")
检查抛错("插入 列表值", 函数()：数据库.插入(库, "账", {"名": [1]}),
          "类型错误", "「名」这个值是「列表」，存不进数据库（用 json.文本化(值) 先转成文本再存；多个值就拆成多条记录）")
检查抛错("插入 不存在的表", 函数()：数据库.插入(库, "没建的表", {"甲": 1}),
          "值错误", "没有表「没建的表」（现在有这些表：句柄2建、已有表、账）")

# ---- 批量插入 ----
检查("批量插入 条数", 数据库.批量插入(库, "账",
      [{"名": "丁", "额": 2.0}, {"名": "戊", "额": 3.0}, {"名": "己", "额": 4.0}]), 3)
检查("批量插入 空列表", 数据库.批量插入(库, "账", []), 0)
检查抛错("批量插入 第2行坏", 函数()：数据库.批量插入(库, "账",
          [{"名": "甲", "额": 1}, {"备注": 1}]),
          "值错误", "表「账」里没有这些字段：备注（表「账」里有：名、额、旗）")

# ---- 查询 ----
检查("查询 全表 id 序", [r["id"] 遍历 r 在 数据库.查询(库, "账", 空)], [1, 2, 3, 4, 5, 6])
检查("查询 缺字段补空", 数据库.查询(库, "账", {"id": 3})[0]["额"], 空)
检查("查询 等值", [r["名"] 遍历 r 在 数据库.查询(库, "账", {"名": "批甲"})], ["批甲"])
检查("查询 范围", [r["名"] 遍历 r 在 数据库.查询(库, "账", {"额": {">": 1, "<": 4}})],
      ["批乙", "丁", "戊"])
检查("查询 嵌套多符号", 数据库.条数(库, "账", {"额": {">": 0, "非空": 真}}), 5)
检查("查询 空值条件", [r["id"] 遍历 r 在 数据库.查询(库, "账", {"额": {"非空": 假}})], [3])
检查("查询 排序", [r["名"] 遍历 r 在 数据库.查询(库, "账", 空, "额")],
      ["批丙", "批甲", "批乙", "丁", "戊", "己"])
检查("查询 排序倒序条数", [r["名"] 遍历 r 在 数据库.查询(库, "账", 空, "额", 真, 2)],
      ["己", "戊"])
检查("查询 无排序倒序=id降序", [r["id"] 遍历 r 在 数据库.查询(库, "账", 空, 空, 真)],
      [6, 5, 4, 3, 2, 1])
检查抛错("查询 条件字段缺失", 函数()：数据库.查询(库, "账", {"备注": 1}),
          "值错误", "表「账」里没有这些字段：备注（表「账」里有：id、名、额、旗）")
检查抛错("查询 条件不是字典", 函数()：数据库.查询(库, "账", ["名"]),
          "类型错误", "「条件」要给一个字典（字段 → 值），给过来的却是「['名']」")
检查抛错("查询 排序类型", 函数()：数据库.查询(库, "账", 空, 1.5),
          "值错误", "排序字段要给一个非空的字段名列表，例如 [\"金额\"]")
检查抛错("查询 条数负", 函数()：数据库.查询(库, "账", 空, 空, 假, -1),
          "值错误", "条数要给非负整数，给的是「-1」")
检查抛错("查询 条数类型", 函数()：数据库.查询(库, "账", 空, 空, 假, "甲"),
          "类型错误", "需要整数")
检查抛错("查询 未知比较符号", 函数()：数据库.查询(库, "账", {"名": {"==": "批甲"}}),
          "值错误", "不认识的比较符号「==」")

# ---- 条数 ----
检查("条数 全表", 数据库.条数(库, "账"), 6)
检查("条数 条件", 数据库.条数(库, "账", {"额": {">": 0}}), 5)

# ---- 修改 / 删除 ----
检查("修改 行数", 数据库.修改(库, "账", {"名": "批丙"}, {"额": 9.9}), 1)
检查("修改 后查回", 数据库.查询(库, "账", {"id": 3})[0]["额"], 9.9)
检查("修改 多行", 数据库.修改(库, "账", {"额": {">": 2}}, {"旗": 真}) > 0, 真)
检查抛错("修改 新值坏字段", 函数()：数据库.修改(库, "账", {"名": "批甲"}, {"备注": 1}),
          "值错误", "表「账」里没有这些字段：备注")
检查抛错("修改 空条件", 函数()：数据库.修改(库, "账", {}, {"额": 1}),
          "值错误", "「修改」必须给条件")
检查抛错("修改 空新值", 函数()：数据库.修改(库, "账", {"名": "批甲"}, {}),
          "类型错误", "「新值」要给一个非空字典")
检查("删除 行数", 数据库.删除(库, "账", {"名": "己"}), 1)
检查("删除 自增不复用", 数据库.插入(库, "账", {"名": "庚"}), 7)
检查抛错("删除 空条件", 函数()：数据库.删除(库, "账", {}),
          "值错误", "「删除」必须给条件")

# ---- 汇总 ----
令 组 = 数据库.汇总(库, "账", "名", "额", {"额": {"非空": 真}})
检查("汇总 键与统计", 组["批甲"]["个数"], 1)
检查("汇总 整数组键变文本", 真, 真)
令 库3 = 数据库.打开(路径.连接(目录, "t3.db"))
数据库.建表(库3, "分", ["组", "值"])
数据库.批量插入(库3, "分", [{"组": "甲", "值": 3}, {"组": "甲", "值": 4}, {"组": "乙", "值": 1}])
令 分组 = 数据库.汇总(库3, "分", "组", "值")
检查("汇总 文本组键", "甲" 在 数据库.汇总(库3, "分", "组", "值"), 真)
令 按3 = 数据库.汇总(库3, "分", "值", "值")
检查("汇总 整数组键3", "3" 在 按3, 真)
检查("汇总 组键无小数键", 3.0 在 按3, 假)
令 库5 = 数据库.打开(路径.连接(目录, "t5.db"))
数据库.建表(库5, "价", ["组", "值"])
数据库.批量插入(库5, "价", [{"组": "甲", "值": 3.5}, {"组": "乙", "值": 3.5}])
令 按35 = 数据库.汇总(库5, "价", "值", "值")
检查("汇总 小数组键保持小数", 3.5 在 按35, 真)
检查("汇总 小数组键统计", 按35[3.5]["个数"], 2)
检查抛错("汇总 求和列空值", 函数()：数据库.汇总(库, "账", "名", "额"),
          "类型错误", "「额」这一列里有空值，没法汇总")
检查抛错("汇总 求和列文本", 函数()：数据库.汇总(库, "账", "名", "名"),
          "类型错误", "「名」这一列里有不是数字的值「批甲」，没法汇总")
检查抛错("汇总 无字段", 函数()：数据库.汇总(库, "账", "备注", "额"),
          "值错误", "表「账」里没有这些字段：备注")
检查("汇总 无匹配空字典", 数据库.汇总(库3, "分", "组", "值", {"组": "没有"}), {})

# ---- 建索引 / 唯一约束 ----
数据库.建索引(库3, "分", ["组"])
数据库.建索引(库3, "分", ["组"])   # 幂等
检查("建索引 幂等", 真, 真)
数据库.建索引(库3, "分", ["组", "值"], 唯一 = 真)
检查抛错("唯一索引 插入冲突", 函数()：数据库.插入(库3, "分", {"组": "甲", "值": 3}),
          "运行期错误", "数据库操作失败：UNIQUE constraint failed: 分.组, 分.值")
检查("空值不参与唯一", 数据库.插入(库3, "分", {"组": "丙"}), 4)
# 甲组已有两行同组（甲3、甲4），唯一索引必须报冲突
检查抛错("唯一索引 已有重复", 函数()：数据库.建索引(库3, "分", ["组"], 唯一 = 真),
          "运行期错误", "数据库操作失败：UNIQUE constraint failed: 分.组")
检查抛错("建索引 字段缺失", 函数()：数据库.建索引(库, "账", ["备注"]),
          "值错误", "表「账」里没有这些字段：备注")
检查抛错("建索引 表缺失", 函数()：数据库.建索引(库, "没建的表", ["名"]),
          "值错误", "没有表「没建的表」（现在有这些表：句柄2建、已有表、账）")

# ---- 索引加速与幽灵键（改值后旧键不再占用） ----
令 库6 = 数据库.打开(路径.连接(目录, "t6.db"))
数据库.建表(库6, "员", ["名", "额"])
数据库.插入(库6, "员", {"名": "甲", "额": 1})
数据库.建索引(库6, "员", ["名"], 唯一 = 真)
数据库.修改(库6, "员", {"名": "甲"}, {"名": "乙"})
检查("改值后 旧键可复用", 数据库.插入(库6, "员", {"名": "甲", "额": 2}), 2)
检查抛错("改值后 新键仍占用", 函数()：数据库.插入(库6, "员", {"名": "乙"}),
          "运行期错误", "数据库操作失败：UNIQUE constraint failed: 员.名")
检查("唯一索引 等值查询", 数据库.查询(库6, "员", {"名": "甲"})[0]["额"], 2)
检查("唯一索引 查无", 数据库.查询(库6, "员", {"名": "没有的"}), [])
检查抛错("修改 两行改同值", 函数()：数据库.修改(库6, "员", {"额": {">": 0}}, {"名": "丙"}),
          "运行期错误", "数据库操作失败：UNIQUE constraint failed: 员.名")
检查("修改原子 改动未生效", 数据库.查询(库6, "员", {"名": "丙"}), [])
数据库.建索引(库6, "员", ["额"])
检查("非唯一索引 等值", 长度(数据库.查询(库6, "员", {"额": 2})), 1)
检查("非唯一索引 组合", 数据库.条数(库6, "员", {"名": "甲", "额": 2}), 1)
检查("索引 字典条件范围", 数据库.条数(库6, "员", {"额": {">": 0}}), 2)
检查("索引 布尔条件无害", 数据库.条数(库6, "员", {"额": 空}), 0)
数据库.关闭(库6)

# ---- 持久化：关掉再开 ----
数据库.关闭(库)
数据库.关闭(库)   # 幂等
检查("关闭 幂等", 真, 真)
检查抛错("关闭后句柄失效", 函数()：数据库.查询(库, "账", 空),
          "值错误", "这个库还没打开：「" + 库路径 + "」（先用 令 库 = 数据库.打开(\"路径\") 打开，再把「库」传给后面的函数）")
令 库4 = 数据库.打开(库路径)
检查("重开 数据还在", [r["id"] 遍历 r 在 数据库.查询(库4, "账", 空)], [1, 2, 3, 4, 5, 7])
检查("重开 修改保留", 数据库.查询(库4, "账", {"id": 3})[0]["额"], 9.9)
检查("重开 布尔回读", 数据库.查询(库4, "账", {"名": "戊"})[0]["旗"], 1)
数据库.插入(库4, "账", {"名": "辛", "额": 1})
检查("重开 续号", 数据库.条数(库4, "账", {"名": "辛"}), 1)

# ---- SQL 子集 ----
令 库S = 数据库.打开(路径.连接(目录, "tsql.db"))
检查("SQL CREATE", 数据库.执行(库S, "CREATE TABLE 账 (id INTEGER PRIMARY KEY, 名 TEXT, 额 REAL)"), 0)
检查("SQL INSERT", 数据库.执行(库S, "INSERT INTO 账 (名, 额) VALUES (?, ?)", ["批甲", 0.5]), 1)
检查("SQL INSERT 多值", 数据库.执行(库S, "INSERT INTO 账 (名, 额) VALUES ('批乙', 1.5), ('批丙', 2.5)"), 2)
检查("SQL INSERT 无列清单", 数据库.执行(库S, "INSERT INTO 账 VALUES (NULL, '批丁', 3.5)"), 1)
检查("SQL SELECT", 数据库.执行查询(库S, "SELECT * FROM 账"), 数据库.查询(库S, "账"))
检查("SQL SELECT 列", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 额 > 1 ORDER BY 额")],
      ["批乙", "批丙", "批丁"])
检查("SQL WHERE LIKE", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 WHERE 名 LIKE '批%'")],
      ["批甲", "批乙", "批丙", "批丁"])
检查("SQL WHERE IN", 长度(数据库.执行查询(库S, "SELECT * FROM 账 WHERE 名 IN ('批甲', '批丁')")), 2)
检查("SQL COUNT(*)", 数据库.执行查询(库S, "SELECT COUNT(*) AS 共几行 FROM 账")[0]["共几行"], 4)
检查("SQL COUNT(*) 键原文", 数据库.执行查询(库S, "SELECT COUNT(*) FROM 账")[0]["COUNT(*)"], 4)
检查("SQL GROUP BY", [r["COUNT(*)"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名, COUNT(*) FROM 账 GROUP BY 名")], [1, 1, 1, 1])
检查("SQL UPDATE", 数据库.执行(库S, "UPDATE 账 SET 额 = 额 * 2 WHERE 名 = ?", ["批甲"]), 1)
检查("SQL UPDATE 后值", 数据库.查询(库S, "账", {"名": "批甲"})[0]["额"], 1.0)
检查("SQL DELETE", 数据库.执行(库S, "DELETE FROM 账 WHERE 额 > 2"), 2)
检查("SQL DELETE 剩", 数据库.条数(库S, "账"), 2)
检查("SQL DROP", 数据库.执行(库S, "DROP TABLE IF EXISTS 没有的表"), 2)
检查抛错("SQL DROP 缺表", 函数()：数据库.执行(库S, "DROP TABLE 没有的表"),
          "运行期错误", "数据库操作失败：no such table: 没有的表")
检查抛错("SQL CREATE 已有", 函数()：数据库.执行(库S, "CREATE TABLE 账 (甲 TEXT)"),
          "运行期错误", "数据库操作失败：table 账 already exists")
检查抛错("SQL 执行给SELECT", 函数()：数据库.执行(库S, "SELECT * FROM 账"),
          "值错误", "「执行」只跑写操作的 SQL；你给的是 SELECT")
检查抛错("SQL 语法错", 函数()：数据库.执行(库S, "INSERT 账 VALUES (1)"),
          "运行期错误", "数据库操作失败：SQL 语法错：这里要「into」")
检查抛错("SQL 缺列", 函数()：数据库.执行查询(库S, "SELECT 备注 FROM 账"),
          "运行期错误", "数据库操作失败：no such column: 备注")
检查抛错("SQL 缺参数", 函数()：数据库.执行(库S, "INSERT INTO 账 (名) VALUES (?)"),
          "运行期错误", "数据库操作失败：SQL 语法错：第 1 个 ? 没有对应的参数（参数们只给了 0 个）")
检查抛错("SQL 空不是列", 函数()：数据库.执行查询(库S, "SELECT * FROM 账 WHERE 额 = 空"),
          "运行期错误", "数据库操作失败：no such column: 空")
检查("SQL IS NULL", 数据库.执行查询(库S, "SELECT * FROM 账 WHERE 额 IS NULL"), [])
检查("SQL ORDER DESC LIMIT", [r["名"] 遍历 r 在 数据库.执行查询(库S, "SELECT 名 FROM 账 ORDER BY id DESC LIMIT 1")],
      [r["名"] 遍历 r 在 数据库.查询(库S, "账", 空, "id", 真, 1)])

# ---- 事务（P4） ----
令 库T = 数据库.打开(路径.连接(目录, "t事务.db"))
数据库.建表(库T, "账", ["名"])
数据库.插入(库T, "账", {"名": "甲"})
检查("事务 开始返回", 数据库.开始(库T), 空)
检查抛错("事务 嵌套开始", 函数()：数据库.开始(库T),
          "值错误", "已经在一个事务里了，不能再「开始」一次 —— 先用 数据库.提交 或 数据库.回滚 结束上一个事务")
数据库.插入(库T, "账", {"名": "乙"})
检查("事务 内可见", 数据库.条数(库T, "账"), 2)
检查("事务 回滚返回", 数据库.回滚(库T), 空)
检查("事务 回滚生效", 数据库.条数(库T, "账"), 1)
检查抛错("事务 无事务提交", 函数()：数据库.提交(库T),
          "值错误", "现在不在事务里，没有可提交的改动 —— 先 数据库.开始(库)，改完再 数据库.提交(库)")
检查抛错("事务 无事务回滚", 函数()：数据库.回滚(库T),
          "值错误", "现在不在事务里，没有可回滚的改动 —— 先 数据库.开始(库)，再 数据库.回滚(库)")
数据库.开始(库T)
数据库.插入(库T, "账", {"名": "丙"})
检查("事务 提交返回", 数据库.提交(库T), 空)
检查("事务 提交生效", 数据库.条数(库T, "账"), 2)
函数 成动作T()：
    数据库.插入(库T, "账", {"名": "丁"})
    返回 42
检查("用事务 成功返回", 数据库.用事务(库T, 成动作T), 42)
检查("用事务 成功落定", 数据库.条数(库T, "账"), 3)
函数 败动作T()：
    数据库.插入(库T, "账", {"名": "戊"})
    抛出 值错误("故意败")
检查抛错("用事务 失败重抛", 函数()：数据库.用事务(库T, 败动作T), "值错误", "故意败")
检查("用事务 失败回滚", 数据库.条数(库T, "账"), 3)
数据库.开始(库T)
数据库.插入(库T, "账", {"名": "己"})
数据库.关闭(库T)
令 库T2 = 数据库.打开(路径.连接(目录, "t事务.db"))
检查("事务 关闭丢弃", 数据库.条数(库T2, "账"), 3)
数据库.关闭(库T2)

# ---- 范围索引（P5） ----
令 库R = 数据库.打开(路径.连接(目录, "t范围.db"))
数据库.建表(库R, "货", ["名", "价"])
数据库.批量插入(库R, "货", [{"名": "a", "价": 5}, {"名": "b", "价": 9}, {"名": "c", "价": 3},
                          {"名": "d", "价": 7}, {"名": "e", "价": 1}, {"名": "f"}])
数据库.建索引(库R, "货", ["价"])
检查("范围 插入序", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {">": 3}})], [1, 2, 4])
检查("范围 双符号", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {">=": 3, "<=": 7}})], [1, 3, 4])
检查("范围 空命中", 数据库.查询(库R, "货", {"价": {">": 100}}), [])
检查("范围 空值不命中", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {">": 0}})], [1, 2, 3, 4, 5])
检查("范围 跨型操作数", 数据库.查询(库R, "货", {"价": {">": "3"}}), [])
检查("范围 文本小于", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {"<": "3"}})], [1, 2, 3, 4, 5])
检查("范围 ne回退", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {"!=": 5}})], [2, 3, 4, 5])
数据库.插入(库R, "货", {"名": "g", "价": 4})
检查("范围 插后失效", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {">=": 3, "<=": 5}})], [1, 3, 7])
数据库.修改(库R, "货", {"名": "a"}, {"价": 10})
检查("范围 改后失效", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {">=": 3, "<=": 5}})], [3, 7])
数据库.删除(库R, "货", {"名": "c"})
检查("范围 删后失效", [r["id"] 遍历 r 在 数据库.查询(库R, "货", {"价": {"<=": 3}})], [5])
数据库.建表(库R, "唯", ["v"])
数据库.建索引(库R, "唯", ["v"], 真)
数据库.批量插入(库R, "唯", [{"v": 30}, {"v": 10}, {"v": 20}])
检查("范围 唯一索引", [r["id"] 遍历 r 在 数据库.查询(库R, "唯", {"v": {">=": 10, "<": 30}})], [2, 3])
数据库.关闭(库R)

# ---- 排序快路（P8：多键/降序/混合类型走 排序按比较）----
令 库O = 数据库.打开(路径.连接(目录, "t排序.db"))
数据库.建表(库O, "货", ["组", "价", "名"])
数据库.批量插入(库O, "货", [
    {"组": "乙", "价": 2.0, "名": "甲一"}, {"组": "乙", "价": 1.0, "名": "乙一"},
    {"组": "甲", "价": 空, "名": "丙一"}, {"组": "甲", "价": 3, "名": "丁一"},
    {"组": 空, "价": 1, "名": "戊一"}])
数据库.插入(库O, "货", {"组": "乙", "价": 1.0, "名": "己一"})
数据库.插入(库O, "货", {"组": "甲", "价": "文本", "名": "庚一"})
检查("排序 多键升序", [r["id"] 遍历 r 在 数据库.查询(库O, "货", 空, ["组", "价"])], [5, 2, 6, 1, 3, 4, 7])
检查("排序 多键整体倒序", [r["id"] 遍历 r 在 数据库.查询(库O, "货", 空, ["组", "价"], 真)], [7, 4, 3, 1, 6, 2, 5])
检查("排序 稳定同键", [r["id"] 遍历 r 在 数据库.查询(库O, "货", {"组": "乙"}, ["组", "价"])], [2, 6, 1])
检查("排序 混合类型列", [r["id"] 遍历 r 在 数据库.查询(库O, "货", {"组": "甲"}, ["价"])], [3, 4, 7])
数据库.关闭(库O)

