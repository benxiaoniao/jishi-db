# 工具箱 CLI 测试：导入CSV（auto/utf-8/gbk/坏编码名）+ 导出回环 + 备份恢复
# 跑法：仓库根目录 jishi tests/工具箱_test.jsh
# 结果写 JSON 文件（控制台中文会乱码）
导入 json
导入 路径
导入 文件
导入 编码
导入 系统
导入 基石数据库 从 本地包 为 数据库

令 结果们 = []
函数 检查(名字, 实际, 期望)：
    结果们.追加({"名字": 名字, "通过": 实际 == 期望, "实际": 实际, "期望": 期望})

函数 跑工具(args)：
    返回 系统.执行详细("jishi tools/工具箱.jsh " + args, 超时 = 60.0)

令 目录 = 路径.临时目录("jsdb-toolbox-test")
令 样文 = "名,金\r\n张三,1\r\n李四,2.5\r\n王五,\r\n"
文件.写字节(路径.连接(目录, "gbk.csv"), 编码.文本GBK(样文))
文件.写文本(路径.连接(目录, "utf8.csv"), 样文)

# ---- GBK 自动识别 ----
令 得 = 跑工具("导入CSV " + 路径.连接(目录, "auto.db") + " 表 " + 路径.连接(目录, "gbk.csv"))
检查("GBK auto 退出码", 得["退出码"], 0)
令 库 = 数据库.打开(路径.连接(目录, "auto.db"))
令 行们 = 数据库.查询(库, "表")
检查("GBK auto 行数", 长度(行们), 3)
检查("GBK auto 中文", [r["名"] 遍历 r 在 行们], ["张三", "李四", "王五"])
检查("GBK auto 猜值", [r["金"] 遍历 r 在 行们], [1, 2.5, 空])
数据库.关闭(库)

# ---- 显式 gbk ----
得 = 跑工具("导入CSV " + 路径.连接(目录, "g.db") + " 表 " + 路径.连接(目录, "gbk.csv") + " gbk")
检查("显式 gbk 退出码", 得["退出码"], 0)
令 库g = 数据库.打开(路径.连接(目录, "g.db"))
检查("显式 gbk 中文", 数据库.查询(库g, "表")[0]["名"], "张三")
数据库.关闭(库g)

# ---- UTF-8 不受影响 ----
得 = 跑工具("导入CSV " + 路径.连接(目录, "u.db") + " 表 " + 路径.连接(目录, "utf8.csv"))
检查("UTF-8 退出码", 得["退出码"], 0)
令 库u = 数据库.打开(路径.连接(目录, "u.db"))
检查("UTF-8 中文", 数据库.查询(库u, "表")[0]["名"], "张三")
数据库.关闭(库u)

# ---- 坏编码名 ----
得 = 跑工具("导入CSV " + 路径.连接(目录, "x.db") + " 表 " + 路径.连接(目录, "gbk.csv") + " big5")
检查("坏编码名 退出码非0", 得["退出码"] != 0, 真)
检查("坏编码名 提示", (得["输出"] + 得["错误"]).包含("不认识的编码「big5」"), 真)

# ---- 导出 → 导入回环 ----
得 = 跑工具("导出CSV " + 路径.连接(目录, "auto.db") + " 表 " + 路径.连接(目录, "out.csv"))
检查("导出 退出码", 得["退出码"], 0)
得 = 跑工具("导入CSV " + 路径.连接(目录, "auto.db") + " 回环 " + 路径.连接(目录, "out.csv"))
检查("回环导入 退出码", 得["退出码"], 0)
令 库2 = 数据库.打开(路径.连接(目录, "auto.db"))
令 原 = 数据库.查询(库2, "表")
令 回 = 数据库.查询(库2, "回环")
令 同 = 长度(原) == 长度(回)
遍历 i 在 范围(长度(原))：
    如果 (原[i]["名"] != 回[i]["名"]) 或 (原[i]["金"] != 回[i]["金"])：
        同 = 假
检查("回环 数据一致", 同, 真)
数据库.关闭(库2)

# ---- 备份 → 恢复 ----
得 = 跑工具("备份 " + 路径.连接(目录, "auto.db") + " " + 路径.连接(目录, "备.db"))
检查("备份 退出码", 得["退出码"], 0)
得 = 跑工具("恢复 " + 路径.连接(目录, "备.db") + " " + 路径.连接(目录, "恢.db"))
检查("恢复 退出码", 得["退出码"], 0)
令 库3 = 数据库.打开(路径.连接(目录, "恢.db"))
检查("恢复 表们在", 数据库.表们(库3).包含("表"), 真)
检查("恢复 行数", 数据库.条数(库3, "表"), 3)
数据库.关闭(库3)

# ---- 迁移（SQLite → 基石格式，python 子进程读源）----
# 注：系统.执行 不做 argv 引号解析（清单 N6）——python 代码落盘 + 环境变量传参 + 裸路径调用
令 源库 = 路径.连接(目录, "迁移源.db")
令 造源py = 路径.连接(目录, "造源.py")
文件.写文本(造源py, "import os, sqlite3\nc = sqlite3.connect(os.environ[\"JSDB_TEST_DB\"])\nc.execute(\"CREATE TABLE 账 (名 TEXT, 额 REAL, 包 BLOB)\")\nc.executemany(\"INSERT INTO 账 VALUES (?,?,?)\", [(\"甲\",1.5,sqlite3.Binary(bytes([1,2,255]))),(\"乙\",2.5,None),(\"丙\",3.5,sqlite3.Binary(bytes([254])))])\nc.execute(\"DELETE FROM 账 WHERE 名=?\", (\"乙\",))\nc.execute(\"CREATE TABLE 空 (x)\")\nc.commit()\nc.close()\nprint(\"ok\")\n")
系统.设环境变量("JSDB_TEST_DB", 源库)
得 = 系统.执行详细("python " + 造源py, 60.0)
检查("迁移 造源 退出码", 得["退出码"], 0)
令 迁目标 = 路径.连接(目录, "迁移出.db")
得 = 系统.执行详细("jishi tools/迁移.jsh " + 源库 + " " + 迁目标, 120.0)
检查("迁移 退出码", 得["退出码"], 0)
令 库迁 = 数据库.打开(迁目标)
检查("迁移 账行数", 数据库.条数(库迁, "账"), 2)
令 迁行 = 数据库.查询(库迁, "账")
检查("迁移 保号", [r["id"] 遍历 r 在 迁行], [1, 3])
检查("迁移 名", [r["名"] 遍历 r 在 迁行], ["甲", "丙"])
检查("迁移 BLOB还原", 迁行[0]["包"] == 编码.十六进制解码("0102FF"), 真)
检查("迁移 BLOB单字节", 迁行[1]["包"] == 编码.十六进制解码("FE"), 真)
检查("迁移 空表", 数据库.条数(库迁, "空"), 0)
数据库.关闭(库迁)

令 出目录 = 路径.临时目录("jsdb工具箱结果")
json.写文件(路径.连接(出目录, "工具箱.json"), 结果们, 缩进 = 2)
令 通过数 = 0
遍历 r 在 结果们：
    如果 r["通过"]：
        通过数 += 1
打印(`工具箱: {通过数}/{长度(结果们)} 通过`)