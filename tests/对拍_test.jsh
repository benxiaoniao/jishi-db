# SQL 执行（写）
加用例("SQL CREATE", 函数(库件, 库)：库件.执行(库, "CREATE TABLE 价 (id INTEGER PRIMARY KEY, 组 TEXT, 值 REAL)"))
加用例("SQL CREATE 已有", 函数(库件, 库)：库件.执行(库, "CREATE TABLE 价 (甲 TEXT)"))
加用例("SQL INSERT 参数", 函数(库件, 库)：库件.执行(库, "INSERT INTO 价 (组, 值) VALUES (?, ?)", ["甲", 0.5]))
加用例("SQL INSERT 多值", 函数(库件, 库)：库件.执行(库, "INSERT INTO 价 (组, 值) VALUES ('乙', 1.5), ('丙', 2.5)"))
加用例("SQL INSERT 无列清单", 函数(库件, 库)：库件.执行(库, "INSERT INTO 价 VALUES (NULL, '丁', 3.5)"))
加用例("SQL INSERT 列数不符", 函数(库件, 库)：库件.执行(库, "INSERT INTO 价 VALUES ('坏')"))
加用例("SQL UPDATE 参数", 函数(库件, 库)：库件.执行(库, "UPDATE 价 SET 值 = 值 * 2 WHERE 组 = ?", ["甲"]))
加用例("SQL UPDATE 后查", 函数(库件, 库)：库件.查询(库, "价", {"组": "甲"})[0]["值"])
加用例("SQL DELETE", 函数(库件, 库)：库件.执行(库, "DELETE FROM 价 WHERE 值 > 2"))
加用例("SQL DELETE 后条数", 函数(库件, 库)：库件.条数(库, "价"))
加用例("SQL DROP IF EXISTS", 函数(库件, 库)：库件.执行(库, "DROP TABLE IF EXISTS 没有的表"))
加用例("SQL DROP 缺表", 函数(库件, 库)：库件.执行(库, "DROP TABLE 没有的表"))
加用例("SQL 执行给SELECT", 函数(库件, 库)：库件.执行(库, "SELECT * FROM 价"))
加用例("SQL 语法错", 函数(库件, 库)：库件.执行(库, "INSERT 价 VALUES (1)"))
加用例("SQL 缺参数", 函数(库件, 库)：库件.执行(库, "INSERT INTO 价 (组) VALUES (?)"))
加用例("SQL 缺表", 函数(库件, 库)：库件.执行(库, "INSERT INTO 没有的表 (甲) VALUES (1)"))

# SQL 执行查询（读）
加用例("SQL SELECT 全", 函数(库件, 库)：库件.执行查询(库, "SELECT * FROM 价"))
加用例("SQL SELECT 列", 函数(库件, 库)：[r["组"] 遍历 r 在 库件.执行查询(库, "SELECT 组 FROM 价 WHERE 值 > 1 ORDER BY 值")])
加用例("SQL WHERE LIKE", 函数(库件, 库)：[r["组"] 遍历 r 在 库件.执行查询(库, "SELECT 组 FROM 价 WHERE 组 LIKE '%乙%'")])
加用例("SQL WHERE IN", 函数(库件, 库)：长度(库件.执行查询(库, "SELECT * FROM 价 WHERE 组 IN ('甲', '丁')")))
加用例("SQL IS NULL", 函数(库件, 库)：长度(库件.执行查询(库, "SELECT * FROM 价 WHERE 值 IS NULL")))
加用例("SQL 三值 AND", 函数(库件, 库)：长度(库件.执行查询(库, "SELECT * FROM 价 WHERE 值 > 1 AND 组 LIKE '丙%'")))
加用例("SQL COUNT(*) 别名", 函数(库件, 库)：库件.执行查询(库, "SELECT COUNT(*) AS 共几行 FROM 价")[0]["共几行"])
加用例("SQL COUNT(*) 原文", 函数(库件, 库)：库件.执行查询(库, "SELECT COUNT(*) FROM 价")[0]["COUNT(*)"])
加用例("SQL GROUP BY", 函数(库件, 库)：库件.执行查询(库, "SELECT 组, COUNT(*) FROM 价 GROUP BY 组"))
加用例("SQL ORDER DESC LIMIT", 函数(库件, 库)：[r["组"] 遍历 r 在 库件.执行查询(库, "SELECT 组 FROM 价 ORDER BY id DESC LIMIT 1")])
加用例("SQL LIMIT OFFSET", 函数(库件, 库)：[r["组"] 遍历 r 在 库件.执行查询(库, "SELECT 组 FROM 价 ORDER BY id LIMIT 2 OFFSET 1")])
加用例("SQL 查询给INSERT", 函数(库件, 库)：库件.执行查询(库, "INSERT INTO 价 (组) VALUES ('坏')"))
加用例("SQL 缺列", 函数(库件, 库)：库件.执行查询(库, "SELECT 备注 FROM 价"))
加用例("SQL 空不是列", 函数(库件, 库)：库件.执行查询(库, "SELECT * FROM 价 WHERE 值 = 空"))

# ---- 跑一边的剧本 ----
函数 跑用例(库件, 库)：
    令 步们 = []
    遍历 用例 在 用例们：
        尝试：
            令 得 = 用例["调用"](库件, 库)
            步们.追加({"名字": 用例["名字"], "返回": 得})
        捕获 异常 为 e：
            步们.追加({"名字": 用例["名字"], "错误": e.类型, "消息": e.消息})
    返回 步们

# ---- 两边各自开库跑 ----
令 目录 = 路径.临时目录("jsdb对拍")
令 内置库 = 数据库.打开(路径.连接(目录, "a.db"))
令 引擎库 = 新库.打开(路径.连接(目录, "b.db"))
令 内置步们 = 跑用例(数据库, 内置库)
令 引擎步们 = 跑用例(新库, 引擎库)

# ---- 逐项对比 ----
# 预期偏差名单（这些用例两边消息/类型不同是设计决定，见文件头注释）
令 偏差名单 = ["插入 空记录", "SQL CREATE 已有", "SQL INSERT 列数不符",
    "SQL 语法错", "SQL 缺参数", "SQL 缺列", "SQL 空不是列"]
令 n = 长度(内置步们)
遍历 i 在 范围(n)：
    令 甲 = 内置步们[i]
    令 乙 = 引擎步们[i]
    令 一致 = 真
    令 说明 = ""
    如果 ("返回" 在 甲) 与 ("返回" 在 乙)：
        一致 = json.转文本(甲["返回"]) == json.转文本(乙["返回"])
        如果 非 一致：
            说明 = "返回值不同"
    否则如果 ("错误" 在 甲) 与 ("错误" 在 乙)：
        一致 = (甲["错误"] == 乙["错误"]) 与 (甲["消息"] == 乙["消息"])
        如果 甲["错误"] != 乙["错误"]：
            说明 = "类型不同"
        否则如果 甲["消息"] != 乙["消息"]：
            说明 = "消息不同"
    否则：
        一致 = 假
        说明 = "一边报错一边返回"
    令 预期偏差 = 甲["名字"] 在 偏差名单
    如果 预期偏差：
        说明 = "有意偏差：" + 说明
    结果们.追加({"名字": 甲["名字"], "一致": 一致 或 预期偏差, "偏差": 预期偏差,
                 "说明": 说明, "内置": 甲, "引擎": 乙})

数据库.关闭(内置库)
新库.关闭(引擎库)

令 出目录 = 路径.临时目录("jsdb对拍结果")
json.写文件(路径.连接(出目录, "对拍.json"), 结果们, 缩进 = 2)
令 一致数 = 0
令 偏差数 = 0
遍历 r 在 结果们：
    如果 r["一致"]：
        一致数 += 1
    如果 r["偏差"]：
        偏差数 += 1
打印(`对拍: {一致数}/{长度(结果们)} 一致（其中有意偏差 {偏差数} 项）`)
