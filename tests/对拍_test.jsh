# 对拍测试：内置 数据库 模块 vs 本地包引擎（基石数据库）
# 同一组用例分别跑两边，逐项比返回值（json 转文本）与错误（类型+消息）。
# 结果写 JSON 文件（控制台中文乱码）：对拍.json
#
# 已知有意偏差（消息或行为不同属预期，不计失败，单列「偏差」标记）：
#   1. 插入 空记录：内置报 SQLite 原文（运行期错误），引擎报中文值错误
#   2. SQL 错误消息：内置（rusqlite）给 SQLite 原文并附 `in <SQL> at offset N` 后缀，
#      引擎给简洁版（no such column / no such table / 中文语法错说明）
# 其余用例要求类型+消息逐字一致。
导入 数据库
导入 json
导入 路径
导入 基石数据库 从 本地包 为 新库

令 结果们 = []

# ---- 用例集：每项 {"名字": ..., "调用": 函数(模块, 库)：…} ----
# 匿名函数单表达式体；模块作为参数传给成员访问
令 用例们 = []

函数 加用例(名字, 调用)：
    用例们.追加({"名字": 名字, "调用": 调用})

# 建表 / 表们 / 有表
加用例("建表", 函数(库件, 库)：库件.建表(库, "账", ["名", "额", "旗"]))
加用例("表们", 函数(库件, 库)：库件.表们(库))
加用例("有表 真", 函数(库件, 库)：库件.有表(库, "账"))
加用例("有表 假", 函数(库件, 库)：库件.有表(库, "没建的表"))
加用例("建表 幂等", 函数(库件, 库)：库件.建表(库, "账", ["名", "额", "旗"]))
加用例("建表 空字段列表", 函数(库件, 库)：库件.建表(库, "空表", []))
加用例("建表 id 字段名", 函数(库件, 库)：库件.建表(库, "坏表", ["id"]))
加用例("建表 重复字段", 函数(库件, 库)：库件.建表(库, "坏表2", ["甲", "甲"]))

# 插入 / 批量插入
加用例("插入 首条 id=1", 函数(库件, 库)：库件.插入(库, "账", {"名": "批甲", "额": 1.5, "旗": 真}))
加用例("插入 自增", 函数(库件, 库)：库件.插入(库, "账", {"名": "批乙", "额": 2.5}))
加用例("插入 缺字段补空", 函数(库件, 库)：库件.插入(库, "账", {"名": "批丙"}))
加用例("插入 id 键", 函数(库件, 库)：库件.插入(库, "账", {"id": 9, "名": "坏"}))
加用例("插入 多余字段", 函数(库件, 库)：库件.插入(库, "账", {"名": "坏", "备注": 1}))
加用例("插入 空记录", 函数(库件, 库)：库件.插入(库, "账", {}))
加用例("插入 列表值", 函数(库件, 库)：库件.插入(库, "账", {"名": [1, 2]}))
加用例("插入 布尔值", 函数(库件, 库)：库件.插入(库, "账", {"名": "批丁", "旗": 假}))
加用例("插入 不存在的表", 函数(库件, 库)：库件.插入(库, "没建的表", {"名": "甲"}))
加用例("批量插入 条数", 函数(库件, 库)：库件.批量插入(库, "账", [
    {"名": "戊", "额": 10}, {"名": "己", "额": 20}, {"名": "庚", "额": 30}]))
加用例("批量插入 空列表", 函数(库件, 库)：库件.批量插入(库, "账", []))
加用例("批量插入 第2行坏", 函数(库件, 库)：库件.批量插入(库, "账", [{"名": "辛"}, {"备注": 1}]))

# 查询
加用例("查询 全表", 函数(库件, 库)：库件.查询(库, "账"))
加用例("查询 等值", 函数(库件, 库)：库件.查询(库, "账", {"名": "批甲"}))
加用例("查询 范围", 函数(库件, 库)：[r["名"] 遍历 r 在 库件.查询(库, "账", {"额": {">": 2.5}})])
加用例("查询 嵌套多符号", 函数(库件, 库)：长度(库件.查询(库, "账", {"额": {">": 1, "<=": 20}})))
加用例("查询 空值条件", 函数(库件, 库)：[r["id"] 遍历 r 在 库件.查询(库, "账", {"额": 空})])
加用例("查询 非空条件", 函数(库件, 库)：[r["id"] 遍历 r 在 库件.查询(库, "账", {"额": {"非空": 真}})])
加用例("查询 包含", 函数(库件, 库)：[r["名"] 遍历 r 在 库件.查询(库, "账", {"名": {"包含": "批"}})])
加用例("查询 排序", 函数(库件, 库)：[r["名"] 遍历 r 在 库件.查询(库, "账", 空, "额")])
加用例("查询 排序列表+倒序", 函数(库件, 库)：[r["名"] 遍历 r 在 库件.查询(库, "账", 空, ["额"], 真, 2)])
加用例("查询 条数0", 函数(库件, 库)：长度(库件.查询(库, "账", 空, 空, 假, 0)))
加用例("查询 条数超", 函数(库件, 库)：长度(库件.查询(库, "账", 空, 空, 假, 99)))
加用例("查询 条件字段缺失", 函数(库件, 库)：库件.查询(库, "账", {"备注": 1}))
加用例("查询 条件不是字典", 函数(库件, 库)：库件.查询(库, "账", ["名"]))
加用例("查询 排序类型", 函数(库件, 库)：库件.查询(库, "账", 空, "额"))
加用例("查询 条数负", 函数(库件, 库)：库件.查询(库, "账", 空, 空, 假, -1))
加用例("查询 未知符号", 函数(库件, 库)：库件.查询(库, "账", {"额": {"==": 1}}))
加用例("查询 不存在的表", 函数(库件, 库)：库件.查询(库, "没建的表", 空))

# 条数
加用例("条数 全表", 函数(库件, 库)：库件.条数(库, "账"))
加用例("条数 条件", 函数(库件, 库)：库件.条数(库, "账", {"名": {"包含": "批"}}))
加用例("条数 不存在的表", 函数(库件, 库)：库件.条数(库, "没建的表"))

