加用例("修改 行数", 函数(库件, 库)：库件.修改(库, "账", {"名": "批甲"}, {"额": 9.9}))
加用例("修改 后查回", 函数(库件, 库)：库件.查询(库, "账", {"名": "批甲"})[0]["额"])
加用例("修改 多行", 函数(库件, 库)：库件.修改(库, "账", {"额": {">": 15}}, {"旗": 真}))
加用例("修改 给id", 函数(库件, 库)：库件.修改(库, "账", {"名": "批甲"}, {"id": 99}))
加用例("修改 新值坏字段", 函数(库件, 库)：库件.修改(库, "账", {"名": "批甲"}, {"备注": 1}))
