# 压力测试：10 万行批量插入 / 逐行对照 / 索引等值查询 / 紧凑 / 重开 / 崩溃恢复
# 只用对外 15 个 API + SQL 子集，结果写 JSON 文件（控制台中文乱码）。
# 输出：<临时目录>/jsdb压力结果/压力.json
导入 json
导入 文件
导入 路径
导入 时间
导入 基石数据库 从 本地包 为 数据库

令 结果们 = {}
令 出目录 = 路径.临时目录("jsdb压力结果")

# ---------- 造 10 万条记录（造数据不计时） ----------
令 大数 = 100000
令 记录们 = []
遍历 i 在 范围(大数)：
    记录们.追加({"名": `用户{i}`, "额": i * 0.5, "旗": i % 2})

令 目录 = 路径.临时目录("jsdb压力")
令 库路径 = 路径.连接(目录, "压.db")
令 库 = 数据库.打开(库路径)
数据库.建表(库, "账", ["名", "额", "旗"])

# ---------- 1. 批量插入 10 万 ----------
令 起 = 时间.高精度时间()
令 得 = 数据库.批量插入(库, "账", 记录们)
令 批耗时 = 时间.高精度时间() - 起
结果们["批量插入10万行"] = {"耗时秒": 批耗时, "返回": 得, "每行毫秒": 批耗时 * 1000.0 / 大数}

# ---------- 2. 无索引线性扫描（范围条件） ----------
令 起2 = 时间.高精度时间()
令 命中们 = 数据库.查询(库, "账", {"额": {">": 49000, "<": 49100}})
令 扫耗时 = 时间.高精度时间() - 起2
结果们["无索引范围查询"] = {"耗时秒": 扫耗时, "命中": 长度(命中们)}

# ---------- 3. 建索引（名） ----------
令 起3 = 时间.高精度时间()
数据库.建索引(库, "账", ["名"])
令 索耗时 = 时间.高精度时间() - 起3
结果们["建索引10万"] = {"耗时秒": 索耗时}

# ---------- 4. 索引等值查询 ×200 取均值 ----------
令 标 = "用户50000"
令 起4 = 时间.高精度时间()
遍历 k 在 范围(200)：
    令 行 = 数据库.查询(库, "账", {"名": 标})
令 等耗时 = (时间.高精度时间() - 起4) / 200.0
结果们["索引等值查询"] = {"单次毫秒": 等耗时 * 1000.0, "命中": 长度(数据库.查询(库, "账", {"名": 标}))}

# ---------- 4b. 范围索引查询（P5：首查建有序表，之后二分） ----------
数据库.建索引(库, "账", ["额"])
令 起4b = 时间.高精度时间()
令 范行 = 数据库.查询(库, "账", {"额": {">": 49000, "<": 49100}})
令 范首耗时 = 时间.高精度时间() - 起4b
令 起4c = 时间.高精度时间()
遍历 k 在 范围(200)：
    令 范行2 = 数据库.查询(库, "账", {"额": {">": 49000, "<": 49100}})
令 范耗时 = (时间.高精度时间() - 起4c) / 200.0
结果们["范围索引查询"] = {"首查秒(建有序)": 范首耗时, "缓存单次毫秒": 范耗时 * 1000.0, "命中": 长度(范行)}

# ---------- 5. SQL 线性聚合（COUNT + WHERE） ----------
令 起5 = 时间.高精度时间()
令 数 = 数据库.执行查询(库, "SELECT COUNT(*) FROM 账 WHERE 额 > ?", [40000.0])[0]["COUNT(*)"]
令 SQL耗时 = 时间.高精度时间() - 起5
结果们["SQL_COUNT10万"] = {"耗时秒": SQL耗时, "命中": 数}

# ---------- 6. 逐行插入 1 万对照（含自动紧凑） ----------
令 起6 = 时间.高精度时间()
遍历 i 在 范围(10000)：
    数据库.插入(库, "账", {"名": `散客{i}`, "额": i + 0.25, "旗": i % 2})
令 逐耗时 = 时间.高精度时间() - 起6
结果们["逐行插入1万行"] = {"耗时秒": 逐耗时, "每行毫秒": 逐耗时 * 1000.0 / 10000.0, "推算10万秒": 逐耗时 * 10.0}

# ---------- 7. 汇总（全表线性） ----------
令 起7 = 时间.高精度时间()
令 组 = 数据库.汇总(库, "账", "旗", "额")
令 汇耗时 = 时间.高精度时间() - 起7
结果们["汇总11万按旗"] = {"耗时秒": 汇耗时, "组数": 长度(组.键())}

# ---------- 8. 排序查询（2 万行排序取前 5） ----------
令 起8 = 时间.高精度时间()
令 排行 = 数据库.查询(库, "账", {"id": {"<=": 20000}}, "额", 真, 5)
令 排耗时 = 时间.高精度时间() - 起8
结果们["排序2万取前5"] = {"耗时秒": 排耗时, "首行": 排行[0]["名"]}

# ---------- 9. 关闭（触发紧凑：全量快照写盘） ----------
令 起9 = 时间.高精度时间()
数据库.关闭(库)
令 关耗时 = 时间.高精度时间() - 起9
结果们["关闭紧凑11万行"] = {"耗时秒": 关耗时, "快照文本长度": 长度(文件.读文本(库路径))}

# ---------- 10. 重开（读快照 + 索引重建） ----------
令 起10 = 时间.高精度时间()
令 库2 = 数据库.打开(库路径)
令 开耗时 = 时间.高精度时间() - 起10
结果们["重开11万行"] = {"耗时秒": 开耗时}

# ---------- 11. 校验数据完好 ----------
结果们["校验"] = {
    "总条数": 数据库.条数(库2, "账"),
    "散客999在": 长度(数据库.查询(库2, "账", {"名": "散客999"})),
    "用户99999在": 长度(数据库.查询(库2, "账", {"名": "用户99999"})),
    "SQL计数": 数据库.执行查询(库2, "SELECT COUNT(*) FROM 账")[0]["COUNT(*)"],
}
数据库.关闭(库2)

# ---------- 12. 崩溃恢复（截断的尾部日志行） ----------
令 目录B = 路径.临时目录("jsdb压力B")
令 库B = 数据库.打开(路径.连接(目录B, "b.db"))
数据库.建表(库B, "账", ["名"])
数据库.插入(库B, "账", {"名": "甲"})
数据库.插入(库B, "账", {"名": "乙"})
数据库.插入(库B, "账", {"名": "丙"})
令 日志 = 路径.连接(目录B, "b.db.log")
令 引号 = 字符(34)
文件.追加文本(日志, "{" + 引号 + "操作" + 引号 + ":" + 引号 + "插入" + 引号)  # 半行：模拟写一半崩溃（不带收尾大括号，不是合法 JSON）
令 库B2 = 数据库.打开(路径.连接(目录B, "b.db"))
结果们["崩溃恢复"] = {
    "重开后条数": 数据库.条数(库B2, "账"),       # 期望 3（残行丢弃）
    "再插入续号": 数据库.插入(库B2, "账", {"名": "丁"}),  # 期望 4（自增指针没被残行污染）
}
数据库.关闭(库B2)

json.写文件(路径.连接(出目录, "压力.json"), 结果们, 缩进 = 2)
打印("stress: done -> jsdb压力结果/压力.json")
打印(`批量插入10万: {批耗时}s  逐行1万: {逐耗时}s  索引等值: {等耗时 * 1000.0}ms`)
