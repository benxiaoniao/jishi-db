# 记账本 —— 基石数据库的示例应用
# 跑法：jishi examples/记账本.jsh
# 演示：建表 → 记账（增）→ 查询（条件/排序/条数）→ 修改/删除 → 汇总 → 索引加速
# 数据放在临时目录，跑完自动清锁，不污染你的磁盘（临时目录系统会自己收拾）。

导入 路径
导入 基石数据库 从 本地包 为 数据库

令 目录 = 路径.临时目录("记账本示例")
令 库 = 数据库.打开(路径.连接(目录, "账本.db"))

# ---------- 建表 + 建索引 ----------
数据库.建表(库, "账目", ["日期", "事由", "类别", "金额"])
数据库.建索引(库, "账目", ["日期"])          # 常按日期查，建个索引

# ---------- 记几笔 ----------
数据库.批量插入(库, "账目", [
    {"日期": "2026-11-01", "事由": "工资",   "类别": "收入", "金额": 8000},
    {"日期": "2026-11-02", "事由": "房租",   "类别": "住房", "金额": -2600},
    {"日期": "2026-11-03", "事由": "买菜",   "类别": "吃饭", "金额": -128.5},
    {"日期": "2026-11-05", "事由": "电影",   "类别": "娱乐", "金额": -60},
    {"日期": "2026-11-08", "事由": "打车",   "类别": "出行", "金额": -35},
    {"日期": "2026-11-10", "事由": "奖金",   "类别": "收入", "金额": 1200},
])
打印("已记账 6 笔")

# ---------- 查询：11 月 3 号之后花掉的钱，按金额从大到小 ----------
令 花销 = 数据库.查询(库, "账目", {"日期": {">": "2026-11-03"}, "金额": {"<": 0}}, "金额", 真)
打印(`11月3日后有 {长度(花销)} 笔花销，最大的一笔是「{花销[0]["事由"]}」{花销[0]["金额"]} 元`)

# ---------- 修改：电影票其实花的是 58 ----------
数据库.修改(库, "账目", {"事由": "电影"}, {"金额": -58})
打印(`改完：电影 {数据库.查询(库, "账目", {"事由": "电影"})[0]["金额"]} 元`)

# ---------- 删除：打车这笔记重了 ----------
数据库.删除(库, "账目", {"事由": "打车"})
打印(`删掉打车后剩 {数据库.条数(库, "账目")} 笔`)

# ---------- 汇总：每个类别的合计 ----------
令 类别合计 = 数据库.汇总(库, "账目", "类别", "金额")
遍历 类别 在 类别合计.键()：
    令 组 = 类别合计[类别]
    打印(`{类别}: 合计 {组["总和"]} 元（{组["个数"]} 笔）`)

# ---------- 收支平衡 ----------
令 收 = 数据库.条数(库, "账目", {"类别": "收入"})
打印(`共 {收} 笔收入；索引等值查询按日期查 2026-11-01：{数据库.查询(库, "账目", {"日期": "2026-11-01"})[0]["事由"]}`)

数据库.关闭(库)
打印("示例结束（数据在临时目录，可删可不管）")
