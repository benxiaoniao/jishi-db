# A2：函数里普通赋值会创建局部变量，没有 nonlocal/global
# 复现：jishi 02_函数内赋值成局部.jsh

共享计数 = 0

函数 加一()：
    # 想改外层的 共享计数，但这条赋值会把它变成函数的局部变量
    共享计数 += 1
    返回 共享计数

尝试：
    打印(加一())
捕获 异常 为 e：
    打印("实测报错:", e.类型, "|", e.消息)

# 绕行：包进字典，函数里只做下标赋值（改的是字典对象，不是名字）
共享表 = {"计": 0}
函数 加一_字典版()：
    共享表["计"] += 1
    返回 共享表["计"]

打印("字典绕行可用:", 加一_字典版(), 加一_字典版())
