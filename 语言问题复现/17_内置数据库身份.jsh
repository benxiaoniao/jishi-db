# 诊断：内置 数据库 模块的身份（rusqlite 还是打包的基石实现？）
导入 数据库 为 内库
导入 基石数据库 从 本地包 为 外库
导入 文件
导入 路径
导入 json

打印("内库.打开 类型:", 类型(内库.打开))
打印("外库.打开 类型:", 类型(外库.打开))
打印("内库.查询到表格 类型:", 类型(内库.查询到表格))

令 目录 = 路径.临时目录("jsdb内置身份")
令 库 = 内库.打开(目录 + "/x.db")
内库.建表(库, "t", ["a"])
内库.插入(库, "t", {"a": 1})
打印("文件痕迹:", json.转文本(文件.列出目录(目录)))

尝试：
    令 表 = 内库.查询到表格(库, "SELECT a FROM t WHERE a <= 0")
    打印("内置 <=:", "OK")
捕获 异常 为 e：
    打印("内置 <= 败:", e.类型, "|", e.消息)

尝试：
    令 表2 = 内库.查询到表格(库, "SELECT * FROM pragma_table_info('t')")
    打印("pragma_table_info:", "OK")
捕获 异常 为 e：
    打印("pragma_table_info 败:", e.类型, "|", e.消息)

# 快照头：基石引擎的快照首行是 #基石数据库 快照 格式=1
打印("快照首行:", 文件.按行读(目录 + "/x.db")[0])
内库.关闭(库)
