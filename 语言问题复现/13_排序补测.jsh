# 排序补测 —— 稳定性 / 混合类型列 / 原生比较归并的收益估算
# 跑法：仓库根目录 jishi 语言问题复现/13_排序补测.jsh

导入 时间

# 稳定性：同键 "a" 两条（序1/序2），"b" 一条（序3）；a<b 码点序确定
令 样 = [{"序": 1, "键": "a"}, {"序": 2, "键": "a"}, {"序": 3, "键": "b"}]
函数 取键(行)：
    返回 行["键"]
令 排后 = 样.排序按(取键)
打印("稳定样排后序:", 排后[0]["序"], 排后[1]["序"], 排后[2]["序"])
打印("排序按稳定:", (排后[0]["序"] == 1) 与 (排后[1]["序"] == 2))

# 大样本稳定性：1 万行，键只有 10 种，看同键内 id 是否升序
令 大 = []
遍历 i 在 范围(10000)：
    大.追加({"id": i, "键": `k{i % 10}`})
函数 取键2(行)：
    返回 行["键"]
令 大排 = 大.排序按(取键2)
令 稳 = 真
令 上一 = {}
遍历 行 在 大排：
    令 旧 = 上一.获取(行["键"], 空)
    如果 (旧 != 空) 与 (行["id"] < 旧)：
        稳 = 假
        中断
    上一[行["键"]] = 行["id"]
打印("大样本稳定:", 稳)

# 混合类型列：原生排序按会怎样
令 混 = [{"v": 3}, {"v": "甲"}, {"v": 空}, {"v": 1.5}]
函数 取v(行)：
    返回 行["v"]
尝试：
    令 混排 = 混.排序按(取v)
    打印("混合类型排序按: 没报错", 文本(混排))
捕获 异常 为 e：
    打印("混合类型排序按报错:", e.类型, e.消息)

# 原生比较归并 vs 引擎归并（1 万行文本键）：估算值库换原生比较后的收益
令 记录们 = []
遍历 i 在 范围(10000)：
    记录们.追加({"id": i, "名": `用户{(i * 7919) % 10000}号`})

函数 新比较(甲, 乙)：
    # 同型文本直接原生 <；其余类型简化（本测试全文本）
    如果 甲 < 乙：
        返回 -1
    如果 甲 > 乙：
        返回 1
    返回 0

函数 新归并(左们, 右们)：
    令 结果 = []
    令 i = 0
    令 j = 0
    令 左长 = 长度(左们)
    令 右长 = 长度(右们)
    当 i < 左长 与 j < 右长：
        如果 新比较(左们[i]["名"], 右们[j]["名"]) <= 0：
            结果.追加(左们[i])
            i += 1
        否则：
            结果.追加(右们[j])
            j += 1
    当 i < 左长：
        结果.追加(左们[i])
        i += 1
    当 j < 右长：
        结果.追加(右们[j])
        j += 1
    返回 结果

函数 新归并排(们)：
    如果 长度(们) <= 1：
        返回 们
    令 中 = 长度(们) // 2
    返回 新归并(新归并排(们[0:中]), 新归并排(们[中:]))

令 起 = 时间.高精度时间()
令 新排 = 新归并排(记录们)
打印("原生比较归并 1万:", 时间.高精度时间() - 起, "秒")
打印("补测完成")