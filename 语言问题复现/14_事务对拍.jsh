# P4 对拍 —— 事务六 API + ALTER + 迁移 + 查询到表格（内置 vs 基石数据库）
# 跑法：仓库根目录 jishi 语言问题复现/14_事务对拍.jsh
# 迁移样例目录由本脚本自建（临时目录下），不依赖外部状态

导入 数据库 为 内库
导入 基石数据库 从 本地包 为 外库
导入 路径
导入 json
导入 表格
导入 文件

函数 造迁移样(根)：
    文件.创建目录(根 + "/迁移探")
    文件.写文本(根 + "/迁移探/001_建.sql", "CREATE TABLE m1 (a, b);\n")
    文件.写文本(根 + "/迁移探/002_插.sql", "INSERT INTO m1 (a, b) VALUES ('甲', 1);\n")
    文件.写文本(根 + "/迁移探/说明.txt", "不是 sql\n")
    文件.创建目录(根 + "/迁移探2")
    文件.写文本(根 + "/迁移探2/001_ok.sql", "CREATE TABLE q (x);\nINSERT INTO q (x) VALUES (1);\n")
    文件.写文本(根 + "/迁移探2/002_坏.sql", "THIS IS NOT SQL;\n")
    文件.写文本(根 + "/迁移探2/003_后.sql", "CREATE TABLE r (y);\n")
    文件.创建目录(根 + "/迁移探3")
    文件.写文本(根 + "/迁移探3/010_新.sql", "CREATE TABLE z (w);\n")
    文件.创建目录(根 + "/迁移探6")
    文件.写文本(根 + "/迁移探6/001_查.sql", "SELECT * FROM sqlite_master;\n")
    文件.创建目录(根 + "/迁移探6b")
    文件.写文本(根 + "/迁移探6b/001_空.sql", "-- 只有注释\n")

函数 记(们, 标签, 值)：
    们.追加(标签 + " → " + 文本(值))

函数 记错(们, 标签, e)：
    们.追加(标签 + " → 报错:" + e.类型 + "|" + e.消息)

函数 洗schema(引, 库)：
    令 行们 = 引.查询(库, "schema_版本")
    令 洗 = []
    遍历 行 在 行们：
        洗.追加({"id": 行["id"], "版本": 行["版本"], "跑于": "T"})
    返回 json.转文本(洗)

函数 表观(t)：
    返回 json.转文本({"类型": 类型(t), "头": 表格.表头(t), "行": 表格.数据行(t)})

函数 场景(引, 临)：
    令 们 = []
    令 库 = 引.打开(临 + "/a.db")
    引.建表(库, "t", ["名", "金"])
    引.插入(库, "t", {"名": "甲", "金": 1})

    尝试：
        记(们, "无事务提交", 引.提交(库))
    捕获 异常 为 e：
        记错(们, "无事务提交", e)
    尝试：
        记(们, "无事务回滚", 引.回滚(库))
    捕获 异常 为 e：
        记错(们, "无事务回滚", e)
    尝试：
        记(们, "开始返回", 引.开始(库))
    捕获 异常 为 e：
        记错(们, "开始返回", e)
    尝试：
        记(们, "嵌套开始", 引.开始(库))
    捕获 异常 为 e：
        记错(们, "嵌套开始", e)
    引.插入(库, "t", {"名": "乙", "金": 2})
    记(们, "事务内条数", 引.条数(库, "t"))
    尝试：
        记(们, "回滚返回", 引.回滚(库))
    捕获 异常 为 e：
        记错(们, "回滚返回", e)
    记(们, "回滚后条数", 引.条数(库, "t"))
    尝试：
        记(们, "回滚后再回滚", 引.回滚(库))
    捕获 异常 为 e：
        记错(们, "回滚后再回滚", e)

    引.开始(库)
    引.插入(库, "t", {"名": "丙", "金": 3})
    尝试：
        记(们, "提交返回", 引.提交(库))
    捕获 异常 为 e：
        记错(们, "提交返回", e)
    记(们, "提交后条数", 引.条数(库, "t"))
    引.开始(库)
    引.插入(库, "t", {"名": "丁", "金": 4})
    引.关闭(库)
    令 库2 = 引.打开(临 + "/a.db")
    记(们, "关闭丢弃后条数", 引.条数(库2, "t"))

    引.建索引(库2, "t", ["名"], 真)
    引.开始(库2)
    引.插入(库2, "t", {"名": "戊", "金": 5})
    尝试：
        记(们, "事务内撞唯一", 引.插入(库2, "t", {"名": "甲", "金": 9}))
    捕获 异常 为 e：
        记错(们, "事务内撞唯一", e)
    记(们, "撞后条数", 引.条数(库2, "t"))
    尝试：
        记(们, "撞后提交", 引.提交(库2))
    捕获 异常 为 e：
        记错(们, "撞后提交", e)
    记(们, "撞后落定条数", 引.条数(库2, "t"))

    函数 成动作()：
        引.插入(库2, "t", {"名": "己", "金": 6})
        返回 42
    尝试：
        记(们, "用事务成功", 引.用事务(库2, 成动作))
    捕获 异常 为 e：
        记错(们, "用事务成功", e)
    记(们, "用事务成功后条数", 引.条数(库2, "t"))
    函数 败动作()：
        引.插入(库2, "t", {"名": "庚", "金": 7})
        抛出 值错误("故意败")
    尝试：
        记(们, "用事务失败", 引.用事务(库2, 败动作))
    捕获 异常 为 e：
        记错(们, "用事务失败", e)
    记(们, "用事务失败后条数", 引.条数(库2, "t"))

    # DDL 回滚
    引.开始(库2)
    引.建表(库2, "临时表", ["x"])
    引.执行(库2, "ALTER TABLE t ADD COLUMN 临")
    引.回滚(库2)
    记(们, "DDL回滚后有临时表", 引.有表(库2, "临时表"))
    记(们, "DDL回滚后行", json.转文本(引.查询(库2, "t", {"id": 1})))
    记(们, "DDL回滚后新id", 引.插入(库2, "t", {"名": "辛", "金": 8}))

    # ALTER 套件
    尝试：
        记(们, "加列返回", 引.执行(库2, "ALTER TABLE t ADD COLUMN z"))
    捕获 异常 为 e：
        记错(们, "加列返回", e)
    记(们, "加列后行", json.转文本(引.查询(库2, "t", {"id": 1})))
    尝试：
        记(们, "加已有列", 引.执行(库2, "ALTER TABLE t ADD COLUMN x"))
    捕获 异常 为 e：
        记错(们, "加已有列", e)
    尝试：
        记(们, "改无表", 引.执行(库2, "ALTER TABLE 无 ADD COLUMN q"))
    捕获 异常 为 e：
        记错(们, "改无表", e)
    尝试：
        记(们, "DROP COLUMN", 引.执行(库2, "ALTER TABLE t DROP COLUMN x"))
    捕获 异常 为 e：
        记错(们, "DROP COLUMN", e)
    尝试：
        记(们, "ADD无COLUMN", 引.执行(库2, "ALTER TABLE t ADD w"))
    捕获 异常 为 e：
        记错(们, "ADD无COLUMN", e)
    尝试：
        记(们, "全小写alter", 引.执行(库2, "alter table t add column v"))
    捕获 异常 为 e：
        记错(们, "全小写alter", e)
    尝试：
        记(们, "加id列", 引.执行(库2, "ALTER TABLE t ADD COLUMN id"))
    捕获 异常 为 e：
        记错(们, "加id列", e)
    尝试：
        记(们, "缺列名", 引.执行(库2, "ALTER TABLE t ADD COLUMN"))
    捕获 异常 为 e：
        记错(们, "缺列名", e)

    # 查询到表格
    尝试：
        记(们, "表格正常", 表观(引.查询到表格(库2, "SELECT 名, 金 FROM t WHERE id <= 2")))
    捕获 异常 为 e：
        记错(们, "表格正常", e)
    尝试：
        记(们, "表格空", 表观(引.查询到表格(库2, "SELECT 名, 金 FROM t WHERE 1=0")))
    捕获 异常 为 e：
        记错(们, "表格空", e)
    尝试：
        记(们, "表格别名", 表观(引.查询到表格(库2, "SELECT 名 AS 甲, 金 AS 乙 FROM t WHERE id = 1")))
    捕获 异常 为 e：
        记错(们, "表格别名", e)
    尝试：
        记(们, "表格星号", 表观(引.查询到表格(库2, "SELECT * FROM t WHERE id = 1")))
    捕获 异常 为 e：
        记错(们, "表格星号", e)
    尝试：
        记(们, "表格GROUP空", 表观(引.查询到表格(库2, "SELECT 名, COUNT(*) FROM t WHERE 1=0 GROUP BY 名")))
    捕获 异常 为 e：
        记错(们, "表格GROUP空", e)
    尝试：
        记(们, "表格纯聚合空", 表观(引.查询到表格(库2, "SELECT COUNT(*) FROM t WHERE 1=0")))
    捕获 异常 为 e：
        记错(们, "表格纯聚合空", e)
    尝试：
        记(们, "表格非SELECT", 引.查询到表格(库2, "INSERT INTO t (名) VALUES ('x')"))
    捕获 异常 为 e：
        记错(们, "表格非SELECT", e)
    尝试：
        记(们, "表格参数", 表观(引.查询到表格(库2, "SELECT 名 FROM t WHERE 金 = ?", [1])))
    捕获 异常 为 e：
        记错(们, "表格参数", e)
    尝试：
        记(们, "表格空坏列", 表观(引.查询到表格(库2, "SELECT nope FROM t WHERE 1=0")))
    捕获 异常 为 e：
        记错(们, "表格空坏列", e)

    # 迁移
    尝试：
        记(们, "首次迁移", 引.迁移(库2, 迁根 + "/迁移探"))
    捕获 异常 为 e：
        记错(们, "首次迁移", e)
    记(们, "迁移后表们", 文本(引.表们(库2)))
    尝试：
        记(们, "二次迁移", 引.迁移(库2, 迁根 + "/迁移探"))
    捕获 异常 为 e：
        记错(们, "二次迁移", e)
    记(们, "m1条数", 引.条数(库2, "m1"))
    记(们, "schema洗", 洗schema(引, 库2))
    尝试：
        记(们, "中途坏SQL", 引.迁移(库2, 迁根 + "/迁移探2"))
    捕获 异常 为 e：
        记错(们, "中途坏SQL", e)
    记(们, "坏迁后表们", 文本(引.表们(库2)))
    记(们, "坏迁后q条数", 引.条数(库2, "q"))
    记(们, "坏迁后schema", 洗schema(引, 库2))
    尝试：
        记(们, "坏迁后重跑", 引.迁移(库2, 迁根 + "/迁移探2"))
    捕获 异常 为 e：
        记错(们, "坏迁后重跑", e)
    尝试：
        记(们, "目录不存在", 引.迁移(库2, 临 + "/不存在"))
    捕获 异常 为 e：
        记错(们, "目录不存在", e)
    文件.创建目录(临 + "/空目")
    尝试：
        记(们, "空目录迁移", 引.迁移(库2, 临 + "/空目"))
    捕获 异常 为 e：
        记错(们, "空目录迁移", e)
    尝试：
        记(们, "迁移含SELECT", 引.迁移(库2, 迁根 + "/迁移探6"))
    捕获 异常 为 e：
        记错(们, "迁移含SELECT", e)
    尝试：
        记(们, "迁移纯注释", 引.迁移(库2, 迁根 + "/迁移探6b"))
    捕获 异常 为 e：
        记错(们, "迁移纯注释", e)
    记(们, "注释后schema", 洗schema(引, 库2))

    # 事务内迁移
    引.开始(库2)
    尝试：
        记(们, "事务内迁移", 引.迁移(库2, 迁根 + "/迁移探3"))
    捕获 异常 为 e：
        记错(们, "事务内迁移", e)
    记(们, "事务内有z", 引.有表(库2, "z"))
    引.回滚(库2)
    记(们, "迁移回滚后有z", 引.有表(库2, "z"))
    引.开始(库2)
    引.迁移(库2, 迁根 + "/迁移探3")
    引.提交(库2)
    引.关闭(库2)
    令 库3 = 引.打开(临 + "/a.db")
    记(们, "迁移提交重开有z", 引.有表(库3, "z"))
    记(们, "迁移提交重开schema", 洗schema(引, 库3))

    # 事务内批量插入
    引.开始(库3)
    引.批量插入(库3, "m1", [{"a": "批1", "b": 1}, {"a": "批2", "b": 2}])
    记(们, "批量事务内条数", 引.条数(库3, "m1"))
    引.回滚(库3)
    记(们, "批量回滚后条数", 引.条数(库3, "m1"))
    引.关闭(库3)

    # 内存库事务
    令 内 = 引.打开("")
    引.建表(内, "t", ["a"])
    引.开始(内)
    引.插入(内, "t", {"a": 1})
    引.回滚(内)
    记(们, "内存库回滚条数", 引.条数(内, "t"))
    引.关闭(内)
    返回 们

令 临 = 路径.临时目录("jsdb事务对拍")
文件.创建目录(临 + "/内")
文件.创建目录(临 + "/外")
令 迁根 = 临 + "/迁移样"
造迁移样(迁根)
令 内观 = 场景(内库, 临 + "/内")
令 外观 = 场景(外库, 临 + "/外")
# 报错消息里的库路径归一化（内/外子目录不同是预期的）
令 内归 = []
遍历 行 在 内观：
    内归.追加(行.替换(临 + "/内", "<库>"))
令 外归 = []
遍历 行 在 外观：
    外归.追加(行.替换(临 + "/外", "<库>"))
令 合 = 真
如果 长度(内归) != 长度(外归)：
    打印("行数不同:", 长度(内归), 长度(外归))
    合 = 假
遍历 i 在 范围(最小(长度(内归), 长度(外归)))：
    如果 内归[i] != 外归[i]：
        打印("不一致 第", i + 1, "行")
        打印("  内置:", 内归[i])
        打印("  我们:", 外归[i])
        合 = 假
如果 合：
    打印("P4 对拍:", 长度(内归), "/", 长度(外归), "全部一致")
否则：
    打印("P4 对拍: 有不一致")