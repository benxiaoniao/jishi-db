# 16c —— 二分查找与文本：前提是「码点升序」列表（0.3.5 实测）
# 码点序：丙(19993) < 乙(20057) < 甲(29986)。
# 教训：["甲","乙","丙"] 是码点**降序**，对它二分找不到属正常行为——先修探针自己，
# 用真正的升序列验证文本二分是否可用（决定引擎能不能拿内建二分替换手写上下界）。

令 们 = ["丙", "乙", "甲"]
打印("文本 < (丙<乙 期望 真):", "丙" < "乙")
打印("二分查找 乙（期望 1）:", 二分查找(们, "乙"))
打印("二分查找 甲（期望 2）:", 二分查找(们, "甲"))
打印("二分查找 丙（期望 0）:", 二分查找(们, "丙"))
打印("二分插入点 乙（期望 1）:", 二分插入点(们, "乙"))
打印("数字对照 二分查找 2（期望 1）:", 二分查找([1, 2, 3], 2))
打印("降序列对照（非升序，找不到属正常）:", 二分查找(["甲", "乙", "丙"], "乙"))
打印("排序按对照（码点升序）:", ["甲", "乙", "丙"].排序按(函数(x)：x))
