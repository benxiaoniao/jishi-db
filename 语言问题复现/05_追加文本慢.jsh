# B1：文件.追加文本 每次都开关文件，高频小追加很慢
# 复现：jishi 05_追加文本慢.jsh（约 2 秒出结果）

导入 文件
导入 时间
导入 路径

令 目录 = 路径.临时目录("复现追加")
令 路径 = 路径.连接(目录, "a.log")
文件.原子写(路径, "")

令 起 = 时间.高精度时间()
遍历 i 在 范围(10000)：
    文件.追加文本(路径, "第" + 文本(i) + "行\n")
令 耗 = 时间.高精度时间() - 起

打印("追加一万次耗时(秒):", 耗)
打印("平均每次(毫秒):", 耗 * 1000.0 / 10000.0)

文件.删除文件(路径)

# 对照：一次性写 1 万行几乎不花时间
令 起2 = 时间.高精度时间()
令 行们 = []
遍历 i 在 范围(10000)：
    行们.追加("第" + 文本(i) + "行")
文件.写行(路径, 行们)
打印("对照：内存攒一批一次写(秒):", 时间.高精度时间() - 起2)
文件.删除文件(路径)
