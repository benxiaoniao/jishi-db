# 23 —— 新排序比较器实测：相等短路 + 同型原生 <（对照 15 号探针与旧压力数字）
# 旧数字（同机）：1万两键 归并 0.486s；排序按比较+值库比较器 ≈0.44s（2万 1.90s 反推）；
#               压力 2万单键降序 0.735s、多键 1.90s（旧比较器）
导入 时间
导入 基石数据库 从 本地包 为 引擎包

# 压力同款 2 万行
令 大样 = []
遍历 i 在 范围(20000)：
    大样.追加({"id": i, "名": `用户{i}`, "额": i * 0.5, "旗": i % 2})

函数 计时(名字, 动作)：
    令 起 = 时间.高精度时间()
    令 回 = 动作()
    打印(`{名字}: {时间.高精度时间() - 起} 秒`)
    返回 回

# 多键 [旗, 额]
令 排1 = 计时("2万 多键[旗,额] 新比较器", 函数()：引擎包.排序_执行(大样, [{"字段": "旗", "倒": 假}, {"字段": "额", "倒": 假}]))
打印("  首行id:", 排1[0]["id"], "次行id:", 排1[1]["id"])

# 单键降序
计时("2万 单键[额降] 新比较器", 函数()：引擎包.排序_执行(大样, [{"字段": "额", "倒": 真}]))

# 1万两键（与 15 号同款形状，直接对照 0.486/0.082）
令 中样 = []
遍历 i 在 范围(10000)：
    中样.追加({"id": i, "甲": (i * 7) % 997, "乙": `用户{i % 53}号`})
计时("1万 两键[甲,乙] 新比较器", 函数()：引擎包.排序_执行(中样, [{"字段": "甲", "倒": 假}, {"字段": "乙", "倒": 假}]))

# 正确性抽查：混合类型 + 空 + 稳定
令 混样 = [
    {"id": 1, "价": "文本"}, {"id": 2, "价": 3}, {"id": 3, "价": 空},
    {"id": 4, "价": 1.5}, {"id": 5, "价": 3}, {"id": 6, "价": "甲"}
]
令 排混 = 引擎包.排序_执行(混样, [{"字段": "价", "倒": 假}])
打印("混型排序 id 序:", [r["id"] 遍历 r 在 排混])   # 期望 3 4 2 5 1 6（空 < 1.5 < 3=3稳定 < 文本<甲）

令 倒混 = 引擎包.排序_执行(混样, [{"字段": "价", "倒": 真}])
打印("混型倒序 id 序:", [r["id"] 遍历 r 在 倒混])   # 期望 6 1 2 5 4 3（甲>文本>3=3稳定>1.5>空）
