# D：内置 数据库 模块行为怪点（打开坏文件不报错 / 空记录报 SQLite 原文 / 多句柄共享）
# 复现：jishi 08_数据库模块怪点.jsh

导入 数据库
导入 文件
导入 路径
导入 编码

令 目录 = 路径.临时目录("复现怪点")

# D3：打开坏文件（内容不是任何数据库格式）→ 不报错（惰性，第一次查询才炸）
令 假路径 = 路径.连接(目录, "假.db")
文件.原子写(假路径, "我就是一段普通文本，不是数据库")
令 库 = 数据库.打开(假路径)
打印("D3 打开坏文件：居然成功了（返回:", 库, "）")
尝试：
    数据库.查询(库, "随便")
捕获 异常 为 e：
    打印("D3 第一次查询才报错:", e.类型, "|", e.消息)
数据库.关闭(库)

# D1：空记录报 SQLite 原文
令 库2 = 数据库.打开(路径.连接(目录, "t.db"))
数据库.建表(库2, "账", ["名"])
尝试：
    数据库.插入(库2, "账", {})
捕获 异常 为 e：
    打印("D1 空记录报错原文:", e.类型, "|", e.消息)

# D4：同路径两个句柄共享；关闭一个 → 两个都失效
令 同一路径 = 路径.连接(目录, "共享.db")
令 甲 = 数据库.打开(同一路径)
数据库.建表(甲, "账", ["名"])
令 乙 = 数据库.打开(同一路径)
数据库.插入(乙, "账", {"名": "甲"})
打印("D4 甲乙看到的条数:", 数据库.条数(甲, "账"), 数据库.条数(乙, "账"), "（共享状态）")
数据库.关闭(乙)
尝试：
    数据库.条数(甲, "账")
捕获 异常 为 e：
    打印("D4 关闭乙之后甲也失效:", e.类型, "|", e.消息)

# D5：好设计（防误删全表）
尝试：
    数据库.删除(甲, "账", {})
捕获 异常 为 e：
    打印("D5 空条件删除被拦下:", e.类型, "|", e.消息)

数据库.关闭(甲)
打印("复现完成")
