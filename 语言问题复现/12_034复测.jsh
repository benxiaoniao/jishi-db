# 0.3.4 复测 —— 语言问题清单各项修复验证 + 新特性性能实测
# 跑法：仓库根目录 jishi 语言问题复现/12_034复测.jsh
# 结果直接打印（0.3.4 管道中文已正常），同时落 JSON 到临时目录备查

导入 时间
导入 文件
导入 路径
导入 json
导入 容器
导入 数据库 为 内置
导入 基石数据库 从 本地包 为 引擎包

令 临 = 路径.临时目录("jsdb034")
令 结果 = {}
令 事务箱 = {}

函数 计时(名字, 动作)：
    令 起 = 时间.高精度时间()
    令 回 = 动作()
    令 耗 = 时间.高精度时间() - 起
    结果[名字] = {"秒": 耗, "回": 回}
    打印(`{名字}: {耗} 秒`)
    返回 回

函数  guarded(名字, 动作)：
    尝试：
        返回 计时(名字, 动作)
    捕获 异常 为 e：
        打印(`{名字} 失败: {e.类型} {e.消息}`)
        返回 空

# ---- A1 文本比较：语义 + 速度 ----
函数 手比(甲, 乙)：
    令 甲长 = 长度(甲)
    令 乙长 = 长度(乙)
    令 共同 = 甲长 如果 甲长 < 乙长 否则 乙长
    令 i = 0
    当 i < 共同：
        令 甲码 = 序数(甲[i])
        令 乙码 = 序数(乙[i])
        如果 甲码 < 乙码：
            返回 -1
        如果 甲码 > 乙码：
            返回 1
        i += 1
    如果 甲长 < 乙长：
        返回 -1
    如果 甲长 > 乙长：
        返回 1
    返回 0

令 文本对们 = []
遍历 i 在 范围(100000)：
    文本对们.追加([`用户{i % 997}号`, `用户{(i + 1) % 997}号`])

函数 原生比一轮()：
    令 小 = 0
    遍历 对 在 文本对们：
        如果 对[0] < 对[1]：
            小 += 1
    返回 小

函数 手写比一轮()：
    令 小 = 0
    遍历 对 在 文本对们：
        如果 手比(对[0], 对[1]) < 0：
            小 += 1
    返回 小

函数 跨类型探()：
    尝试：
        令 探 = 1 < "甲"
        返回 假
    捕获 异常 为 e：
        返回 真

计时("A1 原生文本< 10万次", 原生比一轮)
计时("A1 手写逐码点 10万次", 手写比一轮)
打印("A1 语义: 甲<乙 =", "甲" < "乙", "| A<b =", "A" < "b", "| 跨类型报错吗 =", 跨类型探())

# ---- 列表键比较（排序原生化的前提）----
函数 列表键探()：
    令 报 = {}
    尝试：
        报["同型文本"] = [2, "甲"] < [2, "乙"]
    捕获 异常 为 e：
        报["同型文本"] = `报错:{e.类型}`
    尝试：
        报["跨型序"] = [0, 空] < [1, 5]
    捕获 异常 为 e：
        报["跨型序"] = `报错:{e.类型}`
    尝试：
        报["数与文"] = [1, 5] < [2, "甲"]
    捕获 异常 为 e：
        报["数与文"] = `报错:{e.类型}`
    返回 报

结果["列表键比较"] = 列表键探()
打印("列表键比较:", json.转文本(结果["列表键比较"]))

# ---- B1 追加写四种姿势（1 万行）----
令 行们 = []
遍历 i 在 范围(10000)：
    行们.追加(`{{"操作":"插入","id":{i}}}`)

函数 追加文本逐条()：
    令 p = 临 + "/a.log"
    遍历 行 在 行们：
        文件.追加文本(p, 行 + "\n")
    返回 文件.文件大小(p)

函数 对象写行逐条刷新()：
    令 p = 临 + "/b.log"
    用 打开(p, "追加") 为 f：
        遍历 行 在 行们：
            f.写行(行)
            f.刷新()
    返回 文件.文件大小(p)

函数 对象写行缓冲末刷()：
    令 p = 临 + "/c.log"
    用 打开(p, "追加") 为 f：
        遍历 行 在 行们：
            f.写行(行)
    返回 文件.文件大小(p)

函数 追加行们批量()：
    令 p = 临 + "/d.log"
    文件.追加行们(p, 行们)
    返回 文件.文件大小(p)

计时("B1 追加文本逐条 1万", 追加文本逐条)
guarded("B1 文件对象写行+逐条刷新 1万", 对象写行逐条刷新)
guarded("B1 文件对象写行+末尾刷新 1万", 对象写行缓冲末刷)
计时("B1 追加行们批量 1万", 追加行们批量)

# 缓冲语义：写行不刷新，别处读得到吗？
函数 缓冲可见性()：
    令 p = 临 + "/e.log"
    用 打开(p, "追加") 为 f：
        f.写行("未刷新")
        令 刷前 = 假
        尝试：
            刷前 = 文件.读文本(p).包含("未刷新")
        捕获 文件错误 为 e：
            刷前 = 假
        f.刷新()
        令 刷后 = 文件.读文本(p).包含("未刷新")
        返回 {"刷前可见": 刷前, "刷后可见": 刷后}

结果["缓冲可见性"] = guarded("缓冲可见性", 缓冲可见性)
打印("缓冲可见性:", json.转文本(结果["缓冲可见性"]))

# ---- B4 字典存在性检查（10 万键，1 万次未命中）----
令 大字典 = {}
遍历 i 在 范围(100000)：
    大字典[`键{i}`] = i

函数 探在未命中()：
    令 命 = 0
    遍历 i 在 范围(10000)：
        如果 `无{i}` 在 大字典：
            命 += 1
    返回 命

函数 获取未命中()：
    令 命 = 0
    遍历 i 在 范围(10000)：
        如果 大字典.获取(`无{i}`, 空) != 空：
            命 += 1
    返回 命

函数 包含未命中()：
    令 命 = 0
    遍历 i 在 范围(10000)：
        如果 大字典.包含(`无{i}`)：
            命 += 1
    返回 命

计时("B4 在 未命中1万", 探在未命中)
计时("B4 获取 未命中1万", 获取未命中)
计时("B4 包含 未命中1万", 包含未命中)

# ---- 排序：原生 排序按 vs 引擎归并（1 万行文本键）----
令 记录们 = []
遍历 i 在 范围(10000)：
    记录们.追加({"id": i, "名": `用户{(i * 7919) % 10000}号`})

函数 取名(行)：
    返回 行["名"]

函数 原生排序()：
    返回 记录们.排序按(取名)

计时("排序 原生排序按 1万文本键", 原生排序)

# 稳定性：同键保持原序
令 稳定样 = [{"序": 1, "键": "甲"}, {"序": 2, "键": "甲"}, {"序": 3, "键": "乙"}]
函数 取键(行)：
    返回 行["键"]
令 排后 = 稳定样.排序按(取键)
结果["排序按稳定"] = (排后[0]["序"] == 1) 与 (排后[1]["序"] == 2)
打印("排序按稳定:", 结果["排序按稳定"])

函数 引擎排序()：
    返回 引擎包.排序_执行(记录们, [{"字段": "名", "倒": 假}])

guarded("排序 引擎归并 1万文本键", 引擎排序)

# ---- 容器.分组（汇总加速候选，1 万行）----
函数 分组名(行)：
    返回 行["名"]

函数 容器分组()：
    令 组 = 容器.分组(记录们, 分组名)
    返回 长度(组.键())

计时("容器.分组 1万行", 容器分组)

# ---- 内置数据库新 API：事务 / 查询到表格 ----
函数 会炸()：
    内置.插入(事务箱["库"], "t", {"v": 4})
    抛出 值错误("故意")

函数 事务探()：
    令 p = 临 + "/tx.db"
    令 库 = 内置.打开(p)
    事务箱["库"] = 库
    内置.建表(库, "t", ["v"])
    内置.插入(库, "t", {"v": 1})
    内置.开始(库)
    内置.插入(库, "t", {"v": 2})
    内置.回滚(库)
    令 回滚后 = 内置.条数(库, "t")
    内置.开始(库)
    内置.插入(库, "t", {"v": 3})
    内置.提交(库)
    令 提交后 = 内置.条数(库, "t")
    尝试：
        内置.用事务(库, 会炸)
    捕获 值错误 为 e：
        打印("用事务抛错如期:", e.消息)
    令 炸后 = 内置.条数(库, "t")
    令 表 = 内置.查询到表格(库, "SELECT v FROM t")
    令 表型 = 类型(表)
    内置.关闭(库)
    返回 {"回滚后": 回滚后, "提交后": 提交后, "炸后": 炸后, "表格类型": 表型}

结果["内置事务"] = guarded("内置事务", 事务探)
打印("内置事务:", json.转文本(结果["内置事务"]))

json.写文件(临 + "/复测结果.json", 结果, 缩进 = 2)
打印("结果JSON:", 临 + "/复测结果.json")
打印("034 复测完成")