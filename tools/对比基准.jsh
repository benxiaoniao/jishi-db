# 对比基准 —— 本引擎 vs 内置 数据库 vs 真 SQLite（远期性能标杆）
# 背景（重要）：jishi 0.3.5 的内置 数据库 模块 = 本项目 0.1.0 的内置版（不再是 rusqlite）。
#   所以「引擎 vs 内置」是新旧两代基石引擎的对照；「真 SQLite」标杆来自外部两腿：
#     - sqlite3 腿：CPython sqlite3（SQLite C 实现），由本工具调 python tools/sqlite基准.py
#     - rusqlite 腿：Rust rusqlite(bundled)，需先编译（见 README「性能对比」一节），没有则自动跳过
# 跑法：仓库根目录 jishi tools/对比基准.jsh   （约 2-3 分钟）
# 输出：临时目录 jsdb对比基准/对比.json + 控制台表格（倍率 = 本引擎耗时 / 标杆耗时）
# 实现注记：工作负载函数全部顶层定义、共享状态一律传参——嵌套具名函数体一旦带 try/catch，
#   对外围局部变量的捕获会失效（E0301，见 语言问题复现/20/21/22 号探针）。
# 本工具是对照脚本（与 tests/对拍_test.jsh 同性质）：引擎本体绝不 导入 数据库，这里显式例外。

导入 json
导入 路径
导入 时间
导入 文件
导入 文本 为 文本库
导入 系统
导入 数据库 为 内置
导入 基石数据库 从 本地包 为 引擎

令 出目录 = 路径.临时目录("jsdb对比基准")

令 项名单 = ["批量插入2万", "逐行插入2千", "建索引名", "索引等值x500", "无索引范围x20",
             "建索引额", "范围索引首查", "范围索引x200", "SQL_COUNT", "SQL_SUM",
             "排序2万取前5", "修改2千行", "事务500行提交", "汇总", "关闭", "重开"]

# ---------- 工作负载（全部顶层定义，模块与库都走参数） ----------

函数 W批(模块, 库, 记录们)：
    模块.批量插入(库, "账", 记录们)

函数 W逐(模块, 库)：
    遍历 i 在 范围(2000)：
        模块.插入(库, "账", {"名": `散客{i}`, "额": i + 0.25, "旗": i % 2})

函数 W等值(模块, 库)：
    令 n = 0
    遍历 k 在 范围(500)：
        n += 长度(模块.查询(库, "账", {"名": `用户{k % 20000}`}))
    返回 n

函数 W全扫(模块, 库)：
    令 n = 0
    遍历 k 在 范围(20)：
        令 下 = 9900.0 + k
        n += 长度(模块.查询(库, "账", {"额": {">": 下, "<": 下 + 5.0}}))
    返回 n

函数 W首查(模块, 库)：
    返回 长度(模块.查询(库, "账", {"额": {">": 5000.0, "<": 5100.0}}))

函数 W范索(模块, 库)：
    令 n = 0
    遍历 k 在 范围(200)：
        n += 长度(模块.查询(库, "账", {"额": {">": 5000.0, "<": 5100.0}}))
    返回 n

函数 W计数(模块, 库)：
    返回 模块.执行查询(库, "SELECT COUNT(*) FROM 账 WHERE 额 > ?", [9000.0])[0]["COUNT(*)"]

函数 W求和(模块, 库)：
    返回 模块.执行查询(库, "SELECT SUM(额) FROM 账 WHERE 旗 = 1")[0]["SUM(额)"]

函数 W排序(模块, 库)：
    返回 长度(模块.查询(库, "账", {"id": {"<=": 5000}}, "额", 真, 5))

函数 W修改(模块, 库)：
    返回 模块.修改(库, "账", {"额": {">": 9000.0}}, {"旗": 1})

函数 W事务(模块, 库)：
    模块.开始(库)
    遍历 i 在 范围(500)：
        模块.插入(库, "账", {"名": `事务{i}`, "额": 1.0, "旗": 0})
    模块.提交(库)

函数 W汇总(模块, 库)：
    返回 长度(模块.汇总(库, "账", "旗", "额"))

函数 W重开(模块, 库路径)：
    令 库2 = 模块.打开(库路径)
    令 n = 模块.条数(库2, "账")
    模块.关闭(库2)
    返回 n

# 计时记项：帐 走参数（catch 捕获坑的变通，见 语言问题复现/20/21/22 号探针）
函数 记项(帐, 名字, 动作)：
    令 起 = 时间.高精度时间()
    尝试：
        令 回 = 动作()
        帐[名字] = {"秒": 时间.高精度时间() - 起, "回": 回}
    捕获 异常 为 e：
        帐[名字] = {"秒": 时间.高精度时间() - 起, "不支持": e.消息}

# ---------- 套件 ----------

函数 跑套件(模块, 标签)：
    令 目 = 路径.临时目录("jsdb对比基准-" + 标签)
    令 库路径 = 路径.连接(目, "b.db")
    令 库 = 模块.打开(库路径)
    模块.建表(库, "账", ["名", "额", "旗"])
    令 记录们 = []
    遍历 i 在 范围(20000)：
        记录们.追加({"名": `用户{i}`, "额": i * 0.5, "旗": i % 2})
    令 帐 = {}
    记项(帐, "批量插入2万", 函数()：W批(模块, 库, 记录们))
    记项(帐, "逐行插入2千", 函数()：W逐(模块, 库))
    记项(帐, "建索引名", 函数()：模块.建索引(库, "账", ["名"]))
    记项(帐, "索引等值x500", 函数()：W等值(模块, 库))
    记项(帐, "无索引范围x20", 函数()：W全扫(模块, 库))
    记项(帐, "建索引额", 函数()：模块.建索引(库, "账", ["额"]))
    记项(帐, "范围索引首查", 函数()：W首查(模块, 库))
    记项(帐, "范围索引x200", 函数()：W范索(模块, 库))
    记项(帐, "SQL_COUNT", 函数()：W计数(模块, 库))
    记项(帐, "SQL_SUM", 函数()：W求和(模块, 库))
    记项(帐, "排序2万取前5", 函数()：W排序(模块, 库))
    记项(帐, "修改2千行", 函数()：W修改(模块, 库))
    记项(帐, "事务500行提交", 函数()：W事务(模块, 库))
    记项(帐, "汇总", 函数()：W汇总(模块, 库))
    记项(帐, "关闭", 函数()：模块.关闭(库))
    记项(帐, "重开", 函数()：W重开(模块, 库路径))
    返回 帐

# ---------- 外部腿（"名称=值" 行 → 字典） ----------

函数 收外部(命令)：
    令 帐 = {}
    令 回 = 系统.执行详细(命令, 300.0)
    如果 回["退出码"] != 0：
        帐["错误"] = 回["错误"]
        返回 帐
    遍历 行 在 回["输出"].拆分("\n")：
        令 位 = 行.查找("=")
        如果 位 > 0：
            令 名 = 行[0:位]
            令 值段 = (行[位 + 1:]).去空白()
            尝试：
                帐[名] = 小数(值段)
            捕获 异常 为 e：
                帐[名] = 值段
    返回 帐

打印("跑本引擎套件…")
令 引擎帐 = 跑套件(引擎, "引擎")
打印("跑内置(0.1.0)套件…")
令 内置帐 = 跑套件(内置, "内置")

打印("跑 SQLite(C) 腿：python tools/sqlite基准.py …")
令 sqlite们 = 收外部("python tools/sqlite基准.py")

打印("跑 rusqlite 腿（如已编译）…")
令 rus们 = {}
令 exe路径 = 路径.连接(系统.环境变量("TEMP"), "jsdb_rusqlite_bench", "target", "release", "rusqlite_bench.exe")
如果 文件.文件存在(exe路径)：
    rus们["默认"] = 收外部(`{exe路径} default`)
    rus们["WAL"] = 收外部(`{exe路径} wal`)
否则：
    rus们["说明"] = "rusqlite_bench.exe 未编译（编译方法见 README 性能对比一节）"

# ---------- 汇总表 ----------

函数 取秒(帐, 名)：
    令 项 = 帐.获取(名, 空)
    如果 项 == 空：
        返回 空
    # 引擎/内置腿是 {"秒": …}；外部腿是平铺 名 → 秒数
    如果 (类型(项) == "小数") 或 (类型(项) == "整数")：
        返回 小数(项)
    如果 项.获取("不支持", 空) != 空：
        返回 "不支持"
    返回 项["秒"]

函数 秒文本(v)：
    如果 v == 空：
        返回 "-"
    如果 v == "不支持"：
        返回 "不支持"
    返回 文本库.小数位(v, 4)

打印("")
打印(`对比基准（秒，越小越好；SQLite 内核: {sqlite们.获取("sqlite版本", "?")}）`)
打印(`{文本库.左对齐("项目", 16)}{文本库.左对齐("本引擎", 10)}{文本库.左对齐("内置01", 10)}{文本库.左对齐("vs内置", 8)}{文本库.左对齐("sqlite3C", 10)}{文本库.左对齐("vsSQLite", 9)}{文本库.左对齐("rusqlite", 10)}{文本库.左对齐("rusqliteWAL", 11)}`)
遍历 名 在 项名单：
    令 引秒 = 取秒(引擎帐, 名)
    令 内秒 = 取秒(内置帐, 名)
    令 s秒 = 取秒(sqlite们, 名)
    令 r秒 = 取秒(rus们.获取("默认", {}), 名)
    令 w秒 = 取秒(rus们.获取("WAL", {}), 名)
    令 倍内 = "-"
    如果 (类型(引秒) == "小数") 与 (类型(内秒) == "小数") 与 (内秒 > 0)：
        倍内 = 文本库.小数位(引秒 / 内秒, 1) + "x"
    令 倍s = "-"
    如果 (类型(引秒) == "小数") 与 (类型(s秒) == "小数") 与 (s秒 > 0)：
        倍s = 文本库.小数位(引秒 / s秒, 1) + "x"
    打印(`{文本库.左对齐(名, 16)}{文本库.左对齐(秒文本(引秒), 10)}{文本库.左对齐(秒文本(内秒), 10)}{文本库.左对齐(倍内, 8)}{文本库.左对齐(秒文本(s秒), 10)}{文本库.左对齐(倍s, 9)}{文本库.左对齐(秒文本(r秒), 10)}{文本库.左对齐(秒文本(w秒), 11)}`)

json.写文件(路径.连接(出目录, "对比.json"),
            {"本引擎": 引擎帐, "内置01": 内置帐, "sqlite3C": sqlite们, "rusqlite": rus们}, 缩进 = 2)
打印("")
打印(`对比基准完成 -> jsdb对比基准/对比.json（rusqlite 腿: {rus们.获取("说明", "已跑")}）`)
