# 自检 —— 新机器环境验证（jishi 能跑 + 包机制有效 + 引擎读写 + 持久化）
# 跑法：jishi tools/自检.jsh
# 成功：打印 selfcheck: OK (N/N)
# 失败：打印 FAIL + 详情 JSON 路径（控制台中文必乱码，详情看 JSON）
导入 json
导入 文件
导入 路径
导入 基石数据库 从 本地包 为 数据库

令 出目录 = 路径.临时目录("jsdb-selfcheck")
令 详情路径 = 路径.连接(出目录, "自检详情.json")
令 结果们 = {"通过": 0, "失败": [], "步骤": []}

函数 记(名, 过, 说明)：
    结果们["步骤"].追加({"名": 名, "过": 过, "说明": 说明})
    如果 过：
        结果们["通过"] += 1
    否则：
        结果们["失败"].追加(名)

尝试：
    令 目录 = 路径.临时目录("jsdb-selfcheck-run")
    令 库路径 = 路径.连接(目录, "自检.db")

    令 库 = 数据库.打开(库路径)
    记("打开", 真, 库路径)

    数据库.建表(库, "自检表", ["名", "值"])
    记("建表", 数据库.有表(库, "自检表"), "")

    令 id1 = 数据库.插入(库, "自检表", {"名": "甲", "值": 1})
    记("插入", id1 == 1, `id={id1}`)

    数据库.批量插入(库, "自检表", [{"名": "乙", "值": 2}, {"名": "丙", "值": 3}])
    记("批量插入", 数据库.条数(库, "自检表") == 3, "")

    数据库.建索引(库, "自检表", ["名"])
    令 行们 = 数据库.查询(库, "自检表", {"名": "乙"})
    记("索引等值查询", (长度(行们) == 1) 与 (行们[0]["值"] == 2), "")

    数据库.修改(库, "自检表", {"名": "甲"}, {"值": 10})
    记("修改", 数据库.查询(库, "自检表", {"名": "甲"})[0]["值"] == 10, "")

    数据库.删除(库, "自检表", {"名": "丙"})
    记("删除", 数据库.条数(库, "自检表") == 2, "")

    令 汇 = 数据库.汇总(库, "自检表", "值", "值")
    记("汇总", 长度(汇) == 2, "")   # 修改后只剩两组：10 和 2

    令 SQL行 = 数据库.执行查询(库, "SELECT COUNT(*) AS n FROM 自检表")
    记("SQL 查询", SQL行[0]["n"] == 2, "")

    数据库.执行(库, "UPDATE 自检表 SET 值 = 值 + 1 WHERE 名 = '乙'")
    记("SQL 写", 数据库.查询(库, "自检表", {"名": "乙"})[0]["值"] == 3, "")

    数据库.关闭(库)
    记("关闭", 文件.文件存在(库路径), "")

    令 库2 = 数据库.打开(库路径)
    记("重开持久化", 数据库.条数(库2, "自检表") == 2, "")
    数据库.关闭(库2)
捕获 异常 为 e：
    记("异常中止", 假, e.消息)

json.写文件(详情路径, 结果们, 缩进 = 2)
令 过数 = 结果们["通过"]
令 步数 = 长度(结果们["步骤"])
如果 长度(结果们["失败"]) == 0：
    打印(`selfcheck: OK ({过数}/{步数})`)
否则：
    打印(`selfcheck: FAIL {长度(结果们["失败"])} 项，详情见 {详情路径}`)