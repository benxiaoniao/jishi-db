# 基准 —— 可复跑的性能基准（数字进 README；结果写 JSON，控制台只打 ASCII 概要）
# 跑法：jishi tools/基准.jsh        （约 10 秒）
# 规模比 tests/压力_test.jsh（10 万行）小，用于快速核对性能没有退化。

导入 json
导入 路径
导入 时间
导入 基石数据库 从 本地包 为 数据库

令 结果们 = {}
令 出目录 = 路径.临时目录("jsdb基准结果")
令 目录 = 路径.临时目录("jsdb基准")
令 库路径 = 路径.连接(目录, "b.db")
令 库 = 数据库.打开(库路径)
数据库.建表(库, "账", ["名", "额", "旗"])

# ---------- 1. 批量插入 2 万 ----------
令 大数 = 20000
令 记录们 = []
遍历 i 在 范围(大数)：
    记录们.追加({"名": `用户{i}`, "额": i * 0.5, "旗": i % 2})
令 起 = 时间.高精度时间()
数据库.批量插入(库, "账", 记录们)
令 批耗时 = 时间.高精度时间() - 起
结果们["批量插入2万行"] = {"耗时秒": 批耗时, "每行毫秒": 批耗时 * 1000.0 / 大数}

# ---------- 2. 建索引 ----------
令 起2 = 时间.高精度时间()
数据库.建索引(库, "账", ["名"])
令 索耗时 = 时间.高精度时间() - 起2
结果们["建索引2万"] = {"耗时秒": 索耗时}

# ---------- 3. 索引等值 ×500 ----------
令 起3 = 时间.高精度时间()
遍历 k 在 范围(500)：
    数据库.查询(库, "账", {"名": `用户{k % 大数}`})
令 等耗时 = (时间.高精度时间() - 起3) / 500.0
结果们["索引等值查询"] = {"单次毫秒": 等耗时 * 1000.0}

# ---------- 4. 全表扫（范围条件） ----------
令 起4 = 时间.高精度时间()
令 命中们 = 数据库.查询(库, "账", {"额": {">": 9900, "<": 9910}})
令 扫耗时 = 时间.高精度时间() - 起4
结果们["全表扫范围查询"] = {"耗时秒": 扫耗时, "命中": 长度(命中们)}

# ---------- 5. SQL COUNT ----------
令 起5 = 时间.高精度时间()
令 数 = 数据库.执行查询(库, "SELECT COUNT(*) FROM 账 WHERE 额 > ?", [9000.0])[0]["COUNT(*)"]
令 SQL耗时 = 时间.高精度时间() - 起5
结果们["SQL_COUNT2万"] = {"耗时秒": SQL耗时, "命中": 数}

# ---------- 6. 逐行插入 5000（含自动紧凑） ----------
令 起6 = 时间.高精度时间()
遍历 i 在 范围(5000)：
    数据库.插入(库, "账", {"名": `散客{i}`, "额": i + 0.25, "旗": i % 2})
令 逐耗时 = 时间.高精度时间() - 起6
结果们["逐行插入5千行"] = {"耗时秒": 逐耗时, "每行毫秒": 逐耗时 * 1000.0 / 5000.0}

# ---------- 7. 汇总 ----------
令 起7 = 时间.高精度时间()
数据库.汇总(库, "账", "旗", "额")
令 汇耗时 = 时间.高精度时间() - 起7
结果们["汇总2.5万行"] = {"耗时秒": 汇耗时}

# ---------- 8. 排序取前 5 ----------
令 起8 = 时间.高精度时间()
数据库.查询(库, "账", {"id": {"<=": 5000}}, "额", 真, 5)
令 排耗时 = 时间.高精度时间() - 起8
结果们["排序5千取前5"] = {"耗时秒": 排耗时}

# ---------- 9. 关闭紧凑 + 重开 ----------
令 起9 = 时间.高精度时间()
数据库.关闭(库)
令 关耗时 = 时间.高精度时间() - 起9
令 起10 = 时间.高精度时间()
令 库2 = 数据库.打开(库路径)
令 开耗时 = 时间.高精度时间() - 起10
结果们["关闭紧凑"] = {"耗时秒": 关耗时}
结果们["重开"] = {"耗时秒": 开耗时}
数据库.关闭(库2)

json.写文件(路径.连接(出目录, "基准.json"), 结果们, 缩进 = 2)
函数 两位(数)：
    返回 文本(整数(数 * 100.0) / 100.0)

打印("benchmark done -> jsdb基准结果/基准.json")
打印(`bulk20000={两位(批耗时)}s index_eq={等耗时 * 1000.0}ms scan={两位(扫耗时)}s sql_count={两位(SQL耗时)}s`)
