# 迁移 —— 把 SQLite 库搬成基石数据库格式
# 跑法：jishi tools/迁移.jsh <SQLite库路径> <目标路径>
# 0.3.5 起内置 数据库 模块 = 本项目 0.1.0 内置版（不再有 rusqlite / pragma_table_info），
# 本工具改为两段式：python 子进程读真 SQLite（CPython 自带 sqlite3，C 内核 3.50.4），
# 目标库用本引擎写入。源路径经环境变量 JSDB_MIGRATE_SRC 传入（绕开 cmd 的引号坑）。
# 行为（与旧版一致）：
#   - 字段名来自 PRAGMA table_info（保序；空表也拿得到）
#   - rowid 真值：1..n 连续 → 批量插入保号；有空洞 → 逐行带 id 插（号保得住）；
#     拿不到 rowid（WITHOUT ROWID 表等）→ 顺序号
#   - SQLite 的索引/唯一约束搬不了，搬完自己用 建索引 重建
#   - 名为 id 的列搬不了（引擎里 id 是隐含自增列）——如实报错（整次中止并清半成品）
#   - 字节值原样搬（BLOB → 字节）；目标路径已存在 → 拒绝；中途失败 → 清掉半成品

导入 json
导入 编码
导入 文件
导入 路径
导入 系统
导入 文本 为 文本库
导入 基石数据库 从 本地包 为 数据库

函数 迁移_用法()：
    返回 文本库.拼接([
        "用法：jishi tools/迁移.jsh <SQLite库路径> <目标路径>",
        "把 SQLite 库整库搬成基石数据库格式（数据与 rowid；索引要自己重建）",
    ], "\n")

# JSON 里的 tagged 值 → 基石值：{"$字节b64": ...} → 字节
函数 迁移_解值(v)：
    如果 类型(v) == "字典"：
        如果 v.包含("$字节b64")：
            返回 编码.base64解码(v["$字节b64"])
    返回 v

# JSON 行（[rowid, 值…]）→ 记录字典（缺字段补空）
函数 迁移_净记录(行, 字段们)：
    令 净 = {}
    遍历 i 在 范围(长度(字段们))：
        净[字段们[i]] = 迁移_解值(行[i + 1])
    返回 净

函数 迁移_清半成品(目标)：
    如果 文件.文件存在(目标 + ".lock")：
        文件.删除文件(目标 + ".lock")
    如果 文件.文件存在(目标 + ".log")：
        文件.删除文件(目标 + ".log")
    如果 文件.文件存在(目标)：
        文件.删除文件(目标)

令 们 = 系统.参数()
如果 长度(们) < 2：
    打印(迁移_用法())
    如果 长度(们) > 0：
        抛出 值错误("参数不够：要给 SQLite 库路径和目标路径")
    否则：
        返回

令 源 = 们[0]
令 目标 = 们[1]
如果 非 (文件.文件存在(源))：
    抛出 文件错误(`SQLite 库不存在：{源}`)
如果 文件.文件存在(目标) 或 文件.文件存在(目标 + ".log")：
    抛出 文件错误(`目标已存在，拒绝覆盖：{目标}。想重来先删掉它`)

# python 子进程读源（语言 0.3.7 起 argv 列表形态直达子进程，路径带空格/引号都安全）
令 回 = 系统.执行详细(["python", "tools/sqlite迁移.py", 源], 300.0)
如果 回["退出码"] != 0：
    抛出 运行期错误(`读取 SQLite 失败（python tools/sqlite迁移.py）：{回["错误"]}`)
令 源json = 回["输出"].去空白()
令 数据 = json.解析(文件.读文本(源json))

令 新 = 数据库.打开(目标)
令 总行 = 0
令 总表 = 0
令 空表们 = []
尝试：
    遍历 表信 在 数据["库"]：
        令 表名 = 表信["表"]
        令 字段们 = 表信["字段们"]
        如果 长度(字段们) == 0：
            # PRAGMA 都没拿到的（如视图）→ 如实跳过
            空表们.追加(表名)
            继续
        数据库.建表(新, 表名, 字段们)
        令 行们 = 表信["行们"]
        如果 长度(行们) == 0：
            打印(`  {表名}: 0 行（空表）`)
            总表 += 1
            继续
        令 有rowid = 表信["有rowid"]
        令 连续 = 有rowid
        如果 有rowid：
            遍历 i 在 范围(长度(行们))：
                如果 行们[i][0] != i + 1：
                    连续 = 假
                    中断
        令 净们 = []
        遍历 行 在 行们：
            净们.追加(迁移_净记录(行, 字段们))
        如果 连续：
            # rowid 1..n：批量插入的自增序正好对上，保号还快
            数据库.批量插入(新, 表名, 净们)
        否则如果 有rowid：
            # 有空洞：逐行带 id 保号
            令 列串 = []
            遍历 字段 在 字段们：
                列串.追加(`"{字段}"`)
            遍历 i 在 范围(长度(净们))：
                令 占位 = []
                令 参数值 = []
                遍历 字段 在 字段们：
                    占位.追加("?")
                    参数值.追加(净们[i][字段])
                数据库.执行(新, `INSERT INTO "{表名}" (id, {文本库.拼接(列串, ", ")}) VALUES ({行们[i][0]}, {文本库.拼接(占位, ", ")})`, 参数值)
        否则：
            # rowid 拿不到（WITHOUT ROWID 表等）→ 顺序号，号保不住
            打印(`  {表名}: 拿不到 rowid，按 1..n 顺序号搬（原 rowid 保不住）`)
            数据库.批量插入(新, 表名, 净们)
        总表 += 1
        总行 += 长度(行们)
        打印(`  {表名}: {长度(行们)} 行`)
捕获 异常 为 e：
    数据库.关闭(新)
    迁移_清半成品(目标)
    抛出 e

数据库.关闭(新)

打印(`迁移完成：{总表} 张表、{总行} 行 → {目标}`)
如果 长度(空表们) > 0：
    打印(`跳过（字段拿不到，如视图）：{文本库.拼接(空表们, "、")}`)
打印("提醒：SQLite 的索引/唯一约束搬不过来，需要的话自己 建索引 重建")
