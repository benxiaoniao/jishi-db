# 迁移 —— 把 SQLite 库搬成基石数据库格式
# 跑法：jishi tools/迁移.jsh <SQLite库路径> <目标路径>
# 注意：本工具是**唯一**允许 导入 数据库（内置 SQLite 模块）的地方——引擎本体绝不依赖它。
# 行为：
#   - 字段名用 SQL 逃生口拿：SELECT name FROM pragma_table_info('表')（空表也拿得到）
#   - rowid 用 SELECT rowid AS 号 … ORDER BY rowid 拿真值；1..n 连续 → 批量插入，
#     有空洞 → 逐行带 id 插（慢一点，号保得住）；WITHOUT ROWID 表拿不到 rowid → 顺序号
#   - SQLite 的索引/唯一约束搬不了（15 API 读不到），搬完自己用 建索引 重建
#   - 名为 id 的列搬不了（引擎里 id 是隐含自增列），建表会报错——如实报出是哪张表
#   - 目标路径已存在 → 拒绝，防止误覆盖；中途失败 → 清掉半成品（快照/日志/锁）

导入 数据库 为 旧库                      # 内置 SQLite 模块（只许工具用）
导入 基石数据库 从 本地包 为 新库
导入 文件
导入 文本 为 文本库
导入 系统

函数 迁移_用法()：
    返回 文本库.拼接([
        "用法：jishi tools/迁移.jsh <SQLite库路径> <目标路径>",
        "把 SQLite 库整库搬成基石数据库格式（数据与 rowid；索引要自己重建）",
    ], "\n")

# 表字段名（保序）。拿不到 → 空列表
函数 迁移_字段们(源, 表名)：
    尝试：
        令 行们 = 旧库.执行查询(源, `SELECT name AS 字段名 FROM pragma_table_info('{表名}') ORDER BY cid`)
        令 字段们 = []
        遍历 行 在 行们：
            字段们.追加(行["字段名"])
        返回 字段们
    捕获 异常 为 e：
        返回 []

# rowid 真值列表（保序）。拿不到（如 WITHOUT ROWID）→ 空列表
函数 迁移_rowid们(源, 表名)：
    尝试：
        令 行们 = 旧库.执行查询(源, `SELECT rowid AS 号 FROM {表名} ORDER BY rowid`)
        令 号们 = []
        遍历 行 在 行们：
            号们.追加(行["号"])
        返回 号们
    捕获 异常 为 e：
        返回 []

# 净记录列表（去掉 id，缺字段补 空）
函数 迁移_净记录们(记录们, 字段们)：
    令 净们 = []
    遍历 记录 在 记录们：
        令 净 = {}
        遍历 字段 在 字段们：
            如果 字段 在 记录：
                净[字段] = 记录[字段]
            否则：
                净[字段] = 空
        净们.追加(净)
    返回 净们

函数 迁移_清半成品(目标)：
    如果 文件.文件存在(目标 + ".lock")：
        文件.删除文件(目标 + ".lock")
    如果 文件.文件存在(目标 + ".log")：
        文件.删除文件(目标 + ".log")
    如果 文件.文件存在(目标)：
        文件.删除文件(目标)

令 们 = 系统.参数()
如果 长度(们) < 2：
    打印(迁移_用法())
    如果 长度(们) > 0：
        抛出 值错误("参数不够：要给 SQLite 库路径和目标路径")
    否则：
        返回

令 源 = 们[0]
令 目标 = 们[1]
如果 非 (文件.文件存在(源))：
    抛出 文件错误(`SQLite 库不存在：{源}`)
如果 文件.文件存在(目标) 或 文件.文件存在(目标 + ".log")：
    抛出 文件错误(`目标已存在，拒绝覆盖：{目标}。想重来先删掉它`)

令 旧 = 旧库.打开(源)
令 新 = 新库.打开(目标)
令 总行 = 0
令 总表 = 0
令 空表们 = []
尝试：
    遍历 表名 在 旧库.表们(旧):
        令 字段们 = 迁移_字段们(旧, 表名)
        如果 长度(字段们) == 0：
            # pragma 都没拿到的表（如视图）→ 如实跳过
            空表们.追加(表名)
            继续
        令 记录们 = 旧库.查询(旧, 表名)
        新库.建表(新, 表名, 字段们)
        如果 长度(记录们) == 0：
            打印(`  {表名}: 0 行（空表）`)
            总表 += 1
            继续
        令 号们 = 迁移_rowid们(旧, 表名)
        令 连续 = (长度(号们) == 长度(记录们))
        如果 连续：
            遍历 i 在 范围(长度(号们))：
                如果 号们[i] != i + 1：
                    连续 = 假
                    中断
        令 净们 = 迁移_净记录们(记录们, 字段们)
        如果 连续：
            # rowid 1..n：批量插入的自增序正好对上，保号还快
            新库.批量插入(新, 表名, 净们)
        否则如果 长度(号们) == 长度(记录们)：
            # 有空洞：查询 与 rowid 查询都是 rowid 升序，按位对上，逐行带 id 保号
            令 列串 = []
            遍历 字段 在 字段们：
                列串.追加(`"{字段}"`)
            遍历 i 在 范围(长度(净们))：
                令 占位 = []
                令 参数值 = []
                遍历 字段 在 字段们：
                    占位.追加("?")
                    参数值.追加(净们[i][字段])
                新库.执行(新, `INSERT INTO "{表名}" (id, {文本库.拼接(列串, ", ")}) VALUES ({号们[i]}, {文本库.拼接(占位, ", ")})`, 参数值)
        否则：
            # rowid 拿不到（WITHOUT ROWID 表等）→ 顺序号，号保不住
            打印(`  {表名}: 拿不到 rowid，按 1..n 顺序号搬（原 rowid 保不住）`)
            新库.批量插入(新, 表名, 净们)
        总表 += 1
        总行 += 长度(记录们)
        打印(`  {表名}: {长度(记录们)} 行`)
捕获 异常 为 e：
    新库.关闭(新)
    迁移_清半成品(目标)
    抛出 e

旧库.关闭(旧)
新库.关闭(新)

打印(`迁移完成：{总表} 张表、{总行} 行 → {目标}`)
如果 长度(空表们) > 0：
    打印(`跳过（字段拿不到，如视图）：{文本库.拼接(空表们, "、")}`)
打印("提醒：SQLite 的索引/唯一约束搬不过来（内置 API 读不到），需要的话自己 建索引 重建")