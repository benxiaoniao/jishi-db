# 工具箱 —— 基石数据库的命令行小工具
# 跑法：jishi tools/工具箱.jsh <命令> […]
#   看表 <库路径>                              列出库里的表和行数
#   看记录 <库路径> <表名> [条数=10]            打印前 N 条（每行一条 JSON）
#   统计 <库路径> <表名>                        行数 + 各字段非空数与类型分布
#   导出CSV <库路径> <表名> <CSV路径>           全表导出成 CSV（含表头；不含 id 列）
#   导入CSV <库路径> <表名> <CSV路径>           CSV 导进表（表不存在则按表头新建）
#   备份 <库路径> <备份路径>                    关库紧凑后复制快照到备份路径
#   恢复 <备份路径> <库路径>                    用备份建一个新库（清掉旧日志）
# CSV 约定：空单元格 → 空；纯数字 → 整数/小数（会丢前导零，介意请改源码）；
#   含逗号/引号/换行的值用引号包裹、内部引号双写（RFC 4180）；字节列导出成 base64 文本（导不回）。

导入 基石数据库 从 本地包 为 数据库
导入 文件
导入 文本 为 文本库
导入 json
导入 编码
导入 系统

工具_引号 = 字符(34)
工具_逗号 = 字符(44)
工具_换行 = 字符(10)
工具_回车 = 字符(13)
工具_BOM = 字符(65279)

函数 工具_用法()：
    返回 文本库.拼接([
        "用法：jishi tools/工具箱.jsh <命令> …",
        "  看表 <库路径>",
        "  看记录 <库路径> <表名> [条数=10]",
        "  统计 <库路径> <表名>",
        "  导出CSV <库路径> <表名> <CSV路径>",
        "  导入CSV <库路径> <表名> <CSV路径>",
        "  备份 <库路径> <备份路径>",
        "  恢复 <备份路径> <库路径>",
    ], "\n")

函数 工具_参数不够(命令, 提示)：
    抛出 值错误(`「{命令}」{提示}。跑 jishi tools/工具箱.jsh 不带参数看用法`)

# ---------- CSV 编码 ----------

函数 工具_数字字符(c)：
    令 n = 序数(c)
    返回 (n >= 48) 与 (n <= 57)

# CSV 一格的编码：空 → 空串；字节 → base64；含逗号/引号/换行 → 引号包裹、内部引号双写
函数 工具_格文本(值)：
    如果 值 == 空：
        返回 ""
    令 类名 = 类型(值)
    如果 (类名 == "整数") 或 (类名 == "小数")：
        返回 文本(值)
    如果 类名 == "字节"：
        返回 编码.base64编码(值)
    令 s = 值
    如果 (s.包含(工具_逗号)) 或 (s.包含(工具_引号)) 或 (s.包含(工具_换行)) 或 (s.包含(工具_回车))：
        令 双写的 = 文本库.拼接(s.拆分(工具_引号), 工具_引号 + 工具_引号)
        返回 工具_引号 + 双写的 + 工具_引号
    返回 s

# CSV 文本 → 行们（列表的列表）。状态机：引号内的逗号/换行/双写引号都是字面值。
函数 工具_解析CSV(全文)：
    如果 全文.开头是(工具_BOM)：
        全文 = 文本库.去前缀(全文, 工具_BOM)
    令 行们 = []
    令 行 = []
    令 格 = ""
    令 在引号 = 假
    令 i = 0
    令 n = 长度(全文)
    当 i < n：
        令 c = 全文[i]
        如果 在引号：
            如果 c == 工具_引号：
                如果 (i + 1 < n) 与 (全文[i + 1] == 工具_引号)：
                    格 = 格 + 工具_引号
                    i += 2
                否则：
                    在引号 = 假
                    i += 1
            否则：
                格 = 格 + c
                i += 1
        否则如果 c == 工具_引号：
            在引号 = 真
            i += 1
        否则如果 c == 工具_逗号：
            行.追加(格)
            格 = ""
            i += 1
        否则如果 c == 工具_换行：
            行.追加(文本库.去后缀(格, 工具_回车))
            格 = ""
            行们.追加(行)
            行 = []
            i += 1
        否则：
            格 = 格 + c
            i += 1
    如果 (长度(行) > 0) 或 (长度(格) > 0)：
        行.追加(文本库.去后缀(格, 工具_回车))
        行们.追加(行)
    返回 行们

# CSV 单元格猜值："" → 空；纯数字 → 整数；数字.数字 → 小数；其余 → 原文本
函数 工具_猜值(s)：
    如果 s == ""：
        返回 空
    令 数文 = 文本库.去前缀(s, "-")
    如果 长度(数文) == 0：
        返回 s
    令 都是数字 = 真
    遍历 c 在 数文：
        如果 非 (工具_数字字符(c))：
            都是数字 = 假
            中断
    如果 都是数字：
        返回 整数(s)
    令 段们 = 数文.拆分(".")
    如果 (长度(段们) == 2) 与 (长度(段们[0]) > 0) 与 (长度(段们[1]) > 0)：
        令 整部分 = 真
        令 小部分 = 真
        遍历 c 在 段们[0]：
            如果 非 (工具_数字字符(c))：
                整部分 = 假
                中断
        遍历 c 在 段们[1]：
            如果 非 (工具_数字字符(c))：
                小部分 = 假
                中断
        如果 整部分 与 小部分：
            返回 小数(s)
    返回 s

# ---------- 命令 ----------

函数 工具_命令看表(其余)：
    如果 长度(其余) < 1：
        工具_参数不够("看表", "要给库路径")
    令 库 = 数据库.打开(其余[0])
    令 名们 = 数据库.表们(库)
    打印(`库「{其余[0]}」共 {长度(名们)} 张表`)
    遍历 表名 在 名们：
        打印(`  {表名}  {数据库.条数(库, 表名)} 行`)
    数据库.关闭(库)

函数 工具_命令看记录(其余)：
    如果 长度(其余) < 2：
        工具_参数不够("看记录", "要给库路径和表名")
    令 条数 = 10
    如果 长度(其余) >= 3：
        条数 = 整数(其余[2])
    令 库 = 数据库.打开(其余[0])
    令 行们 = 数据库.查询(库, 其余[1], 空, 空, 假, 条数)
    打印(`表「{其余[1]}」前 {长度(行们)} 行：`)
    遍历 行 在 行们：
        令 显 = {}
        遍历 键 在 行.键()：
            如果 类型(行[键]) == "字节"：
                显[键] = `字节(base64:{编码.base64编码(行[键])})`
            否则：
                显[键] = 行[键]
        打印(json.转文本(显))
    数据库.关闭(库)

函数 工具_命令统计(其余)：
    如果 长度(其余) < 2：
        工具_参数不够("统计", "要给库路径和表名")
    令 库 = 数据库.打开(其余[0])
    令 表名 = 其余[1]
    令 行们 = 数据库.查询(库, 表名)
    打印(`表「{表名}」共 {长度(行们)} 行`)
    令 计数们 = {}
    遍历 行 在 行们：
        遍历 字段 在 行.键()：
            令 记 = 计数们.获取(字段, 空)
            如果 记 == 空：
                记 = {"非空": 0, "类型们": {}}
                计数们[字段] = 记
            如果 行[字段] != 空：
                记["非空"] += 1
                令 类名 = 类型(行[字段])
                记["类型们"][类名] = 记["类型们"].获取(类名, 0) + 1
    遍历 字段 在 计数们.键()：
        令 记2 = 计数们[字段]
        令 分布 = []
        遍历 类名 在 记2["类型们"].键()：
            分布.追加(`{类名}×{记2["类型们"][类名]}`)
        打印(`  {字段}  非空 {记2["非空"]}  {文本库.拼接(分布, "、")}`)
    数据库.关闭(库)

函数 工具_命令导出CSV(其余)：
    如果 长度(其余) < 3：
        工具_参数不够("导出CSV", "要给库路径、表名、CSV路径")
    令 库 = 数据库.打开(其余[0])
    令 表名 = 其余[1]
    令 行们 = 数据库.查询(库, 表名)
    数据库.关闭(库)
    # CSV 表头从第一行数据的键来（15 个 API 不暴露表字段）；空表如实说明
    如果 长度(行们) == 0：
        抛出 值错误(`表「{表名}」里没有行，CSV 表头拿不到字段名。想搬空表请用「备份」`)
    令 字段们 = []
    遍历 键 在 行们[0].键()：
        如果 键 != "id"：
            字段们.追加(键)
    令 文本行们 = []
    令 头 = []
    遍历 字段 在 字段们：
        头.追加(工具_格文本(字段))
    文本行们.追加(文本库.拼接(头, 工具_逗号))
    遍历 行 在 行们：
        令 段们 = []
        遍历 字段 在 字段们：
            段们.追加(工具_格文本(行[字段]))
        文本行们.追加(文本库.拼接(段们, 工具_逗号))
    文件.写文本(其余[2], 文本库.拼接(文本行们, "\n") + "\n")
    打印(`导出 {长度(行们)} 行 → {其余[2]}`)

函数 工具_命令导入CSV(其余)：
    如果 长度(其余) < 3：
        工具_参数不够("导入CSV", "要给库路径、表名、CSV路径")
    令 表名 = 其余[1]
    令 全文 = 文件.读文本(其余[2])
    令 表格 = 工具_解析CSV(全文)
    如果 长度(表格) == 0：
        抛出 值错误(`CSV 是空的：{其余[2]}`)
    令 头 = 表格[0]
    # id 列是引擎自增的，导入时跳过
    令 用列 = []
    遍历 i 在 范围(长度(头))：
        如果 头[i] != "id"：
            用列.追加(i)
    令 库 = 数据库.打开(其余[0])
    如果 非 (数据库.有表(库, 表名))：
        令 字段们 = []
        遍历 i 在 用列：
            字段们.追加(头[i])
        数据库.建表(库, 表名, 字段们)
        打印(`表不存在，按表头新建：{文本库.拼接(字段们, "、")}`)
    令 记录们 = []
    遍历 r 在 范围(1, 长度(表格))：
        令 行 = 表格[r]
        令 记录 = {}
        遍历 i 在 用列：
            如果 i < 长度(行)：
                记录[头[i]] = 工具_猜值(行[i])
        记录们.追加(记录)
    令 数 = 数据库.批量插入(库, 表名, 记录们)
    数据库.关闭(库)
    打印(`导入 {数} 行 → {表名}`)

函数 工具_命令备份(其余)：
    如果 长度(其余) < 2：
        工具_参数不够("备份", "要给库路径和备份路径")
    令 库 = 数据库.打开(其余[0])    # 别的进程开着会报「库已被另一个进程打开」——如实
    数据库.关闭(库)                 # 关闭时紧凑：日志并进快照
    如果 文件.文件存在(其余[1])：
        文件.删除文件(其余[1])
    文件.复制(其余[0], 其余[1])
    打印(`备份完成：{其余[1]}`)

函数 工具_命令恢复(其余)：
    如果 长度(其余) < 2：
        工具_参数不够("恢复", "要给备份路径和库路径")
    如果 非 (文件.文件存在(其余[0]))：
        抛出 文件错误(`备份文件不存在：{其余[0]}`)
    如果 文件.文件存在(其余[1] + ".lock")：
        抛出 文件错误(`目标库好像正被打开（有锁文件）：{其余[1]}.lock。先关掉再恢复`)
    如果 文件.文件存在(其余[1] + ".log")：
        # 旧日志会在恢复后的快照上重放旧操作，必须清掉
        文件.删除文件(其余[1] + ".log")
    文件.复制(其余[0], 其余[1])
    打印(`恢复完成：{其余[1]}`)

# ---------- 分发 ----------

令 们 = 系统.参数()
如果 长度(们) == 0：
    打印(工具_用法())
否则如果 们[0] == "看表"：
    工具_命令看表(们[1:])
否则如果 们[0] == "看记录"：
    工具_命令看记录(们[1:])
否则如果 们[0] == "统计"：
    工具_命令统计(们[1:])
否则如果 们[0] == "导出CSV"：
    工具_命令导出CSV(们[1:])
否则如果 们[0] == "导入CSV"：
    工具_命令导入CSV(们[1:])
否则如果 们[0] == "备份"：
    工具_命令备份(们[1:])
否则如果 们[0] == "恢复"：
    工具_命令恢复(们[1:])
否则：
    打印(工具_用法())
    抛出 值错误(`不认识的命令「{们[0]}」`)
