# 索引 —— 索引的内存映射（唯一约束 + 等值查询加速）
# 兼容基准（设计.md §5.7）：
#   撞唯一约束 → 运行期错误 `数据库操作失败：UNIQUE constraint failed: 表.字段`
#   多字段索引的报错是 `表.甲, 表.乙` 形态（全列列出，逗号+空格分隔）
#   空值不参与唯一性（SQL 语义：NULL 不参与 UNIQUE）
#   建索引时字段不存在 → 值错误（引擎负责校验字段，本模块只管映射）
#   唯一索引映射：键 → 行（冲突检查）；非唯一索引映射：键 → 行列表（等值查询 O(命中)）
#   修改的调用约定：**先调 索引_改行 再改行里的字段**（旧键要从改前状态算）
# 性能注记：字典成员判断「在」对不存在的键走线性扫描（实测 10 万键 0.6ms/次），
#   而字典.获取(键, 默认) 未命中走哈希（1.3μs）——本模块一律用 获取 做存在性检查。

导入 json
导入 文本 为 文本库

# 从表状态重建全部映射（打开/载入快照后调一次）
函数 索引_重建(表状态, 表名)：
    令 映射们 = []
    遍历 定义 在 表状态["索引们"]：
        映射们.追加(索引_建映射(表状态, 表名, 定义["字段们"], 定义["唯一"]))
    表状态["映射们"] = 映射们

# 给一个索引定义建映射。唯一 → 有重复抛冲突；非唯一 → 键 → 行列表
函数 索引_建映射(表状态, 表名, 字段们, 唯一)：
    令 映射 = {}
    遍历 记录 在 表状态["记录们"]：
        令 键 = 索引_键文本(字段们, 记录)
        如果 键 != 空：
            令 旧 = 映射.获取(键, 空)
            如果 唯一：
                如果 旧 != 空：
                    索引_抛冲突(表名, 字段们)
                映射[键] = 记录
            否则如果 旧 != 空：
                旧.追加(记录)
            否则：
                映射[键] = [记录]
    返回 {"字段们": 字段们, "唯一": 唯一, "映射": 映射}

# 一条记录在指定字段们上的键文本；含空值 → 空（不参与唯一性）
函数 索引_键文本(字段们, 记录)：
    令 值们 = []
    遍历 字段 在 字段们：
        令 值 = 记录[字段]
        如果 值 == 空：
            返回 空
        值们.追加(值库_编码(值库_数键(值)))
    返回 json.转文本(值们)

函数 索引_抛冲突(表名, 字段们)：
    令 列们 = []
    遍历 字段 在 字段们：
        列们.追加(`{表名}.{字段}`)
    抛出 运行期错误(`数据库操作失败：UNIQUE constraint failed: {文本库.拼接(列们, ", ")}`)

# 插入一行：查重并登记。冲突抛运行期错误（原状不动——调用方在提交前调用）
函数 索引_加行(表状态, 表名, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            如果 映射项["映射"].获取(键, 空) != 空：
                索引_抛冲突(表名, 映射项["字段们"])

# 登记一行（已查过重，直接写入映射）
函数 索引_登记(表状态, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            令 旧 = 映射项["映射"].获取(键, 空)
            如果 映射项["唯一"]：
                映射项["映射"][键] = 记录
            否则如果 旧 != 空：
                旧.追加(记录)
            否则：
                映射项["映射"][键] = [记录]

# 删除一行：清掉它的键
函数 索引_删行(表状态, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            令 旧 = 映射项["映射"].获取(键, 空)
            如果 旧 != 空：
                如果 映射项["唯一"]：
                    映射项["映射"].弹出(键)
                否则：
                    索引_列表去行(映射项, 键, 旧, 记录)

# 从键的行列表里去掉这一行；空了就整个键删掉
函数 索引_列表去行(映射项, 键, 旧们, 记录)：
    令 留们 = []
    遍历 行 在 旧们：
        如果 行["id"] != 记录["id"]：
            留们.追加(行)
    如果 长度(留们) == 0：
        映射项["映射"].弹出(键)
    否则：
        映射项["映射"][键] = 留们

# 修改一行：检查新键是否撞别人（不撞不动手，返回给引擎判定）
# 行的新键与其它行的旧键冲突 → 抛错；自己占的键不算冲突
函数 索引_查改行(表状态, 表名, 记录, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        如果 非 索引_涉及(映射项, 新值)：
            继续
        令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(记录, 新值))
        如果 新键 != 空：
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 记录["id"])：
                索引_抛冲突(表名, 映射项["字段们"])

# 语句级预检：一批行全部改成同一个 新值 后，唯一性是否成立。
# 覆盖两种撞法：撞不在改动列表里的行；语句内两行改成同一个值
函数 索引_预检改们(表状态, 表名, 们, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        如果 非 索引_涉及(映射项, 新值)：
            继续
        令 占用 = {}
        遍历 行 在 们：
            令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(行, 新值))
            如果 新键 == 空：
                继续
            如果 占用.获取(新键, 空) != 空：
                索引_抛冲突(表名, 映射项["字段们"])
            占用[新键] = 行["id"]
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 行["id"])：
                索引_抛冲突(表名, 映射项["字段们"])

# 修改已通过预检，更新映射（先删旧键再记新键）。
# 注意：要在改行里的字段**之前**调——旧键从当前（改前）状态算
函数 索引_改行(表状态, 记录, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 索引_涉及(映射项, 新值)：
            继续
        如果 映射项["唯一"]：
            令 旧键 = 索引_键文本(映射项["字段们"], 记录)
            如果 旧键 != 空：
                映射项["映射"].弹出(旧键)
            令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(记录, 新值))
            如果 新键 != 空：
                映射项["映射"][新键] = 记录
        否则：
            令 旧键 = 索引_键文本(映射项["字段们"], 记录)
            如果 旧键 != 空：
                令 旧们 = 映射项["映射"].获取(旧键, 空)
                如果 旧们 != 空：
                    索引_列表去行(映射项, 旧键, 旧们, 记录)
            令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(记录, 新值))
            如果 新键 != 空：
                令 旧2 = 映射项["映射"].获取(新键, 空)
                如果 旧2 != 空：
                    旧2.追加(记录)
                否则：
                    映射项["映射"][新键] = [记录]

函数 索引_涉及(映射项, 新值)：
    遍历 字段 在 新值.键()：
        如果 字段 在 映射项["字段们"]：
            返回 真
    返回 假

函数 索引_改后行(记录, 新值)：
    令 改后 = {}
    遍历 字段 在 记录.键()：
        改后[字段] = 记录[字段]
    遍历 字段 在 新值.键()：
        改后[字段] = 新值[字段]
    返回 改后

# ---------- 查询加速 ----------

# 条件里能整体命中某索引的等值组 → 返回候选行们（空列表 = 键不在映射里，必无匹配）；
# 没有适用的索引（或条件有快速路径不支持的形态）→ 返回 空。
# 只做加速不改语义：调用方拿到候选后仍要过 条件_满足。
# 支持的等值形态：普通值（整数/小数/文本/字节/布尔/精确小数）；
#   字典（比较运算）、「空」（NULL 条件）、列表等 → 不适用，走全表扫（保持惰性报错语义）
函数 索引_候选行们(表, 条件)：
    如果 条件 == 空：
        返回 空
    遍历 映射项 在 表["映射们"]：
        令 值们 = []
        令 适用 = 真
        遍历 字段 在 映射项["字段们"]：
            如果 字段 不在 条件：
                适用 = 假
                中断
            令 期望 = 条件[字段]
            令 类名 = 类型(期望)
            如果 类名 == "字典"：
                适用 = 假
                中断
            如果 (类名 == "整数") 或 (类名 == "小数") 或 (类名 == "文本") 或 (类名 == "字节") 或 (类名 == "布尔") 或 (类名 == "精确小数")：
                值们.追加(期望)
            否则：
                # 「空」等值永不命中（交给线性扫）、列表等类型保持惰性报错
                适用 = 假
                中断
        如果 适用：
            令 拿 = 映射项["映射"].获取(值库_索引键(值们), 空)
            如果 拿 == 空：
                返回 []
            如果 映射项["唯一"]：
                返回 [拿]
            返回 拿
    返回 空
