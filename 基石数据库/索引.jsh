# 索引 —— 唯一约束的内存映射
# 兼容基准（设计.md §5.7）：
#   撞唯一约束 → 运行期错误 `数据库操作失败：UNIQUE constraint failed: 表.字段`
#   多字段索引的报错是 `表.甲, 表.乙` 形态（全列列出，逗号+空格分隔）
#   空值不参与唯一性（SQL 语义：NULL 不参与 UNIQUE）
#   建索引时字段不存在 → 值错误（引擎负责校验字段，本模块只管映射）
#   非唯一索引只存定义（等值查询走全表扫，行为与内置一致）

导入 json
导入 文本 为 文本库

# 从表状态重建全部唯一映射（打开/载入快照后调一次）
函数 索引_重建(表状态, 表名)：
    令 映射们 = []
    遍历 定义 在 表状态["索引们"]：
        如果 定义["唯一"]：
            令 映射 = {}
            遍历 记录 在 表状态["记录们"]：
                令 键 = 索引_键文本(定义["字段们"], 记录)
                如果 键 != 空：
                    如果 键 在 映射：
                        索引_抛冲突(表名, 定义["字段们"])
                    映射[键] = 记录["id"]
            映射们.追加({"字段们": 定义["字段们"], "映射": 映射})
    表状态["唯一映射们"] = 映射们

# 一条记录在指定字段们上的键文本；含空值 → 空（不参与唯一性）
函数 索引_键文本(字段们, 记录)：
    令 值们 = []
    遍历 字段 在 字段们：
        令 值 = 记录[字段]
        如果 值 == 空：
            返回 空
        值们.追加(值库_编码(值库_数键(值)))
    返回 json.转文本(值们)

函数 索引_抛冲突(表名, 字段们)：
    令 列们 = []
    遍历 字段 在 字段们：
        列们.追加(`{表名}.{字段}`)
    抛出 运行期错误(`数据库操作失败：UNIQUE constraint failed: {文本库.拼接(列们, ", ")}`)

# 插入一行：查重并登记。冲突抛运行期错误（原状不动——调用方在提交前调用）
函数 索引_加行(表状态, 表名, 记录)：
    遍历 映射项 在 表状态["唯一映射们"]：
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            如果 键 在 映射项["映射"]：
                索引_抛冲突(表名, 映射项["字段们"])

# 登记一行（已查过重，直接写入映射）
函数 索引_登记(表状态, 记录)：
    遍历 映射项 在 表状态["唯一映射们"]：
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            映射项["映射"][键] = 记录["id"]

# 删除一行：清掉它的键
函数 索引_删行(表状态, 记录)：
    遍历 映射项 在 表状态["唯一映射们"]：
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            如果 键 在 映射项["映射"]：
                映射项["映射"].弹出(键)

# 修改一行：检查新键是否撞别人（不撞不动手，返回给引擎判定）
# 行的新键与其它行的旧键冲突 → 抛错；自己占的键不算冲突
函数 索引_查改行(表状态, 表名, 记录, 新值)：
    遍历 映射项 在 表状态["唯一映射们"]：
        令 涉及 = 假
        遍历 字段 在 新值.键()：
            如果 字段 在 映射项["字段们"]：
                涉及 = 真
        如果 涉及：
            令 改后 = {}
            遍历 字段 在 记录.键()：
                改后[字段] = 记录[字段]
            遍历 字段 在 新值.键()：
                改后[字段] = 新值[字段]
            令 新键 = 索引_键文本(映射项["字段们"], 改后)
            如果 新键 != 空：
                如果 (新键 在 映射项["映射"]) 与 (映射项["映射"][新键] != 记录["id"])：
                    索引_抛冲突(表名, 映射项["字段们"])

# 修改已通过查重，更新映射（先删旧键再记新键）
函数 索引_改行(表状态, 记录, 新值)：
    遍历 映射项 在 表状态["唯一映射们"]：
        令 涉及 = 假
        遍历 字段 在 新值.键()：
            如果 字段 在 映射项["字段们"]：
                涉及 = 真
        如果 涉及：
            索引_删行键(映射项, 记录)
            令 改后 = {}
            遍历 字段 在 记录.键()：
                改后[字段] = 记录[字段]
            遍历 字段 在 新值.键()：
                改后[字段] = 新值[字段]
            令 新键 = 索引_键文本(映射项["字段们"], 改后)
            如果 新键 != 空：
                映射项["映射"][新键] = 记录["id"]

函数 索引_删行键(映射项, 记录)：
    令 键 = 索引_键文本(映射项["字段们"], 记录)
    如果 键 != 空：
        如果 键 在 映射项["映射"]：
            映射项["映射"].弹出(键)

# 建唯一索引前的全表查重（数据里已有重复 → 冲突）
函数 索引_建前查重(表状态, 表名, 字段们)：
    令 映射 = {}
    遍历 记录 在 表状态["记录们"]：
        令 键 = 索引_键文本(字段们, 记录)
        如果 键 != 空：
            如果 键 在 映射：
                索引_抛冲突(表名, 字段们)
            映射[键] = 记录["id"]
    返回 映射
