# 索引 —— 索引的内存映射（唯一约束 + 等值查询加速）
# 兼容基准（设计.md §5.7）：
#   撞唯一约束 → 运行期错误 `数据库操作失败：UNIQUE constraint failed: 表.字段`
#   多字段索引的报错是 `表.甲, 表.乙` 形态（全列列出，逗号+空格分隔）
#   空值不参与唯一性（SQL 语义：NULL 不参与 UNIQUE）
#   建索引时字段不存在 → 值错误（引擎负责校验字段，本模块只管映射）
#   唯一索引映射：键 → 行（冲突检查）；非唯一索引映射：键 → 行列表（等值查询 O(命中)）
#   修改的调用约定：**先调 索引_改行 再改行里的字段**（旧键要从改前状态算）
# 性能注记：字典成员判断「在」对不存在的键走线性扫描（实测 10 万键 0.6ms/次），
#   而字典.获取(键, 默认) 未命中走哈希（1.3μs）——本模块一律用 获取 做存在性检查。

导入 json
导入 文本 为 文本库

# 从表状态重建全部映射（打开/载入快照后调一次）
函数 索引_重建(表状态, 表名)：
    令 映射们 = []
    遍历 定义 在 表状态["索引们"]：
        映射们.追加(索引_建映射(表状态, 表名, 定义["字段们"], 定义["唯一"]))
    表状态["映射们"] = 映射们

# 给一个索引定义建映射。唯一 → 有重复抛冲突；非唯一 → 键 → 行列表
# 有序们：范围查询用的按值有序表（惰性建，写操作置空失效）
函数 索引_建映射(表状态, 表名, 字段们, 唯一)：
    令 映射 = {}
    遍历 记录 在 表状态["记录们"]：
        令 键 = 索引_键文本(字段们, 记录)
        如果 键 != 空：
            令 旧 = 映射.获取(键, 空)
            如果 唯一：
                如果 旧 != 空：
                    索引_抛冲突(表名, 字段们)
                映射[键] = 记录
            否则如果 旧 != 空：
                旧.追加(记录)
            否则：
                映射[键] = [记录]
    返回 {"字段们": 字段们, "唯一": 唯一, "映射": 映射, "有序们": 空}

# 一条记录在指定字段们上的键文本；含空值 → 空（不参与唯一性）
函数 索引_键文本(字段们, 记录)：
    令 值们 = []
    遍历 字段 在 字段们：
        令 值 = 记录[字段]
        如果 值 == 空：
            返回 空
        值们.追加(值库_编码(值库_数键(值)))
    返回 json.转文本(值们)

函数 索引_抛冲突(表名, 字段们)：
    令 列们 = []
    遍历 字段 在 字段们：
        列们.追加(`{表名}.{字段}`)
    抛出 运行期错误(`数据库操作失败：UNIQUE constraint failed: {文本库.拼接(列们, ", ")}`)

# 插入一行：查重并登记。冲突抛运行期错误（原状不动——调用方在提交前调用）
函数 索引_加行(表状态, 表名, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            如果 映射项["映射"].获取(键, 空) != 空：
                索引_抛冲突(表名, 映射项["字段们"])

# 登记一行（已查过重，直接写入映射）
函数 索引_登记(表状态, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        映射项["有序们"] = 空
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            令 旧 = 映射项["映射"].获取(键, 空)
            如果 映射项["唯一"]：
                映射项["映射"][键] = 记录
            否则如果 旧 != 空：
                旧.追加(记录)
            否则：
                映射项["映射"][键] = [记录]

# 删除一行：清掉它的键
函数 索引_删行(表状态, 记录)：
    遍历 映射项 在 表状态["映射们"]：
        映射项["有序们"] = 空
        令 键 = 索引_键文本(映射项["字段们"], 记录)
        如果 键 != 空：
            令 旧 = 映射项["映射"].获取(键, 空)
            如果 旧 != 空：
                如果 映射项["唯一"]：
                    映射项["映射"].弹出(键)
                否则：
                    索引_列表去行(映射项, 键, 旧, 记录)

# 从键的行列表里去掉这一行；空了就整个键删掉
函数 索引_列表去行(映射项, 键, 旧们, 记录)：
    令 留们 = []
    遍历 行 在 旧们：
        如果 行["id"] != 记录["id"]：
            留们.追加(行)
    如果 长度(留们) == 0：
        映射项["映射"].弹出(键)
    否则：
        映射项["映射"][键] = 留们

# 修改一行：检查新键是否撞别人（不撞不动手，返回给引擎判定）
# 行的新键与其它行的旧键冲突 → 抛错；自己占的键不算冲突
函数 索引_查改行(表状态, 表名, 记录, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        如果 非 索引_涉及(映射项, 新值)：
            继续
        令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(记录, 新值))
        如果 新键 != 空：
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 记录["id"])：
                索引_抛冲突(表名, 映射项["字段们"])

# 语句级预检：一批行全部改成同一个 新值 后，唯一性是否成立。
# 覆盖两种撞法：撞不在改动列表里的行；语句内两行改成同一个值
函数 索引_预检改们(表状态, 表名, 们, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 映射项["唯一"]：
            继续
        如果 非 索引_涉及(映射项, 新值)：
            继续
        令 占用 = {}
        遍历 行 在 们：
            令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(行, 新值))
            如果 新键 == 空：
                继续
            如果 占用.获取(新键, 空) != 空：
                索引_抛冲突(表名, 映射项["字段们"])
            占用[新键] = 行["id"]
            令 旧 = 映射项["映射"].获取(新键, 空)
            如果 (旧 != 空) 与 (旧["id"] != 行["id"])：
                索引_抛冲突(表名, 映射项["字段们"])

# 修改已通过预检，更新映射（先删旧键再记新键）。
# 注意：要在改行里的字段**之前**调——旧键从当前（改前）状态算
函数 索引_改行(表状态, 记录, 新值)：
    遍历 映射项 在 表状态["映射们"]：
        如果 非 索引_涉及(映射项, 新值)：
            继续
        映射项["有序们"] = 空
        如果 映射项["唯一"]：
            令 旧键 = 索引_键文本(映射项["字段们"], 记录)
            如果 旧键 != 空：
                映射项["映射"].弹出(旧键)
            令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(记录, 新值))
            如果 新键 != 空：
                映射项["映射"][新键] = 记录
        否则：
            令 旧键 = 索引_键文本(映射项["字段们"], 记录)
            如果 旧键 != 空：
                令 旧们 = 映射项["映射"].获取(旧键, 空)
                如果 旧们 != 空：
                    索引_列表去行(映射项, 旧键, 旧们, 记录)
            令 新键 = 索引_键文本(映射项["字段们"], 索引_改后行(记录, 新值))
            如果 新键 != 空：
                令 旧2 = 映射项["映射"].获取(新键, 空)
                如果 旧2 != 空：
                    旧2.追加(记录)
                否则：
                    映射项["映射"][新键] = [记录]

函数 索引_涉及(映射项, 新值)：
    遍历 字段 在 新值.键()：
        如果 字段 在 映射项["字段们"]：
            返回 真
    返回 假

函数 索引_改后行(记录, 新值)：
    令 改后 = {}
    遍历 字段 在 记录.键()：
        改后[字段] = 记录[字段]
    遍历 字段 在 新值.键()：
        改后[字段] = 新值[字段]
    返回 改后

# ---------- 查询加速 ----------

# 条件里能整体命中某索引的等值组 → 返回候选行们（空列表 = 键不在映射里，必无匹配）；
# 没有适用的索引（或条件有快速路径不支持的形态）→ 返回 空。
# 只做加速不改语义：调用方拿到候选后仍要过 条件_满足。
# 支持的等值形态：普通值（整数/小数/文本/字节/布尔/精确小数）；
#   字典（比较运算）、「空」（NULL 条件）、列表等 → 不适用，走全表扫（保持惰性报错语义）
函数 索引_候选行们(表, 条件)：
    如果 条件 == 空：
        返回 空
    遍历 映射项 在 表["映射们"]：
        令 值们 = []
        令 适用 = 真
        遍历 字段 在 映射项["字段们"]：
            如果 字段 不在 条件：
                适用 = 假
                中断
            令 期望 = 条件[字段]
            令 类名 = 类型(期望)
            如果 类名 == "字典"：
                适用 = 假
                中断
            如果 (类名 == "整数") 或 (类名 == "小数") 或 (类名 == "文本") 或 (类名 == "字节") 或 (类名 == "布尔") 或 (类名 == "精确小数")：
                值们.追加(期望)
            否则：
                # 「空」等值永不命中（交给线性扫）、列表等类型保持惰性报错
                适用 = 假
                中断
        如果 适用：
            令 拿 = 映射项["映射"].获取(值库_索引键(值们), 空)
            如果 拿 == 空：
                返回 []
            如果 映射项["唯一"]：
                返回 [拿]
            返回 拿
    返回 索引_范围候选(表, 条件)

# ---------- 范围加速（P5：单字段索引 + > < >= <=，二分取候选） ----------
# 语义不变：候选仍要过 条件_满足；结果顺序恢复成记录们原序（内置同款插入序）
# 有序表惰性建（首次范围查询时），写操作置空失效；多字段/!=/包含/非空 不适用

# 首个 值库_比较(值, 操) >= 0 的位（lower_bound）
函数 索引_下界(有序们, 操)：
    令 lo = 0
    令 hi = 长度(有序们)
    当 lo < hi：
        令 中 = (lo + hi) // 2
        如果 值库_比较(有序们[中]["值"], 操) < 0：
            lo = 中 + 1
        否则：
            hi = 中
    返回 lo

# 首个 值库_比较(值, 操) > 0 的位（upper_bound）
函数 索引_上界(有序们, 操)：
    令 lo = 0
    令 hi = 长度(有序们)
    当 lo < hi：
        令 中 = (lo + hi) // 2
        如果 值库_比较(有序们[中]["值"], 操) <= 0：
            lo = 中 + 1
        否则：
            hi = 中
    返回 lo

函数 索引_建有序(映射项, 字段)：
    令 包们 = []
    遍历 键 在 映射项["映射"].键()：
        令 拿 = 映射项["映射"][键]
        如果 映射项["唯一"]：
            包们.追加({"值": 拿[字段], "行": 拿})
        否则：
            遍历 行 在 拿：
                包们.追加({"值": 行[字段], "行": 行})
    返回 排序_执行(包们, [{"字段": "值", "倒": 假}])

函数 索引_范围候选(表, 条件)：
    遍历 映射项 在 表["映射们"]：
        如果 长度(映射项["字段们"]) != 1：
            继续
        令 字段 = 映射项["字段们"][0]
        如果 字段 不在 条件：
            继续
        令 期望 = 条件[字段]
        如果 类型(期望) != "字典"：
            继续
        # 全部运算符都是范围、操作数都是可存标量才加速（其余保持惰性报错/全表扫）
        令 可 = 真
        令 有范围 = 假
        令 操们 = {}
        遍历 符号 在 期望.键()：
            如果 (符号 != ">") 与 (符号 != "<") 与 (符号 != ">=") 与 (符号 != "<=")：
                可 = 假
                中断
            令 操 = 期望[符号]
            令 类名 = 类型(操)
            如果 非 ((类名 == "整数") 或 (类名 == "小数") 或 (类名 == "文本") 或 (类名 == "字节") 或 (类名 == "布尔") 或 (类名 == "精确小数"))：
                可 = 假
                中断
            操们[符号] = 值库_校验值(字段, 操)
            有范围 = 真
        如果 (非 可) 或 (非 有范围)：
            继续
        如果 映射项["有序们"] == 空：
            映射项["有序们"] = 索引_建有序(映射项, 字段)
        令 有序们 = 映射项["有序们"]
        令 lo = 0
        令 hi = 长度(有序们)
        遍历 符号 在 操们.键()：
            令 操 = 操们[符号]
            如果 符号 == ">"：
                令 位 = 索引_上界(有序们, 操)
                如果 位 > lo：
                    lo = 位
            否则如果 符号 == ">="：
                令 位 = 索引_下界(有序们, 操)
                如果 位 > lo：
                    lo = 位
            否则如果 符号 == "<"：
                令 位 = 索引_下界(有序们, 操)
                如果 位 < hi：
                    hi = 位
            否则：
                令 位 = 索引_上界(有序们, 操)
                如果 位 < hi：
                    hi = 位
        如果 lo >= hi：
            返回 []
        令 行们 = []
        遍历 i 在 范围(lo, hi)：
            行们.追加(有序们[i]["行"])
        # 恢复插入序：无删行/无显式 id 时 id 序即插入序（原生排序，k log k）；
        # 一般情形按记录们原序过滤（哈希成员判断，比逐行求值条件便宜得多）
        如果 长度(表["记录们"]) == 表["下一个id"] - 1：
            返回 行们.排序按(函数(行)：行["id"])
        令 集 = {}
        遍历 行 在 行们：
            集[行["id"]] = 真
        返回 [行 遍历 行 在 表["记录们"] 如果 行["id"] 在 集]
    返回 空

