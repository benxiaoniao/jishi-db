# 存储器 —— 快照 + 追加日志 + 锁文件
# 设计（设计.md §三/§四）：
#   <库路径>       = 快照：首行 `#基石数据库 快照 格式=1`，其余是 JSON
#   <库路径>.log   = 追加日志（JSONL），每次写操作一条；重放恢复最新状态
#   <库路径>.lock  = 锁文件（属主令牌+时间）；进程崩溃留残锁 → 文档让用户手删
#   紧凑：关闭时 / 日志行数 > 4096 时，快照+日志合并写回、清空日志
#   空路径 "" = 私有临时库（无盘），一切文件操作跳过
#   SQLite 文件检测 → 文件错误，提示用迁移工具

导入 json
导入 文件
导入 标识
导入 时间
导入 文本 为 文本库

存储器_快照头 = "#基石数据库 快照 格式=1"
存储器_紧凑阈值 = 4096

函数 存储器_日志路径(库路径)：
    返回 库路径 + ".log"

函数 存储器_锁路径(库路径)：
    返回 库路径 + ".lock"

# ---------- 日志句柄（P2：持久文件对象，每操作 写行+刷新） ----------
# 语言提供 文件.打开 时：打开一次常驻，追加走 写行+刷新（比逐行 追加文本 快约 48 倍）
# 没提供时：句柄恒为空，追加回退 文件.追加文本（功能与 durability 一致）

函数 存储器_开日志柄(状态)：
    状态["日志柄"] = 空
    如果 状态["无盘"]：
        返回
    令 柄 = 兼容_开文件(存储器_日志路径(状态["路径"]))
    如果 柄 != 空：
        状态["日志柄"] = 柄

函数 存储器_关日志柄(状态)：
    如果 状态["日志柄"] != 空：
        状态["日志柄"].关闭()
        状态["日志柄"] = 空

# ---------- 快照 ----------

# 读快照。文件不存在 → 空；空文件 → 空；格式不对 → 文件错误
函数 存储器_读快照(库路径)：
    如果 非 (文件.文件存在(库路径))：
        返回 空
    令 原文 = 文件.读文本(库路径)
    如果 长度(原文) == 0：
        返回 空
    令 行们 = 文件.按行读(库路径)
    如果 (长度(行们) == 0) 或 (行们[0] != 存储器_快照头)：
        令 前 = 原文
        如果 长度(前) > 100：
            前 = 前[0:100]
        如果 前.包含("SQLite format 3")：
            抛出 文件错误(`这个文件是 SQLite 库，基石数据库读不了：「{库路径}」。先用迁移工具把它转成基石格式`)
        抛出 文件错误(`这个文件不是基石数据库的格式：「{库路径}」。想搬 SQLite 库，先用迁移工具转换`)
    令 数据 = json.解析(文本库.拼接(行们[1:], "\n"))
    # 记录里的字节标签解码回来
    遍历 表名 在 数据["表们"].键()：
        令 表 = 数据["表们"][表名]
        遍历 记录 在 表["记录们"]：
            遍历 键 在 记录.键()：
                如果 键 != "id"：
                    记录[键] = 值库_解码(记录[键])
    返回 数据

# 写快照（原子替换）
函数 存储器_写快照(库路径, 表们)：
    令 数据 = {"格式": 1, "表们": {}}
    遍历 表名 在 表们.键()：
        令 表 = 表们[表名]
        令 记录们 = []
        遍历 记录 在 表["记录们"]：
            令 备份 = {}
            遍历 键 在 记录.键()：
                如果 键 == "id"：
                    备份["id"] = 记录["id"]
                否则：
                    备份[键] = 值库_编码(记录[键])
            记录们.追加(备份)
        数据["表们"][表名] = {
            "字段们": 表["字段们"],
            "下一个id": 表["下一个id"],
            "索引们": 表["索引们"],
            "记录们": 记录们,
        }
    文件.原子写(库路径, 存储器_快照头 + "\n" + json.转文本(数据))

# ---------- 日志 ----------

# 追加一条日志（每条写操作一行）。有持久句柄走 写行+刷新；否则逐行 追加文本
函数 存储器_追加日志(状态, 条目)：
    令 行 = json.转文本(条目)
    如果 状态["日志柄"] != 空：
        状态["日志柄"].写行(行)
        状态["日志柄"].刷新()
    否则：
        文件.追加文本(存储器_日志路径(状态["路径"]), 行 + "\n")

# 批量追加（事务提交用）：一次落整批，句柄路只刷新一次
函数 存储器_追加日志批(状态, 条目们)：
    令 行们 = []
    遍历 条目 在 条目们：
        行们.追加(json.转文本(条目))
    如果 状态["日志柄"] != 空：
        遍历 行 在 行们：
            状态["日志柄"].写行(行)
        状态["日志柄"].刷新()
    否则：
        文件.追加行们(存储器_日志路径(状态["路径"]), 行们)

# 重放日志到内存状态。尾部残行（崩溃没写完）→ 丢弃并重写日志；
# 中间坏行 → 文件错误（不假装没事）。返回有效行数
函数 存储器_重放(状态)：
    令 日志路径 = 存储器_日志路径(状态["路径"])
    如果 非 (文件.文件存在(日志路径))：
        返回 0
    令 行们 = 文件.按行读(日志路径)
    令 有效们 = []
    遍历 i 在 范围(长度(行们))：
        令 行 = 行们[i]
        如果 行 == ""：
            继续
        如果 json.有效(行)：
            令 条目 = json.解析(行)
            有效们.追加(条目)
            # 🔴 **真的要落到内存表上**（M202b 修）：`存储器_应用一条` 原来
            # 定义了却从没被调用过 —— 重放只数了行数，一条都没应用。
            # 后果：正常关闭靠「紧凑」写快照看不出问题；**没走完关闭**时，
            # 上次紧凑之后的改动全没了，而日志文件还在、看起来「有 WAL」。
            存储器_应用一条(状态, 条目)
        否则：
            如果 i == 长度(行们) - 1：
                # 尾部残行：崩在写一半。丢掉它，重写日志只留有效行
                存储器_重写日志(日志路径, 有效们)
                返回 长度(有效们)
            抛出 文件错误(`数据库日志中间有一行坏了：「{日志路径}」第 {i + 1} 行。日志损坏，没法自动修`)
    返回 长度(有效们)

函数 存储器_重写日志(日志路径, 条目们)：
    令 行们 = []
    遍历 条目 在 条目们：
        行们.追加(json.转文本(条目))
    如果 长度(行们) > 0：
        文件.原子写(日志路径, 文本库.拼接(行们, "\n") + "\n")
    否则：
        文件.原子写(日志路径, "")

# 重放一条日志到状态（引擎打开时用；顺序与产生顺序一致）
函数 存储器_应用一条(状态, 条目)：
    令 操作 = 条目["操作"]
    如果 操作 == "建表"：
        如果 非 (条目["表"] 在 状态["表们"])：
            状态["表们"][条目["表"]] = 存储器_新表状态(条目["字段们"])
    否则如果 操作 == "删表"：
        如果 条目["表"] 在 状态["表们"].键()：
            状态["表们"].弹出(条目["表"])
    否则如果 操作 == "插入"：
        存储器_落一行(状态, 条目["表"], 条目["id"], 条目["记录"])
    否则如果 操作 == "批量插入"：
        令 表 = 状态["表们"][条目["表"]]
        令 下一个 = 条目["起id"]
        遍历 记录 在 条目["记录们"]：
            存储器_落一行(状态, 条目["表"], 下一个, 记录)
            下一个 += 1
    否则如果 操作 == "改行"：
        令 表 = 状态["表们"][条目["表"]]
        # 先建 id → 行 字典（重放日志的 改动数 × 行数 双重循环在大日志上要秒级，实测 0.1.0 内置版重开 2.2万行×2千改 17 秒）
        令 行表 = {}
        遍历 记录 在 表["记录们"]：
            行表[记录["id"]] = 记录
        遍历 改 在 条目["改们"]：
            令 记录 = 行表.获取(改["id"], 空)
            如果 记录 != 空：
                遍历 键 在 改["新值"].键()：
                    记录[键] = 改["新值"][键]
    否则如果 操作 == "删行"：
        令 表 = 状态["表们"][条目["表"]]
        令 删集 = {}
        遍历 id 在 条目["id们"]：
            删集[id] = 真
        令 留们 = []
        遍历 记录 在 表["记录们"]：
            如果 记录["id"] 不在 删集：
                留们.追加(记录)
        表["记录们"] = 留们
    否则如果 操作 == "建索引"：
        令 表 = 状态["表们"][条目["表"]]
        令 已有 = 假
        遍历 定义 在 表["索引们"]：
            如果 (定义["字段们"] == 条目["索引"]["字段们"]) 与 (定义["唯一"] == 条目["索引"]["唯一"])：
                已有 = 真
        如果 非 已有：
            表["索引们"].追加(条目["索引"])
    否则如果 操作 == "加列"：
        令 表 = 状态["表们"][条目["表"]]
        表["字段们"].追加(条目["字段"])
        遍历 记录 在 表["记录们"]：
            记录[条目["字段"]] = 空

函数 存储器_新表状态(字段们)：
    返回 {"字段们": 字段们, "下一个id": 1, "索引们": [], "映射们": [], "记录们": []}

# 落一行（记录里的字节已是标签编码形态，解码回来）
函数 存储器_落一行(状态, 表名, id, 记录)：
    令 表 = 状态["表们"][表名]
    令 行 = {"id": id}
    遍历 字段 在 表["字段们"]：
        行[字段] = 值库_解码(记录.获取(字段, 空))
    表["记录们"].追加(行)
    如果 id >= 表["下一个id"]：
        表["下一个id"] = id + 1

# ---------- 紧凑 ----------

# 快照+日志合并写回，清空日志。
# 先关日志柄：Windows 上改名覆盖一个还开着的文件会失败
函数 存储器_紧凑(状态)：
    如果 状态["无盘"]：
        状态["日志行数"] = 0
        返回
    存储器_关日志柄(状态)
    存储器_写快照(状态["路径"], 状态["表们"])
    文件.原子写(存储器_日志路径(状态["路径"]), "")
    状态["日志行数"] = 0
    存储器_开日志柄(状态)

# 写操作之后调：超阈值就紧凑
函数 存储器_写后检查(状态)：
    如果 状态["日志行数"] > 存储器_紧凑阈值：
        存储器_紧凑(状态)

# ---------- 锁 ----------

函数 存储器_加锁(状态)：
    如果 状态["无盘"]：
        返回
    令 锁路径 = 存储器_锁路径(状态["路径"])
    如果 文件.文件存在(锁路径)：
        抛出 运行期错误(`库「{状态["路径"]}」已被另一个进程打开（锁文件：{锁路径}）。如果不是别的进程在用，删掉这个锁文件再试`)
    文件.写文本(锁路径, json.转文本({"属主": 标识.唯一标识短(), "打开时间": 时间.现在()}))

函数 存储器_清锁(状态)：
    如果 状态["无盘"]：
        返回
    令 锁路径 = 存储器_锁路径(状态["路径"])
    如果 文件.文件存在(锁路径)：
        文件.删除文件(锁路径)

