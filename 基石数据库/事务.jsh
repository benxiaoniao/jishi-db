# 事务 —— 开始/提交/回滚/用事务（兼容内置 数据库 模块，设计.md §六）
# 语义基准（0.3.4 内置实测）：
#   开始 → 空；嵌套开始 / 无事务提交 / 无事务回滚 → 值错误（消息逐字复刻）
#   事务内写操作内存可见但不落日志；提交一次性批量落日志；回滚恢复备份
#   语句级报错不影响事务（撞唯一后事务仍开，先前改动可提交）
#   关闭时未提交事务丢弃（快照不能带未提交改动）
#   事务期间不紧凑（日志行数只在提交时增长，快照不会写进未提交数据）

# 备份全部表状态（映射们不备——恢复后重建；值都是不可变标量，行浅拷贝即可）
函数 事务_备份(状态)：
    令 备 = {}
    遍历 名 在 状态["表们"].键()：
        令 表 = 状态["表们"][名]
        令 记们 = []
        遍历 行 在 表["记录们"]：
            令 复 = {}
            遍历 键 在 行.键()：
                复[键] = 行[键]
            记们.追加(复)
        令 索们 = []
        遍历 定义 在 表["索引们"]：
            索们.追加({"字段们": 定义["字段们"][0:长度(定义["字段们"])], "唯一": 定义["唯一"]})
        备[名] = {"字段们": 表["字段们"][0:长度(表["字段们"])], "下一个id": 表["下一个id"], "索引们": 索们, "记录们": 记们}
    返回 备

函数 事务_恢复(状态, 备)：
    令 表们 = {}
    遍历 名 在 备.键()：
        令 表 = 备[名]
        表["映射们"] = []
        表们[名] = 表
    状态["表们"] = 表们
    遍历 名 在 状态["表们"].键()：
        索引_重建(状态["表们"][名], 名)

函数 引擎_开始(状态)：
    如果 状态["事务"] != 空：
        抛出 值错误("已经在一个事务里了，不能再「开始」一次 —— 先用 数据库.提交 或 数据库.回滚 结束上一个事务")
    状态["事务"] = {"备份": 事务_备份(状态), "上次数": 状态["上次数"], "日志们": []}

函数 引擎_提交(状态)：
    如果 状态["事务"] == 空：
        抛出 值错误("现在不在事务里，没有可提交的改动 —— 先 数据库.开始(库)，改完再 数据库.提交(库)")
    令 日志们 = 状态["事务"]["日志们"]
    状态["事务"] = 空
    如果 长度(日志们) > 0：
        如果 非 状态["无盘"]：
            存储器_追加日志批(状态, 日志们)
        状态["日志行数"] += 长度(日志们)
        存储器_写后检查(状态)

函数 引擎_回滚(状态)：
    如果 状态["事务"] == 空：
        抛出 值错误("现在不在事务里，没有可回滚的改动 —— 先 数据库.开始(库)，再 数据库.回滚(库)")
    令 备 = 状态["事务"]["备份"]
    状态["上次数"] = 状态["事务"]["上次数"]
    状态["事务"] = 空
    事务_恢复(状态, 备)

函数 引擎_用事务(状态, 动作)：
    引擎_开始(状态)
    尝试：
        令 r = 动作()
        引擎_提交(状态)
        返回 r
    捕获 异常 为 e：
        # 动作里可能自己提交/回滚过——只在事务还开着时回滚，别遮掉原错误
        如果 状态["事务"] != 空：
            引擎_回滚(状态)
        抛出 e