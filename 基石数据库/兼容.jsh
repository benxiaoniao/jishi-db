# 兼容 —— 门面：21 个对外函数，名字与内置 数据库 模块一致
# 换一行导入即可跑：导入 基石数据库 从 本地包 为 数据库
# 参数与报错完全复刻内置（见 设计.md §五）；库句柄 = 打开 返回的路径文本

# 内建文件打开统一走值库的惰性探测（文件.打开 存在则用；门面同名会遮掉内建裸名）
# 语言没提供 文件.打开 时返回 空，存储器回退逐行 追加文本
函数 兼容_开文件(路径, 模式="追加")：
    令 开 = 值库_文件打开()
    如果 开 == 空：
        返回 空
    返回 开(路径, 模式)

函数 打开(路径)：
    返回 引擎_打开(路径)

函数 关闭(库)：
    引擎_关闭(库)

函数 表们(库)：
    返回 引擎_表们(引擎_句柄状态(库))

函数 有表(库, 表名)：
    返回 引擎_有表(引擎_句柄状态(库), 表名)

函数 建表(库, 表名, 字段们)：
    引擎_建表(引擎_句柄状态(库), 表名, 字段们)

函数 建索引(库, 表名, 字段们, 唯一=假)：
    引擎_建索引(引擎_句柄状态(库), 表名, 字段们, 唯一)

函数 插入(库, 表名, 记录)：
    返回 引擎_插入(引擎_句柄状态(库), 表名, 记录)

函数 批量插入(库, 表名, 记录们)：
    返回 引擎_批量插入(引擎_句柄状态(库), 表名, 记录们)

函数 修改(库, 表名, 条件, 新值)：
    返回 引擎_修改(引擎_句柄状态(库), 表名, 条件, 新值)

函数 删除(库, 表名, 条件)：
    返回 引擎_删除(引擎_句柄状态(库), 表名, 条件)

函数 查询(库, 表名, 条件=空, 排序=空, 倒序=假, 条数=空)：
    返回 引擎_查询(引擎_句柄状态(库), 表名, 条件, 排序, 倒序, 条数)

函数 条数(库, 表名, 条件=空)：
    返回 引擎_条数(引擎_句柄状态(库), 表名, 条件)

函数 汇总(库, 表名, 按, 求和, 条件=空)：
    返回 引擎_汇总(引擎_句柄状态(库), 表名, 按, 求和, 条件)

函数 执行(库, SQL, 参数们=空)：
    返回 SQL子集_执行(引擎_句柄状态(库), SQL, 参数们)

函数 执行查询(库, SQL, 参数们=空)：
    返回 SQL子集_查询(引擎_句柄状态(库), SQL, 参数们)

函数 开始(库)：
    引擎_开始(引擎_句柄状态(库))

函数 提交(库)：
    引擎_提交(引擎_句柄状态(库))

函数 回滚(库)：
    引擎_回滚(引擎_句柄状态(库))

函数 用事务(库, 动作)：
    返回 引擎_用事务(引擎_句柄状态(库), 动作)

函数 迁移(库, 目录)：
    返回 SQL子集_迁移(引擎_句柄状态(库), 目录)

函数 查询到表格(库, SQL, 参数们=空)：
    返回 SQL子集_查询到表格(引擎_句柄状态(库), SQL, 参数们)

