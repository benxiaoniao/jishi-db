# 条件 —— 条件字典的校验与求值
# 兼容基准（设计.md §5.4）：
#   {"字段": 值} 等值；{"字段": {">": 值}} 嵌套比较（多运算符全部生效，AND）
#   运算符只有 > < >= <= != 包含 非空
#   {"字段": 空} 永不匹配（SQL 语义 NULL=NULL 为假）；
#   {"字段": {"非空": 真}} 取非空行、{"非空": 假} 取空行
#   包含：文本子串；操作数非文本时按其文本形式比（数字 5 → "5"）
#   条件值不能是列表/字典；空值与任何比较（除「非空」）都不命中
#   报错格式：字段名进消息（「名」这个值是「列表」，存不进数据库）

导入 文本 为 文本库

条件_符号们 = [">", "<", ">=", "<=", "!=", "包含", "非空"]

函数 条件_排序键(s)：
    返回 s

# 校验条件的字段都在表里；缺失的按码点序排列（复刻内置）
函数 条件_校验字段(表名, 条件, 字段集合)：
    令 缺的 = []
    遍历 字段 在 条件.键()：
        如果 字段 不在 字段集合：
            缺的.追加(字段)
    如果 长度(缺的) > 0：
        缺的 = 缺的.排序按(条件_排序键)   # 排序按返回新列表，要接住
        抛出 值错误(`表「{表名}」里没有这些字段：{文本库.拼接(缺的, "、")}`)

# 判定一条记录是否满足条件（字段已校验过）
函数 条件_满足(记录, 条件)：
    遍历 字段 在 条件.键()：
        令 期望 = 条件[字段]
        令 期望类 = 类型(期望)
        如果 期望类 == "字典"：
            # 用户给的嵌套字典：符号必须是 7 个公开运算符之一（内部等值不外泄）
            遍历 符号 在 期望.键()：
                如果 符号 不在 条件_符号们：
                    抛出 值错误(`不认识的比较符号「{符号}」`)
                如果 非 (条件_一个符号(记录[字段], 字段, 符号, 期望[符号]))：
                    返回 假
        否则：
            # 等值路径：内部用 "=" 标记，字段名传给报错格式
            如果 非 (条件_一个符号(记录[字段], 字段, "=", 期望))：
                返回 假
    返回 真

# 一个比较符号的判定（条件名用于报错；"=" 是内部等值标记，不对外暴露）
函数 条件_一个符号(记录值, 条件名, 符号, 操作数)：
    如果 符号 == "="：
        操作数 = 值库_校验值(条件名, 操作数)
        # {"字段": 空} 永不匹配（SQL：NULL=NULL 为假）；记录值为空同样不命中
        如果 操作数 == 空：
            返回 假
        如果 记录值 == 空：
            返回 假
        返回 值库_比较(记录值, 操作数) == 0
    操作数 = 值库_校验值(条件名, 操作数)
    如果 符号 == "非空"：
        返回 (记录值 != 空) 如果 操作数 否则 (记录值 == 空)
    # 其余符号：SQL 语义，记录值是空一律不命中
    如果 记录值 == 空：
        返回 假
    如果 符号 == "包含"：
        返回 条件_包含(记录值, 操作数)
    令 序 = 值库_比较(记录值, 操作数)
    如果 符号 == "!="：
        返回 序 != 0
    如果 符号 == ">"：
        返回 序 > 0
    如果 符号 == "<"：
        返回 序 < 0
    如果 符号 == ">="：
        返回 序 >= 0
    返回 序 <= 0   # "<="

函数 条件_包含(记录值, 操作数)：
    令 大海 = 记录值 如果 类型(记录值) == "文本" 否则 文本(记录值)
    令 针 = 操作数 如果 类型(操作数) == "文本" 否则 文本(操作数)
    返回 大海.包含(针)
