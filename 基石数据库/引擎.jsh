# 引擎 —— 库注册表 + 15 个 API 的核心逻辑
# 兼容基准（设计.md §五）：错误消息逐字复刻；有意偏差见 §5.8/§5.13
# 注册表按绝对路径共享状态（同一路径重复打开=同一份；关闭其一全部失效）

导入 json
导入 文件
导入 路径
导入 编码
导入 文本 为 文本库

引擎_注册表 = {}

# ---------- 概貌（报错消息里的值显示，复刻语言显示规则的容器形态） ----------

函数 引擎_概貌(值)：
    令 类名 = 类型(值)
    如果 类名 == "空"：
        返回 "空"
    如果 类名 == "布尔"：
        返回 "真" 如果 值 否则 "假"
    如果 (类名 == "整数") 或 (类名 == "小数")：
        返回 文本(值)
    如果 类名 == "字节"：
        返回 引擎_字节概貌(值)
    如果 类名 == "文本"：
        返回 "'" + 值 + "'"
    如果 类名 == "列表"：
        令 段们 = []
        遍历 项 在 值：
            段们.追加(引擎_概貌(项))
        返回 "[" + 文本库.拼接(段们, ", ") + "]"
    如果 类名 == "字典"：
        令 段们 = []
        遍历 键 在 值.键()：
            段们.追加(引擎_概貌(键) + ": " + 引擎_概貌(值[键]))
        返回 "{" + 文本库.拼接(段们, ", ") + "}"
    返回 文本(值)

函数 引擎_字节概貌(值)：
    令 总 = 长度(值)
    令 个 = 总 如果 总 <= 16 否则 16
    令 十六 = 编码.十六进制编码(值[0:个], 真)
    令 段们 = []
    令 i = 0
    当 i < 长度(十六)：
        段们.追加(十六[i:i + 2])
        i += 2
    如果 总 > 16：
        返回 `字节({文本库.拼接(段们, " ")} … 共 {总} 个字节)`
    返回 `字节({文本库.拼接(段们, " ")})`

# ---------- 打开 / 关闭 / 句柄 ----------

函数 引擎_表名文本(表名)：
    返回 表名 如果 类型(表名) == "文本" 否则 文本(表名)

# 从原始路径文本推导父目录（保留调用方的分隔符写法——内置报错消息里路径原样）
函数 引擎_父目录文本(p)：
    令 反斜杠 = 字符(92)
    令 i = -1
    令 n = 长度(p)
    遍历 j 在 范围(n)：
        令 c = p[j]
        如果 (c == "/") 或 (c == 反斜杠)：
            i = j
    如果 i < 0：
        返回 ""
    返回 p[0:i]

函数 引擎_打开(路径文本)：
    令 无盘 = 长度(路径文本) == 0
    如果 非 无盘：
        令 父 = 引擎_父目录文本(路径文本)
        如果 (父 != "") 与 (父 != ".")：
            如果 非 (路径.存在(父))：
                抛出 文件错误(`目录不存在，建不了库：「{父}」`)
    令 键 = "" 如果 无盘 否则 路径.绝对路径(路径文本)
    如果 键 在 引擎_注册表：
        返回 路径文本
    令 状态 = {"句柄": 路径文本, "路径": 键, "无盘": 无盘, "表们": {}, "日志行数": 0, "上次数": 0}
    如果 非 无盘：
        令 载入 = 存储器_读快照(键)
        如果 载入 != 空：
            状态["表们"] = 载入["表们"]
        否则：
            # 新库（或空文件）：落一个只有头的快照——打开即有文件，与内置一致
            存储器_写快照(键, {})
        状态["日志行数"] = 存储器_重放(状态)
        # 旧快照没有「上次数」键（执行 的返回值基准），补 0
        如果 "上次数" 不在 状态：
            状态["上次数"] = 0
        遍历 表名 在 状态["表们"].键()：
            索引_重建(状态["表们"][表名], 表名)
        存储器_加锁(状态)
    引擎_注册表[键] = 状态
    返回 路径文本

函数 引擎_句柄状态(句柄)：
    令 键 = "" 如果 长度(句柄) == 0 否则 路径.绝对路径(句柄)
    如果 键 在 引擎_注册表：
        返回 引擎_注册表[键]
    抛出 值错误(`这个库还没打开：「{句柄}」`)

函数 引擎_关闭(句柄)：
    令 键 = "" 如果 长度(句柄) == 0 否则 路径.绝对路径(句柄)
    如果 键 在 引擎_注册表：
        令 状态 = 引擎_注册表[键]
        引擎_注册表.弹出(键)
        存储器_紧凑(状态)
        存储器_清锁(状态)
    # 幂等：没打开过 / 已关过 都不报错

# ---------- 表级 ----------

函数 引擎_表状态(状态, 表名)：
    令 名 = 引擎_表名文本(表名)
    如果 名 在 状态["表们"]：
        返回 状态["表们"][名]
    抛出 值错误(`没有表「{名}」`)

函数 引擎_校验字段们(表名, 名单, 字段集合)：
    令 缺的 = []
    遍历 字段 在 名单：
        如果 字段 不在 字段集合：
            缺的.追加(字段)
    如果 长度(缺的) > 0：
        缺的 = 缺的.排序按(条件_排序键)
        抛出 值错误(`表「{表名}」里没有这些字段：{文本库.拼接(缺的, "、")}`)

函数 引擎_建表(状态, 表名, 字段们)：
    令 名 = 引擎_表名文本(表名)
    如果 名 在 状态["表们"]：
        返回
    如果 类型(字段们) != "列表"：
        抛出 类型错误(`表「{名}」的字段们要给一个字段名列表`)
    如果 长度(字段们) == 0：
        抛出 值错误(`表「{名}」的字段们要给一个非空的字段名列表`)
    令 名单 = []
    遍历 元 在 字段们：
        令 字段 = 元 如果 类型(元) == "文本" 否则 文本(元)
        如果 字段 == "id"：
            抛出 值错误("字段名里不用写 id")
        名单.追加(字段)
    令 已见 = {}
    遍历 字段 在 名单：
        如果 字段 在 已见：
            抛出 运行期错误(`数据库操作失败：duplicate column name: {字段}`)
        已见[字段] = 真
    状态["表们"][名] = 存储器_新表状态(名单)
    引擎_记日志(状态, {"操作": "建表", "表": 名, "字段们": 名单})

# 删表（DROP TABLE 用）：表必须存在，否则报 SQLite 同款消息
函数 引擎_删表(状态, 表名)：
    令 名 = 引擎_表名文本(表名)
    如果 名 不在 状态["表们"]：
        抛出 运行期错误(`数据库操作失败：no such table: {名}`)
    状态["表们"].弹出(名)
    引擎_记日志(状态, {"操作": "删表", "表": 名})

函数 引擎_表们(状态)：
    令 名单 = []
    遍历 名 在 状态["表们"].键()：
        名单.追加(名)
    返回 名单.排序按(条件_排序键)

函数 引擎_有表(状态, 表名)：
    返回 引擎_表名文本(表名) 在 状态["表们"]

# ---------- 日志 ----------

函数 引擎_编码记录(记录)：
    令 备份 = {}
    遍历 键 在 记录.键()：
        如果 键 == "id"：
            备份["id"] = 记录["id"]
        否则：
            备份[键] = 值库_编码(记录[键])
    返回 备份

函数 引擎_记日志(状态, 条目)：
    如果 非 状态["无盘"]：
        存储器_追加日志(状态["路径"], 条目)
    状态["日志行数"] += 1
    存储器_写后检查(状态)

# ---------- 插入 ----------

# 校验并归一化一条记录；id 由调用方给（放在行首）
函数 引擎_校验记录(表, 名, 记录, id)：
    如果 类型(记录) != "字典"：
        抛出 类型错误("「记录」要给一个字典（字段 → 值）")
    如果 "id" 在 记录：
        抛出 值错误("id 是自动给的，不用写")
    令 多余 = []
    遍历 字段 在 记录.键()：
        如果 字段 不在 表["字段们"]：
            多余.追加(字段)
    如果 长度(多余) > 0：
        抛出 值错误(`表「{名}」里没有这些字段：{文本库.拼接(多余, "、")}`)
    如果 长度(记录.键()) == 0：
        # 有意偏差：内置这里是 SQLite 语法错（泄漏原文），我们给中文值错误
        抛出 值错误("插入的记录不能是空的，至少要给一个字段的值")
    令 行 = {"id": id}
    遍历 字段 在 表["字段们"]：
        行[字段] = 空
    遍历 字段 在 记录.键()：
        行[字段] = 值库_校验值(字段, 记录[字段])
    返回 行

函数 引擎_插入(状态, 表名, 记录)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    令 id = 表["下一个id"]
    令 行 = 引擎_校验记录(表, 名, 记录, id)
    索引_加行(表, 名, 行)
    表["记录们"].追加(行)
    索引_登记(表, 行)
    表["下一个id"] = id + 1
    引擎_记日志(状态, {"操作": "插入", "表": 名, "id": id, "记录": 引擎_编码记录(行)})
    状态["上次数"] = 1
    返回 id

# 插入带显式 id（SQL INSERT ... (id, ...) 用）
函数 引擎_插入带id(状态, 表名, 记录, id)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    令 行 = 引擎_校验记录(表, 名, 记录, id)
    索引_加行(表, 名, 行)
    表["记录们"].追加(行)
    索引_登记(表, 行)
    如果 id >= 表["下一个id"]：
        表["下一个id"] = id + 1
    引擎_记日志(状态, {"操作": "插入", "表": 名, "id": id, "记录": 引擎_编码记录(行)})
    状态["上次数"] = 1
    返回 id

# 批量插入：逐行校验+查重（与 SQLite 逐行事务一致）；任何一行失败整批回滚
函数 引擎_批量插入(状态, 表名, 记录们)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    如果 类型(记录们) != "列表"：
        抛出 类型错误("「记录们」要给一个字典列表")
    如果 长度(记录们) == 0：
        返回 0
    令 起 = 表["下一个id"]
    令 原下一个 = 表["下一个id"]
    令 原长 = 长度(表["记录们"])
    遍历 i 在 范围(长度(记录们))：
        尝试：
            令 行 = 引擎_校验记录(表, 名, 记录们[i], 起 + i)
            索引_加行(表, 名, 行)
            表["记录们"].追加(行)
            索引_登记(表, 行)
            表["下一个id"] = 行["id"] + 1
        捕获 异常 为 e：
            # 回滚：记录截回原长，映射重建
            表["记录们"] = 表["记录们"][0:原长]
            索引_重建(表, 名)
            表["下一个id"] = 原下一个
            抛出 e
    令 编码们 = []
    遍历 行 在 表["记录们"][原长:]：
        编码们.追加(引擎_编码记录(行))
    引擎_记日志(状态, {"操作": "批量插入", "表": 名, "起id": 起, "记录们": 编码们})
    状态["上次数"] = 长度(记录们)
    返回 长度(记录们)

# ---------- 条件 / 排序 规整 ----------

函数 引擎_规整条件(表, 名, 条件)：
    如果 条件 == 空：
        返回 空
    如果 类型(条件) != "字典"：
        抛出 类型错误(`「条件」要给一个字典（字段 → 值），给过来的却是「{引擎_概貌(条件)}」`)
    条件_校验字段(名, 条件, ["id"] + 表["字段们"])
    返回 条件

函数 引擎_规整排序(表, 名, 排序)：
    如果 排序 == 空：
        返回 []
    令 类名 = 类型(排序)
    如果 类名 == "文本"：
        如果 排序 == ""：
            返回 []
        令 名单 = [排序]
    否则如果 类名 == "列表"：
        如果 长度(排序) == 0：
            抛出 值错误(`排序字段要给一个非空的字段名列表，例如 ["金额"]`)
        令 名单 = []
        遍历 元 在 排序：
            名单.追加(元 如果 类型(元) == "文本" 否则 文本(元))
    否则：
        抛出 值错误(`排序字段要给一个非空的字段名列表，例如 ["金额"]`)
    引擎_校验字段们(名, 名单, ["id"] + 表["字段们"])
    返回 [{"字段": s, "倒": 假} 遍历 s 在 名单]

# 条件 → 匹配行们：有可用索引走索引候选（等值 O(命中数)），否则全表扫。
# 语义与全表扫一致：候选行仍要过 条件_满足；没有适用索引 → 空 → 全表扫
函数 引擎_条件行们(表, 条件有效)：
    令 候选 = 索引_候选行们(表, 条件有效)
    如果 候选 != 空：
        返回 [行 遍历 行 在 候选 如果 条件_满足(行, 条件有效)]
    返回 [行 遍历 行 在 表["记录们"] 如果 条件_满足(行, 条件有效)]

# ---------- 查询 / 条数 ----------

函数 引擎_查询(状态, 表名, 条件, 排序, 倒序, 条数)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    令 条件有效 = 引擎_规整条件(表, 名, 条件)
    令 键们 = 引擎_规整排序(表, 名, 排序)
    令 行们 = 表["记录们"]
    如果 条件有效 != 空：
        行们 = 引擎_条件行们(表, 条件有效)
    如果 长度(键们) > 0：
        行们 = 排序_执行(行们, 键们)
    如果 倒序：
        行们 = 反转(行们)
    如果 条数 != 空：
        如果 类型(条数) != "整数"：
            抛出 类型错误("需要整数")
        如果 条数 < 0：
            抛出 值错误(`条数要给非负整数，给的是「{条数}」`)
        # 实测内置：条数=0 → 不限制（返回全部）
        如果 (条数 > 0) 与 (条数 < 长度(行们))：
            行们 = 行们[0:条数]
    令 结果 = []
    遍历 行 在 行们：
        令 复制 = {}
        遍历 键 在 行.键()：
            复制[键] = 行[键]
        结果.追加(复制)
    返回 结果

函数 引擎_条数(状态, 表名, 条件)：
    令 表 = 引擎_表状态(状态, 表名)
    如果 条件 == 空：
        返回 长度(表["记录们"])
    令 名 = 引擎_表名文本(表名)
    令 条件有效 = 引擎_规整条件(表, 名, 条件)
    令 候选 = 索引_候选行们(表, 条件有效)
    令 n = 0
    如果 候选 != 空：
        遍历 行 在 候选：
            如果 条件_满足(行, 条件有效)：
                n += 1
    否则：
        遍历 行 在 表["记录们"]：
            如果 条件_满足(行, 条件有效)：
                n += 1
    返回 n

# ---------- 修改 / 删除 ----------

函数 引擎_校验新值(表, 名, 新值)：
    # 实测内置：新值非字典或空字典 → 类型错误「新值」要给一个非空字典
    如果 (类型(新值) != "字典") 或 (长度(新值.键()) == 0)：
        抛出 类型错误("「新值」要给一个非空字典")
    遍历 字段 在 新值.键()：
        如果 字段 == "id"：
            # 实测内置：修改里给 id → 专门消息
            抛出 值错误("id 是主键，不能改")
        如果 字段 不在 表["字段们"]：
            # 只报第一个（复刻内置）
            抛出 值错误(`表「{名}」里没有这些字段：{字段}`)
    令 新行 = {}
    遍历 字段 在 新值.键()：
        新行[字段] = 值库_校验值(字段, 新值[字段])
    返回 新行

函数 引擎_修改(状态, 表名, 条件, 新值)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    # 实测内置校验顺序：空条件 → 新值 → 条件字段
    如果 条件 == 空：
        抛出 值错误("「修改」必须给条件")
    令 新值行 = 引擎_校验新值(表, 名, 新值)
    令 条件有效 = 引擎_规整条件(表, 名, 条件)
    如果 长度(条件有效.键()) == 0：
        抛出 值错误("「修改」必须给条件")
    令 们 = 引擎_条件行们(表, 条件有效)
    # 唯一约束先全查（语句级原子：查不中一行都不改；语句内两行改成同值也算撞）
    索引_预检改们(表, 名, 们, 新值行)
    # 先更新索引映射（旧键要从改前状态算），再改行里的字段
    遍历 行 在 们：
        索引_改行(表, 行, 新值行)
    遍历 行 在 们：
        遍历 字段 在 新值行.键()：
            行[字段] = 新值行[字段]
    令 改们 = []
    遍历 行 在 们：
        改们.追加({"id": 行["id"], "新值": 引擎_编码记录(新值行)})
    引擎_记日志(状态, {"操作": "改行", "表": 名, "改们": 改们})
    状态["上次数"] = 长度(们)
    返回 长度(们)

函数 引擎_删除(状态, 表名, 条件)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    如果 条件 == 空：
        抛出 值错误("「删除」必须给条件")
    令 条件有效 = 引擎_规整条件(表, 名, 条件)
    如果 长度(条件有效.键()) == 0：
        抛出 值错误("「删除」必须给条件")
    令 们 = 引擎_条件行们(表, 条件有效)
    令 id们 = []
    令 删集 = {}
    遍历 行 在 们：
        id们.追加(行["id"])
        删集[行["id"]] = 真
        索引_删行(表, 行)
    表["记录们"] = [行 遍历 行 在 表["记录们"] 如果 非 (行["id"] 在 删集)]
    引擎_记日志(状态, {"操作": "删行", "表": 名, "id们": id们})
    状态["上次数"] = 长度(们)
    返回 长度(们)

# ---------- 汇总 ----------

# 组键：整数变文本（复刻内置：整数 3 → 键 "3"），其余原样
函数 引擎_组键(值)：
    如果 类型(值) == "整数"：
        返回 文本(值)
    返回 值

函数 引擎_汇总(状态, 表名, 按, 求和, 条件)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    令 条件有效 = 引擎_规整条件(表, 名, 条件)
    令 按名 = 按 如果 类型(按) == "文本" 否则 文本(按)
    令 和名 = 求和 如果 类型(求和) == "文本" 否则 文本(求和)
    # 字段存在：按 先查（SELECT 列顺序）
    引擎_校验字段们(名, [按名], ["id"] + 表["字段们"])
    引擎_校验字段们(名, [和名], ["id"] + 表["字段们"])
    令 行们 = 表["记录们"]
    如果 条件有效 != 空：
        行们 = [行 遍历 行 在 行们 如果 条件_满足(行, 条件有效)]
    # 求和列先验值（实测：空值与不是数字的值都报「类型错误」）
    遍历 行 在 行们：
        令 v = 行[和名]
        如果 v == 空：
            抛出 类型错误(`「{和名}」这一列里有空值，没法汇总`)
        令 v类 = 类型(v)
        如果 (v类 != "整数") 与 (v类 != "小数")：
            抛出 类型错误(`「{和名}」这一列里有不是数字的值「{v 如果 类型(v) == "文本" 否则 引擎_概貌(v)}」，没法汇总`)
    # 组列验空值
    遍历 行 在 行们：
        如果 行[按名] == 空：
            抛出 类型错误(`「{按名}」这一列里有空值，没法汇总`)
    # 分组（组键保持首现顺序）
    令 组们 = {}
    令 顺序 = []
    遍历 行 在 行们：
        令 组值 = 行[按名]
        令 键 = json.转文本([值库_编码(组值)])
        如果 键 不在 组们：
            组们[键] = {"显示": 引擎_组键(组值), "个数": 0, "总和": 0.0, "最大": 空, "最小": 空}
            顺序.追加(键)
        令 组 = 组们[键]
        组["个数"] += 1
        令 v = 小数(行[和名])
        组["总和"] = 组["总和"] + v
        如果 (组["最大"] == 空) 或 (值库_比较(v, 组["最大"]) > 0)：
            组["最大"] = v
        如果 (组["最小"] == 空) 或 (值库_比较(v, 组["最小"]) < 0)：
            组["最小"] = v
    令 结果 = {}
    遍历 键 在 顺序：
        令 组 = 组们[键]
        结果[组["显示"]] = {
            "个数": 组["个数"],
            "总和": 组["总和"],
            "平均": 组["总和"] / 组["个数"],
            "最大": 组["最大"],
            "最小": 组["最小"],
        }
    返回 结果

# ---------- 建索引 ----------

函数 引擎_建索引(状态, 表名, 字段们, 唯一)：
    令 表 = 引擎_表状态(状态, 表名)
    令 名 = 引擎_表名文本(表名)
    如果 类型(字段们) != "列表"：
        抛出 类型错误("建索引的字段们要给一个字段名列表")
    如果 长度(字段们) == 0：
        # 实测内置：空列表 → 值错误「索引字段要给一个非空的字段名列表」
        抛出 值错误("索引字段要给一个非空的字段名列表")
    令 名单 = []
    遍历 元 在 字段们：
        名单.追加(元 如果 类型(元) == "文本" 否则 文本(元))
    引擎_校验字段们(名, 名单, ["id"] + 表["字段们"])
    # 同定义已存在 → 不动（实测内置重复建索引不报错）
    遍历 定义 在 表["索引们"]：
        如果 (定义["字段们"] == 名单) 与 (定义["唯一"] == 唯一)：
            返回
    # 建映射（唯一 → 已有重复数据当场抛冲突，整库不动；非唯一 → 键 → 行列表）
    令 映射项 = 索引_建映射(表, 名, 名单, 唯一)
    表["索引们"].追加({"字段们": 名单, "唯一": 唯一})
    表["映射们"].追加(映射项)
    引擎_记日志(状态, {"操作": "建索引", "表": 名, "索引": {"字段们": 名单, "唯一": 唯一}})
