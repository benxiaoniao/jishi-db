# 值库 —— 值的校验、归一化、编码、比较
# 兼容基准（设计.md §5.3/§5.4）：
#   可存类型：整数 / 小数 / 文本 / 字节 / 空 / 布尔（入库转整数）/ 精确小数（入库转小数）
#   列表 / 字典不能存：「X」这个值是「列表」，存不进数据库
#   类型序（SQLite 语义）：空 < 数字 < 文本 < 字节
#   文本比较按码点（0.3.4 起原生 < 支持文本，直接用）

导入 编码
导入 json
导入 文件

# 内建文件打开的引用：门面「打开」（兼容.jsh）会遮掉包内裸「打开」，而包内
# 没有任何别名途径够到内建（顶层/类体提前读=E0301，跨包导入不支持）。
# 语言侧逃生口尚未落地（清单 N1，推荐 内建.名字，次选 文件.打开）——本探测双通道：
# 先探 文件.打开（语言若把它加进 文件 模块），再探 内建.打开（语言若加内建逃生口）；
# 都没有则回退 文件.追加文本（每行开关文件，慢但功能一致）。自检报告当前路径。
# 惰性探测：加载期顶层变量对函数体不可见，首次运行时才探一次。
值库_开箱 = {"探过": 假, "开": 空}
函数 值库_文件打开()：
    如果 非 值库_开箱["探过"]：
        值库_开箱["探过"] = 真
        尝试：
            值库_开箱["开"] = 文件.打开
        捕获 异常 为 e：
            值库_开箱["开"] = 空
        如果 值库_开箱["开"] == 空：
            尝试：
                值库_开箱["开"] = 内建.打开
            捕获 异常 为 e2：
                值库_开箱["开"] = 空
    返回 值库_开箱["开"]

# ---- 类型序常量 ----
值库_空序 = 0
值库_数序 = 1
值库_文序 = 2
值库_字节序 = 3

值库_可存类型们 = ["整数", "小数", "文本", "字节", "空", "布尔", "精确小数"]

# 可存类型的值（含布尔/精确归一化）；不合法抛「类型错误」
函数 值库_校验值(字段名, 值)：
    令 类名 = 类型(值)
    如果 类名 == "布尔"：
        返回 1 如果 值 否则 0
    如果 类名 == "精确小数"：
        返回 小数(值)
    如果 类名 == "整数":
        # 上限 i64（与内置同边界）；下界**不能写成字面量**（先解析 9223372036854775808 就溢出了）
        如果 (值 > 9223372036854775807) 或 (值 < (0 - 9223372036854775807) - 1):
            抛出 值错误(`「{字段名}」这个整数超出了数据库的范围（约 ±9.2e18）：{值}（特别大的数存成文本，或者拆成两部分存）`)
        返回 值
    如果 类名 在 值库_可存类型们：
        返回 值
    # 字典 / 列表最常见：给的说法要能照着改（原先把这句放在调用方的 hint 里，
    # 宿主换成纯基石实现后必须自己说全）
    如果 类名 == "字典":
        抛出 类型错误(`「{字段名}」这个值是「字典」，存不进数据库（用 json.文本化(值) 先转成文本再存；或者拆成几张表）`)
    抛出 类型错误(`「{字段名}」这个值是「{类名}」，存不进数据库（用 json.文本化(值) 先转成文本再存；多个值就拆成多条记录）`)

# 存盘编码：字节 → {"$字节": base64}（JSON 没有二进制）
函数 值库_编码(值)：
    如果 类型(值) == "字节"：
        返回 {"$字节": 编码.base64编码(值)}
    返回 值

# 存盘解码：{"$字节": base64} → 字节
函数 值库_解码(值)：
    如果 类型(值) == "字典"：
        如果 值.包含("$字节") 与 长度(值) == 1：
            返回 编码.base64解码(值["$字节"])
    返回 值

# 类型序：空 < 数字 < 文本 < 字节
函数 值库_类型序(值)：
    令 类名 = 类型(值)
    如果 类名 == "空"：
        返回 值库_空序
    如果 类名 == "整数" 或 类名 == "小数"：
        返回 值库_数序
    如果 类名 == "文本"：
        返回 值库_文序
    如果 类名 == "字节"：
        返回 值库_字节序
    返回 4

# 文本比较：码点序（0.3.4 原生 < 即码点序，比手写逐码点快约 12 倍）
函数 值库_文本比较(甲, 乙)：
    如果 甲 < 乙：
        返回 -1
    如果 甲 > 乙：
        返回 1
    返回 0

# 全类型比较：先比类型序，再比值。返回 -1 / 0 / 1
函数 值库_比较(甲, 乙)：
    令 甲序 = 值库_类型序(甲)
    令 乙序 = 值库_类型序(乙)
    如果 甲序 < 乙序：
        返回 -1
    如果 甲序 > 乙序：
        返回 1
    如果 甲序 == 值库_空序：
        返回 0
    如果 甲序 == 值库_数序：
        如果 甲 < 乙：
            返回 -1
        如果 甲 > 乙：
            返回 1
        返回 0
    如果 甲序 == 值库_文序：
        返回 值库_文本比较(甲, 乙)
    # 字节：基石的 < 对字节可用（按字典序）
    如果 甲 < 乙：
        返回 -1
    如果 甲 > 乙：
        返回 1
    返回 0

# 相等（类型序相同且值相等；1 == 1.0 为真）
函数 值库_相等(甲, 乙)：
    返回 值库_比较(甲, 乙) == 0

# 索引键用的数字归一：1.0 与 1 同键（SQLite 数值等值语义）
函数 值库_数键(值)：
    如果 类型(值) == "小数"：
        如果 值 == 整数(值)：
            返回 整数(值)
    返回 值

# 索引复合键：值们 → 稳定的 JSON 文本（先归一化再编码）
函数 值库_索引键(值们)：
    令 键值们 = []
    遍历 值 在 值们：
        令 归一 = 值库_校验值("索引键", 值)
        键值们.追加(值库_编码(值库_数键(归一)))
    返回 json.转文本(键值们)

