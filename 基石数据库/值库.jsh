# 值库 —— 值的校验、归一化、编码、比较
# 兼容基准（设计.md §5.3/§5.4）：
#   可存类型：整数 / 小数 / 文本 / 字节 / 空 / 布尔（入库转整数）/ 精确小数（入库转小数）
#   列表 / 字典不能存：「X」这个值是「列表」，存不进数据库
#   类型序（SQLite 语义）：空 < 数字 < 文本 < 字节
#   文本比较按码点（基石的 < 不能比文本，这里手写）

导入 编码
导入 json

# ---- 类型序常量 ----
值库_空序 = 0
值库_数序 = 1
值库_文序 = 2
值库_字节序 = 3

值库_可存类型们 = ["整数", "小数", "文本", "字节", "空", "布尔", "精确小数"]

# 可存类型的值（含布尔/精确归一化）；不合法抛「类型错误」
函数 值库_校验值(字段名, 值)：
    令 类名 = 类型(值)
    如果 类名 == "布尔"：
        返回 1 如果 值 否则 0
    如果 类名 == "精确小数"：
        返回 小数(值)
    如果 类名 在 值库_可存类型们：
        返回 值
    抛出 类型错误(`「{字段名}」这个值是「{类名}」，存不进数据库`)

# 存盘编码：字节 → {"$字节": base64}（JSON 没有二进制）
函数 值库_编码(值)：
    如果 类型(值) == "字节"：
        返回 {"$字节": 编码.base64编码(值)}
    返回 值

# 存盘解码：{"$字节": base64} → 字节
函数 值库_解码(值)：
    如果 类型(值) == "字典"：
        如果 值.包含("$字节") 与 长度(值) == 1：
            返回 编码.base64解码(值["$字节"])
    返回 值

# 类型序：空 < 数字 < 文本 < 字节
函数 值库_类型序(值)：
    令 类名 = 类型(值)
    如果 类名 == "空"：
        返回 值库_空序
    如果 类名 == "整数" 或 类名 == "小数"：
        返回 值库_数序
    如果 类名 == "文本"：
        返回 值库_文序
    如果 类名 == "字节"：
        返回 值库_字节序
    返回 4

# 文本比较：逐码点（基石的 < 不能比文本）
函数 值库_文本比较(甲, 乙)：
    令 甲长 = 长度(甲)
    令 乙长 = 长度(乙)
    令 共同 = 甲长 如果 甲长 < 乙长 否则 乙长
    令 i = 0
    当 i < 共同：
        令 甲码 = 序数(甲[i])
        令 乙码 = 序数(乙[i])
        如果 甲码 < 乙码：
            返回 -1
        如果 甲码 > 乙码：
            返回 1
        i += 1
    如果 甲长 < 乙长：
        返回 -1
    如果 甲长 > 乙长：
        返回 1
    返回 0

# 全类型比较：先比类型序，再比值。返回 -1 / 0 / 1
函数 值库_比较(甲, 乙)：
    令 甲序 = 值库_类型序(甲)
    令 乙序 = 值库_类型序(乙)
    如果 甲序 < 乙序：
        返回 -1
    如果 甲序 > 乙序：
        返回 1
    如果 甲序 == 值库_空序：
        返回 0
    如果 甲序 == 值库_数序：
        如果 甲 < 乙：
            返回 -1
        如果 甲 > 乙：
            返回 1
        返回 0
    如果 甲序 == 值库_文序：
        返回 值库_文本比较(甲, 乙)
    # 字节：基石的 < 对字节可用（按字典序）
    如果 甲 < 乙：
        返回 -1
    如果 甲 > 乙：
        返回 1
    返回 0

# 相等（类型序相同且值相等；1 == 1.0 为真）
函数 值库_相等(甲, 乙)：
    返回 值库_比较(甲, 乙) == 0

# 索引键用的数字归一：1.0 与 1 同键（SQLite 数值等值语义）
函数 值库_数键(值)：
    如果 类型(值) == "小数"：
        如果 值 == 整数(值)：
            返回 整数(值)
    返回 值

# 索引复合键：值们 → 稳定的 JSON 文本（先归一化再编码）
函数 值库_索引键(值们)：
    令 键值们 = []
    遍历 值 在 值们：
        令 归一 = 值库_校验值("索引键", 值)
        键值们.追加(值库_编码(值库_数键(归一)))
    返回 json.转文本(键值们)
